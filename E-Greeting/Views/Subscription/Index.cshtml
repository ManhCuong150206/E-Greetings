@model IEnumerable<E_Greeting.Controllers.SubscriptionModel>

@{
    ViewData["Title"] = "Gói Đăng Ký - E-Greeting";
    int currentRank = ViewBag.CurrentPlanId is int r ? r : -1;   // -1 = chưa đăng ký gì
    DateOnly? endDate = ViewBag.CurrentEndDate as DateOnly?;
}

<div class="container my-4">
    <div class="text-center mb-5">
        <span class="badge bg-primary-subtle text-primary px-3 py-2 rounded-pill fw-semibold mb-2">DỊCH VỤ GỬI THIỆP</span>
        <h2 class="fw-bold text-dark">Lựa Chọn Gói Dịch Vụ Phù Hợp</h2>
        <p class="text-muted">Đăng ký ngay để sử dụng tính năng gửi thiệp tự động và mở khóa kho thiệp VIP độc quyền.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @* THÊM MỚI: hiện lỗi từ server *@
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="row g-4 align-items-center">
        @foreach (var plan in Model)
        {
            bool isCurrent = currentRank == plan.Id;
            bool isLower = currentRank > plan.Id;                      // gói thấp hơn gói đang dùng
            bool isUpgrade = currentRank >= 0 && plan.Id > currentRank;  // đã có gói, gói này cao hơn

            <div class="col-lg-4 col-md-6">
                <div class="card border-0 shadow-sm rounded-4 p-4 position-relative h-100">

                    <div class="text-center my-3">
                        <h4 class="fw-bold text-dark mb-3">@plan.Name</h4>
                        <div class="d-flex justify-content-center align-items-baseline mb-2">
                            <span class="fs-2 fw-bold text-primary">@plan.Price.ToString("N0") VNĐ</span>
                            <span class="text-muted ms-1">/@plan.Duration</span>
                        </div>
                    </div>

                    <hr class="my-3 text-muted">

                    <ul class="list-unstyled d-flex flex-column gap-3 mb-4">
                        @foreach (var feature in plan.Features)
                        {
                            <li class="d-flex align-items-center small text-secondary">
                                <i class="bi bi-check-circle-fill text-success me-2 fs-6"></i> @feature
                            </li>
                        }
                    </ul>

                    <div class="mt-auto">
                        @if (isCurrent)
                        {
                            <button type="button" class="btn btn-success rounded-pill w-100 fw-semibold py-2" disabled>
                                <i class="bi bi-check-circle me-1"></i> Bạn đang sử dụng
                            </button>
                            @if (endDate.HasValue)
                            {
                                <small class="text-muted d-block text-center mt-2">
                                    Hết hạn: @endDate.Value.ToString("dd/MM/yyyy")
                                </small>
                            }
                        }
                        else if (isLower)
                        {
                            <small class="text-muted d-block text-center">Đã bao gồm trong gói của bạn</small>
                        }
                        else
                        {
                            <form asp-controller="Subscription" asp-action="Subscribe" method="post">
                                <input type="hidden" name="planId" value="@plan.Id" />
                                <button type="submit" class="btn btn-outline-primary rounded-pill w-100 fw-semibold py-2">
                                    @(isUpgrade ? "Nâng cấp ngay" : "Đăng Ký Ngay")
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>