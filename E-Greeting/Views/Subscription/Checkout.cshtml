@model E_Greeting.Models.Payment

@{
    ViewData["Title"] = "Payment - E-Greeting";
    bool expired = ViewBag.Expired ?? false;
    long expiresAtMs = ViewBag.ExpiresAtUnixMs != null ? (long)ViewBag.ExpiresAtUnixMs : 0L;
}
<div class="container my-4" style="max-width: 720px;">
    <div class="card border-0 shadow-sm rounded-4 p-4">

        @if (expired)
        {
            <div class="text-center py-5">
                <i class="bi bi-clock-history text-danger" style="font-size: 3rem;"></i>
                <h4 class="fw-bold mt-3">The QR code has expired</h4>
                <p class="text-muted">The payment order is only valid for 2 minutes. Please register again.</p>
                <a asp-controller="Subscription" asp-action="Index" class="btn btn-primary rounded-pill px-4 mt-2">
                    Back to plan selection
                </a>
            </div>
        }
        else
        {
            <h3 class="fw-bold text-center mb-1">Pay for plan @(Model.Subscription.Service?.Name)</h3>
            <p class="text-center text-muted mb-1">Scan the QR code with your banking app to pay</p>
            <p class="text-center mb-4">
                Time left: <span id="countdown" class="fw-bold text-danger">02:00</span>
            </p>

            <div class="row g-4 align-items-center">
                <div class="col-md-6 text-center">
                    <img src="@ViewBag.QrUrl" alt="Payment QR" class="img-fluid rounded-3 border" />
                </div>
                <div class="col-md-6">
                    <table class="table table-borderless mb-0">
                        <tr><td class="text-muted">Bank</td><td class="fw-semibold">@ViewBag.BankShortName</td></tr>
                        <tr><td class="text-muted">Account number</td><td class="fw-semibold">@ViewBag.BankAccount</td></tr>
                        <tr><td class="text-muted">Amount</td><td class="fw-bold text-primary">@Model.Amount.ToString("N0") VNĐ</td></tr>
                        <tr><td class="text-muted">Transfer content</td><td class="fw-bold text-danger">@ViewBag.Code</td></tr>
                    </table>
                    <div class="alert alert-warning small mt-3 mb-0">
                        Enter the <b>exact transfer content</b> so the system can confirm automatically.
                    </div>
                </div>
            </div>

            <div id="statusBox" class="text-center mt-4">
                <div class="spinner-border spinner-border-sm text-primary me-2"></div>
                <span class="text-muted">Waiting for payment...</span>
            </div>
        }

    </div>
</div>

@section Scripts {
    <script>
        const checkUrl = '@Url.Action("CheckStatus", "Subscription", new { paymentId = Model.Id })';
        const successUrl = '@Url.Action("Success", "Subscription", new { paymentId = Model.Id })';
        const expiresAt = @expiresAtMs;

        let pollTimer = null;
        let countdownTimer = null;

        function stopAll() {
            if (pollTimer) clearInterval(pollTimer);
            if (countdownTimer) clearInterval(countdownTimer);
        }

        function showExpiredUI() {
            stopAll();
            document.querySelector('.card').innerHTML = `
                        <div class="text-center py-5">
                            <i class="bi bi-clock-history text-danger" style="font-size: 3rem;"></i>
                            <h4 class="fw-bold mt-3">The QR code has expired</h4>
                            <p class="text-muted">The payment order is only valid for 2 minutes. Please register again.</p>
                            <a href="@Url.Action("Index", "Subscription")" class="btn btn-primary rounded-pill px-4 mt-2">
                                Back to plan selection
                            </a>
                        </div>`;
        }

        if (expiresAt > 0) {
            countdownTimer = setInterval(() => {
                const remainMs = expiresAt - Date.now();
                if (remainMs <= 0) {
                    showExpiredUI();
                    return;
                }
                const totalSec = Math.floor(remainMs / 1000);
                const mm = String(Math.floor(totalSec / 60)).padStart(2, '0');
                const ss = String(totalSec % 60).padStart(2, '0');
                const el = document.getElementById('countdown');
                if (el) el.textContent = `${mm}:${ss}`;
            }, 1000);

            pollTimer = setInterval(async () => {
                try {
                    const res = await fetch(checkUrl);
                    const data = await res.json();

                    if (data.status === 'PAID') {
                        stopAll();
                        document.getElementById('statusBox').innerHTML =
                            '<span class="text-success fw-bold">Payment successful! Redirecting...</span>';
                        setTimeout(() => window.location.href = successUrl, 1000);
                    } else if (data.status === 'EXPIRED') {
                        showExpiredUI();
                    }
                } catch (e) { console.error(e); }
            }, 3000);
        }
    </script>
}