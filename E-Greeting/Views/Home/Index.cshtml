@using System.Globalization
@model IEnumerable<E_Greeting.Models.Template>

@{
    ViewData["Title"] = "Home - E-Greeting";
    var wishlistIds = ViewBag.WishlistCardIds as List<int> ?? new List<int>();
}

<!-- 1. HERO BANNER -->
<section class="hero-banner bg-primary bg-gradient text-white rounded-4 p-4 p-md-5 mb-5 shadow-sm position-relative overflow-hidden">
    <div class="row align-items-center position-relative z-1">
        <div class="col-lg-7 text-center text-lg-start">
            <span class="badge bg-light text-primary fw-bold px-3 py-2 rounded-pill mb-3">
                <i class="bi bi-sparkles me-1"></i> #1 E-Card Platform
            </span>
            <h1 class="display-5 fw-bold mb-3">Send Wishes, Connect Hearts</h1>
            <p class="lead mb-4 opacity-90">Design your own unique e-cards in just 3 minutes with hundreds of free templates for Birthdays, Weddings, and Festivals.</p>
            <div class="d-flex gap-3 justify-content-center justify-content-lg-start">
                <a href="#cardCatalog" class="btn btn-light btn-lg rounded-pill fw-bold text-primary px-4 shadow-sm">
                    Explore Now <i class="bi bi-arrow-down-short ms-1"></i>
                </a>
                <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-light btn-lg rounded-pill fw-semibold px-4">
                    Automated Plans <i class="bi bi-star-fill ms-1 text-warning"></i>
                </a>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block text-center">
            <i class="bi bi-envelope-open-heart text-white-50" style="font-size: 11rem;"></i>
        </div>
    </div>
</section>

<!-- 2. FILTER & SEARCH BAR -->
<section id="cardCatalog" class="mb-4">
    <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-lg-4 col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control bg-light border-0" placeholder="Search card title..." />
                </div>
            </div>

            <div class="col-lg-3 col-md-3">
                <select id="categoryFilter" class="form-select bg-light border-0 fw-medium">
                    <option value="all">All Categories</option>
                    @if (ViewBag.Categories != null)
                    {
                        var textInfo = CultureInfo.CurrentCulture.TextInfo;
                        foreach (var category in ViewBag.Categories)
                        {
                            string formattedName = !string.IsNullOrEmpty(category.Name)
                                ? textInfo.ToTitleCase(category.Name.ToLower())
                                : category.Name;

                            <option value="@category.Id">@formattedName</option>
                        }
                    }
                </select>
            </div>

            <div class="col-lg-3 col-md-3">
                <select id="typeFilter" class="form-select bg-light border-0 fw-medium">
                    <option value="all">All Card Types</option>
                    <option value="free">Free</option>
                    <option value="paid">Paid (VIP)</option>
                </select>
            </div>

            <div class="col-lg-1 col-md-1">
                <button id="btnWishlistFilter" class="btn btn-outline-danger w-100 rounded-3 shadow-sm d-flex align-items-center justify-content-center" title="View wishlist cards">
                    <i class="bi bi-heart-fill"></i>
                </button>
            </div>

            <div class="col-lg-1 col-md-1 text-end">
                <button id="btnReset" class="btn btn-outline-secondary w-100 rounded-3" title="Reset filters">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- 3. CARD CATALOG FROM DATABASE -->
<section class="mb-5">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="cardGrid">
        @if (Model != null && Model.Any())
        {
            @foreach (var card in Model.OrderByDescending(c => c.Id))
            {
                var categoryId = card.CategoryId.ToString();
                var imgPath = string.IsNullOrEmpty(card.ImagePath) ? "/images/default-card.jpg" : card.ImagePath;
                bool isWishlisted = wishlistIds.Contains(card.Id);

                <div class="col card-item"
                     data-name="@card.Name?.ToLower()"
                     data-category="@categoryId"
                     data-isfree="@card.IsFree.ToString().ToLower()"
                     data-wishlist="@isWishlisted.ToString().ToLower()">

                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover position-relative">

                        <button class="btn btn-light rounded-circle shadow-sm position-absolute top-0 start-0 m-2 z-3 btn-toggle-wishlist"
                                data-id="@card.Id"
                                style="width: 34px; height: 34px; padding: 0; display: flex; align-items: center; justify-content: center;"
                                title="Add to wishlist">
                            <i class="bi @(isWishlisted ? "bi-heart-fill text-danger" : "bi-heart text-secondary") fs-6"></i>
                        </button>

                        <span class="position-absolute top-0 end-0 m-2 badge z-2 @(card.IsFree ? "bg-success" : "bg-warning text-dark")">
                            @(card.IsFree ? "Free" : "Paid")
                        </span>

                        <div class="card-img-container bg-light d-flex align-items-center justify-content-center p-2"
                             style="height: 280px; overflow: hidden;">
                            <a href="/template/details/@card.Id" class="w-100 h-100 d-flex align-items-center justify-content-center">
                                <img src="@imgPath"
                                     class="card-img-top img-fluid rounded-3"
                                     style="max-height: 100%; width: auto; object-fit: contain;"
                                     alt="@card.Name" />
                            </a>
                        </div>

                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="card-title fw-bold text-dark text-truncate mb-3">@card.Name</h6>

                            <a href="/template/details/@card.Id" class="btn btn-outline-primary rounded-pill w-100 fw-bold mt-auto shadow-sm">
                                View Details
                            </a>
                        </div>
                    </div>

                </div>
            }
        }
    </div>

    <div id="noResults" class="text-center py-5 @(Model != null && Model.Any() ? "d-none" : "")">
        <i class="bi bi-search-heart text-muted display-1"></i>
        <h5 class="mt-3 text-secondary">No matching card templates found</h5>
        <p class="text-muted small">Try selecting a different filter or clear your wishlist filter.</p>
    </div>
</section>

<!-- 4. PAGINATION -->
<section class="d-flex justify-content-center my-4">
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-md shadow-sm rounded-pill overflow-hidden" id="paginationList"></ul>
    </nav>
</section>

<button id="btnScrollTop" class="btn btn-primary rounded-circle shadow-lg position-fixed bottom-0 end-0 m-4 d-none" style="z-index: 1000; width: 48px; height: 48px;">
    <i class="bi bi-arrow-up fs-5"></i>
</button>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById("searchInput");
            const categoryFilter = document.getElementById("categoryFilter");
            const typeFilter = document.getElementById("typeFilter");
            const btnWishlistFilter = document.getElementById("btnWishlistFilter");
            const btnReset = document.getElementById("btnReset");
            const cardItems = document.querySelectorAll(".card-item");
            const noResults = document.getElementById("noResults");
            const btnScrollTop = document.getElementById("btnScrollTop");
            const paginationList = document.getElementById("paginationList");

            let onlyWishlist = false;
            const itemsPerPage = 8;
            let currentPage = 1;

            function updateGridAndPagination() {
                const keyword = searchInput.value.toLowerCase().trim();
                const selectedCategory = categoryFilter.value;
                const selectedType = typeFilter.value;

                const matchedCards = [];
                cardItems.forEach(item => {
                    const name = item.getAttribute("data-name") || "";
                    const category = item.getAttribute("data-category") || "";
                    const isFree = item.getAttribute("data-isfree") === "true";
                    const isWishlist = item.getAttribute("data-wishlist") === "true";

                    const matchSearch = name.includes(keyword);
                    const matchCategory = (selectedCategory === "all" || category === selectedCategory);

                    let matchType = true;
                    if (selectedType === "free") matchType = isFree;
                    else if (selectedType === "paid") matchType = !isFree;

                    let matchWishlist = true;
                    if (onlyWishlist) matchWishlist = isWishlist;

                    if (matchSearch && matchCategory && matchType && matchWishlist) {
                        matchedCards.push(item);
                    }
                });

                if (matchedCards.length === 0) {
                    noResults.classList.remove("d-none");
                    paginationList.innerHTML = "";
                    cardItems.forEach(item => item.classList.add("d-none"));
                    return;
                } else {
                    noResults.classList.add("d-none");
                }

                const totalPages = Math.ceil(matchedCards.length / itemsPerPage);
                if (currentPage > totalPages) currentPage = 1;

                cardItems.forEach(item => item.classList.add("d-none"));

                const startIndex = (currentPage - 1) * itemsPerPage;
                const endIndex = startIndex + itemsPerPage;
                const cardsForCurrentPage = matchedCards.slice(startIndex, endIndex);

                cardsForCurrentPage.forEach(item => item.classList.remove("d-none"));
                renderPagination(totalPages);
            }

            function renderPagination(totalPages) {
                if (totalPages <= 1) {
                    paginationList.innerHTML = "";
                    return;
                }

                let html = `<li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                                                <a class="page-link" href="javascript:void(0)" data-page="${currentPage - 1}"><i class="bi bi-chevron-left"></i></a>
                                            </li>`;

                for (let i = 1; i <= totalPages; i++) {
                    html += `<li class="page-item ${i === currentPage ? 'active' : ''}">
                                                <a class="page-link" href="javascript:void(0)" data-page="${i}">${i}</a>
                                            </li>`;
                }

                html += `<li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                                            <a class="page-link" href="javascript:void(0)" data-page="${currentPage + 1}"><i class="bi bi-chevron-right"></i></a>
                                        </li>`;

                paginationList.innerHTML = html;

                paginationList.querySelectorAll(".page-link").forEach(button => {
                    button.addEventListener("click", function() {
                        const page = parseInt(this.getAttribute("data-page"));
                        if (page && page !== currentPage && page >= 1 && page <= totalPages) {
                            currentPage = page;
                            updateGridAndPagination();
                            document.getElementById("cardCatalog").scrollIntoView({ behavior: 'smooth' });
                        }
                    });
                });
            }

            // AJAX TOGGLE WISHLIST
            document.querySelectorAll(".btn-toggle-wishlist").forEach(btn => {
                btn.addEventListener("click", function(e) {
                    e.preventDefault();
                    const button = this;
                    const templateId = button.getAttribute("data-id");
                    const icon = button.querySelector("i");
                    const cardItem = button.closest(".card-item");

                    fetch(`/Home/ToggleWishlist?templateId=${templateId}`, {
                        method: 'POST'
                    })
                        .then(response => response.json())
                        .then(data => {
                            if (data.success) {
                                if (data.isAdded) {
                                    icon.className = "bi bi-heart-fill text-danger fs-6";
                                    cardItem.setAttribute("data-wishlist", "true");
                                } else {
                                    icon.className = "bi bi-heart text-secondary fs-6";
                                    cardItem.setAttribute("data-wishlist", "false");
                                }
                                updateGridAndPagination();
                            } else {
                                alert(data.message);
                            }
                        })
                        .catch(err => {
                            console.error("Wishlist Error:", err);
                            alert("Please log in to use this feature!");
                        });
                });
            });

            if (btnWishlistFilter) {
                btnWishlistFilter.addEventListener("click", function() {
                    onlyWishlist = !onlyWishlist;
                    if (onlyWishlist) {
                        this.classList.replace("btn-outline-danger", "btn-danger");
                    } else {
                        this.classList.replace("btn-danger", "btn-outline-danger");
                    }
                    currentPage = 1;
                    updateGridAndPagination();
                });
            }

            if (searchInput) searchInput.addEventListener("keyup", () => { currentPage = 1; updateGridAndPagination(); });
            if (categoryFilter) categoryFilter.addEventListener("change", () => { currentPage = 1; updateGridAndPagination(); });
            if (typeFilter) typeFilter.addEventListener("change", () => { currentPage = 1; updateGridAndPagination(); });

            if (btnReset) {
                btnReset.addEventListener("click", function() {
                    searchInput.value = "";
                    categoryFilter.value = "all";
                    typeFilter.value = "all";
                    onlyWishlist = false;
                    if (btnWishlistFilter) btnWishlistFilter.classList.replace("btn-danger", "btn-outline-danger");
                    currentPage = 1;
                    updateGridAndPagination();
                });
            }

            window.addEventListener("scroll", function() {
                if (window.scrollY > 300) btnScrollTop.classList.remove("d-none");
                else btnScrollTop.classList.add("d-none");
            });

            if (btnScrollTop) {
                btnScrollTop.addEventListener("click", () => window.scrollTo({ top: 0, behavior: "smooth" }));
            }

            updateGridAndPagination();
        });
    </script>
}