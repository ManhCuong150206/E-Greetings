@model IEnumerable<E_Greeting.Models.Template>

@{
    ViewData["Title"] = "Trang Chủ - E-Greeting";
}

<!-- 1. HERO BANNER -->
<section class="hero-banner bg-primary bg-gradient text-white rounded-4 p-4 p-md-5 mb-5 shadow-sm position-relative overflow-hidden">
    <div class="row align-items-center position-relative z-1">
        <div class="col-lg-7 text-center text-lg-start">
            <span class="badge bg-light text-primary fw-bold px-3 py-2 rounded-pill mb-3">
                <i class="bi bi-sparkles me-1"></i> Nền Tảng Gửi Thiệp Số 1
            </span>
            <h1 class="display-5 fw-bold mb-3">Trao Lời Chúc Mừng, Kết Nối Yêu Thương</h1>
            <p class="lead mb-4 opacity-90">Tự tay thiết kế thiệp điện tử độc đáo chỉ trong 3 phút với hàng trăm mẫu thiệp Sinh Nhật, Đám Cưới và Lễ Hội hoàn toàn miễn phí.</p>
            <div class="d-flex gap-3 justify-content-center justify-content-lg-start">
                <a href="#cardCatalog" class="btn btn-light btn-lg rounded-pill fw-bold text-primary px-4 shadow-sm">
                    Khám Phá Ngay <i class="bi bi-arrow-down-short ms-1"></i>
                </a>
                <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-light btn-lg rounded-pill fw-semibold px-4">
                    Gói Tự Động <i class="bi bi-star-fill ms-1 text-warning"></i>
                </a>
            </div>
        </div>
        <div class="col-lg-5 d-none d-lg-block text-center">
            <i class="bi bi-envelope-open-heart text-white-50" style="font-size: 11rem;"></i>
        </div>
    </div>
</section>

<!-- 2. FILTER & SEARCH BAR -->
<section id="cardCatalog" class="mb-4">
    <div class="card border-0 shadow-sm rounded-4 p-3 p-md-4 mb-4">
        <div class="row g-3 align-items-center">
            <!-- Ô Tìm Kiếm -->
            <div class="col-lg-6 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchInput" class="form-control bg-light border-0" placeholder="Tìm tên thiệp (ví dụ: Sinh nhật, Đám cưới...)" />
                </div>
            </div>

            <!-- Lọc Theo Chủ Đề -->
            <div class="col-lg-5 col-md-5">
                <select id="categoryFilter" class="form-select bg-light border-0 fw-medium">
                    <option value="all">Tất cả chủ đề</option>
                    <option value="1">Sinh nhật (Birthday)</option>
                    <option value="2">Đám cưới (Wedding)</option>
                    <option value="3">Kỷ niệm (Anniversary)</option>
                    <option value="4">Lễ hội (Festivals)</option>
                </select>
            </div>

            <!-- Nút Reset Filter -->
            <div class="col-lg-1 text-end">
                <button id="btnReset" class="btn btn-outline-secondary w-100 rounded-3" title="Đặt lại bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
            </div>
        </div>
    </div>
</section>

<!-- 3. DANH SÁCH THIỆP TỪ DATABASE (CARD GRID) -->
<section class="mb-5">
    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4" id="cardGrid">
        @if (Model != null && Model.Any())
        {
            @foreach (var card in Model.OrderByDescending(c => c.Id))
            {
                // Chuẩn hóa danh mục & đường dẫn ảnh để filter
                var categoryId = card.CategoryId.ToString();
                var imgPath = string.IsNullOrEmpty(card.ImagePath) ? "/images/default-card.jpg" : card.ImagePath;

                <div class="col card-item"
                     data-name="@card.Name?.ToLower()"
                     data-category="@categoryId">

                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover position-relative">
                        <!-- Nhãn Miễn Phí / Trả Phí -->
                        <span class="position-absolute top-0 end-0 m-2 badge z-2 @(card.IsFree ? "bg-success" : "bg-warning text-dark")">
                            @(card.IsFree ? "Miễn phí" : "Trả phí")
                        </span>

                        <!-- Khung Chứa Ảnh -->
                        <div class="card-img-container bg-light d-flex align-items-center justify-content-center p-2"
                             style="height: 280px; overflow: hidden;">
                            <img src="@imgPath"
                                 class="card-img-top img-fluid rounded-3"
                                 style="max-height: 100%; width: auto; object-fit: contain;"
                                 alt="@card.Name" />
                        </div>

                        <!-- Nội Dung Thiệp -->
                        <div class="card-body d-flex flex-column p-3">
                            <h6 class="card-title fw-bold text-dark text-truncate mb-3">@card.Name</h6>

                            <!-- Nút Chọn Tạo Thiệp -->
                            <a href="/Card/Personalize/@card.Id" class="btn btn-primary rounded-pill w-100 fw-bold mt-auto shadow-sm">
                                🎨 Tạo Thiệp Này
                            </a>
                        </div>
                    </div>

                </div>
            }
        }
    </div>

    <!-- Thông báo khi không có thiệp hoặc không tìm thấy kết quả -->
    <div id="noResults" class="text-center py-5 @(Model != null && Model.Any() ? "d-none" : "")">
        <i class="bi bi-search-heart text-muted display-1"></i>
        <h5 class="mt-3 text-secondary">Không tìm thấy mẫu thiệp phù hợp</h5>
        <p class="text-muted small">Hãy thử tìm kiếm với từ khóa khác hoặc chọn chủ đề khác.</p>
    </div>
</section>

<!-- 4. PHÂN TRANG (PAGINATION) -->
<section class="d-flex justify-content-center my-4">
    <nav aria-label="Page navigation">
        <ul class="pagination pagination-md shadow-sm rounded-pill overflow-hidden" id="paginationList">
            <!-- JavaScript sẽ tự động sinh các nút bấm chuyển trang ở đây -->
        </ul>
    </nav>
</section>

<!-- 5. NÚT SCROLL TO TOP -->
<button id="btnScrollTop" class="btn btn-primary rounded-circle shadow-lg position-fixed bottom-0 end-0 m-4 d-none" style="z-index: 1000; width: 48px; height: 48px;">
    <i class="bi bi-arrow-up fs-5"></i>
</button>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const searchInput = document.getElementById("searchInput");
            const categoryFilter = document.getElementById("categoryFilter");
            const btnReset = document.getElementById("btnReset");
            const cardItems = document.querySelectorAll(".card-item");
            const noResults = document.getElementById("noResults");
            const btnScrollTop = document.getElementById("btnScrollTop");
            const paginationList = document.getElementById("paginationList");

            // --- CẤU HÌNH PHÂN TRANG ---
            const itemsPerPage = 8; // Số thiệp hiển thị trên mỗi trang
            let currentPage = 1;

            // --- LÔ-GÍC FILTER, SEARCH VÀ PHÂN TRANG ĐỒNG BỘ ---
            function updateGridAndPagination() {
                const keyword = searchInput.value.toLowerCase().trim();
                const selectedCategory = categoryFilter.value;

                // 1. Lọc ra danh sách thiệp thỏa mãn điều kiện tìm kiếm/danh mục
                const matchedCards = [];
                cardItems.forEach(item => {
                    const name = item.getAttribute("data-name") || "";
                    const category = item.getAttribute("data-category") || "";

                    const matchSearch = name.includes(keyword);
                    const matchCategory = (selectedCategory === "all" || category === selectedCategory);

                    if (matchSearch && matchCategory) {
                        matchedCards.push(item);
                    }
                });

                // 2. Kiểm tra nếu không tìm thấy kết quả
                if (matchedCards.length === 0) {
                    noResults.classList.remove("d-none");
                    paginationList.innerHTML = "";
                    cardItems.forEach(item => item.classList.add("d-none"));
                    return;
                } else {
                    noResults.classList.add("d-none");
                }

                // 3. Tính toán số trang
                const totalPages = Math.ceil(matchedCards.length / itemsPerPage);
                if (currentPage > totalPages) currentPage = 1;

                // 4. Ẩn toàn bộ thiệp và chỉ hiển thị 8 thiệp của trang hiện tại
                cardItems.forEach(item => item.classList.add("d-none"));

                const startIndex = (currentPage - 1) * itemsPerPage;
                const endIndex = startIndex + itemsPerPage;
                const cardsForCurrentPage = matchedCards.slice(startIndex, endIndex);

                cardsForCurrentPage.forEach(item => item.classList.remove("d-none"));

                // 5. Vẽ lại nút phân trang (Pagination UI)
                renderPagination(totalPages);
            }

            // --- HÀM TẠO GIAO DIỆN NÚT BẤM PHÂN TRANG ---
            function renderPagination(totalPages) {
                if (totalPages <= 1) {
                    paginationList.innerHTML = ""; // Ẩn phân trang nếu chỉ có 1 trang
                    return;
                }

                let html = '';

                // Nút Trang Trước (<)
                html += `
                            <li class="page-item ${currentPage === 1 ? 'disabled' : ''}">
                                <a class="page-link" href="javascript:void(0)" data-page="${currentPage - 1}">
                                    <i class="bi bi-chevron-left"></i>
                                </a>
                            </li>
                        `;

                // Các nút số trang (1, 2, 3...)
                for (let i = 1; i <= totalPages; i++) {
                    html += `
                                <li class="page-item ${i === currentPage ? 'active' : ''}">
                                    <a class="page-link" href="javascript:void(0)" data-page="${i}">${i}</a>
                                </li>
                            `;
                }

                // Nút Trang Sau (>)
                html += `
                            <li class="page-item ${currentPage === totalPages ? 'disabled' : ''}">
                                <a class="page-link" href="javascript:void(0)" data-page="${currentPage + 1}">
                                    <i class="bi bi-chevron-right"></i>
                                </a>
                            </li>
                        `;

                paginationList.innerHTML = html;

                // Gán sự kiện click cho các nút phân trang
                paginationList.querySelectorAll(".page-link").forEach(button => {
                    button.addEventListener("click", function() {
                        const page = parseInt(this.getAttribute("data-page"));
                        if (page && page !== currentPage && page >= 1 && page <= totalPages) {
                            currentPage = page;
                            updateGridAndPagination();

                            // Cuộn mượt lên danh mục thiệp khi chuyển trang
                            document.getElementById("cardCatalog").scrollIntoView({ behavior: 'smooth' });
                        }
                    });
                });
            }

            // Gán sự kiện cho bộ lọc
            if (searchInput) {
                searchInput.addEventListener("keyup", function() {
                    currentPage = 1; // Reset về trang 1 khi gõ tìm kiếm
                    updateGridAndPagination();
                });
            }

            if (categoryFilter) {
                categoryFilter.addEventListener("change", function() {
                    currentPage = 1; // Reset về trang 1 khi đổi danh mục
                    updateGridAndPagination();
                });
            }

            if (btnReset) {
                btnReset.addEventListener("click", function() {
                    searchInput.value = "";
                    categoryFilter.value = "all";
                    currentPage = 1;
                    updateGridAndPagination();
                });
            }

            // --- LÔ-GÍC SCROLL TO TOP ---
            window.addEventListener("scroll", function() {
                if (window.scrollY > 300) {
                    btnScrollTop.classList.remove("d-none");
                } else {
                    btnScrollTop.classList.add("d-none");
                }
            });

            if (btnScrollTop) {
                btnScrollTop.addEventListener("click", function() {
                    window.scrollTo({ top: 0, behavior: "smooth" });
                });
            }

            // Chạy lần đầu khi tải trang
            updateGridAndPagination();
        });
    </script>
}