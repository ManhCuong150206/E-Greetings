@model E_Greeting.Models.Template
@{
    ViewData["Title"] = Model.Name ?? "Card Details";
    bool isWishlisted = ViewBag.IsWishlisted ?? false;
    bool isUserVip = ViewBag.IsUserVip ?? false;
}

<style>
    /* WISHLIST BUTTON CUSTOM STYLING (MATCHING HOME CARD) */
    .btn-wishlist-custom {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        background-color: #ffffff;
        border: 1px solid #e2e8f0;
        border-radius: 50% !important;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.06);
        transition: all 0.2s ease-in-out;
        cursor: pointer;
    }

    /* HOVER EFFECT (IMAGE 2 & IMAGE 3) */
    .btn-wishlist-custom:hover {
        background-color: #e5e7eb !important;
        border-color: #d1d5db !important;
        box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
    }

    /* HEART ICON BASE STYLING */
    .btn-wishlist-custom .wishlist-heart-icon {
        font-size: 1.5rem;
        transition: color 0.2s ease-in-out, transform 0.2s ease-in-out;
    }

    .btn-wishlist-custom:hover .wishlist-heart-icon {
        transform: scale(1.08);
    }
</style>

<div class="container my-4">
    <!-- TOP HEADER WITH BACK TO HOME BUTTON -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-0"><i class="bi bi-card-heading text-primary me-2"></i>Card Details Page</h2>
            <span class="text-muted small">Explore and personalize your heartfelt greeting messages</span>
        </div>
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3 py-2 fw-semibold shadow-sm">
            <i class="bi bi-arrow-left me-1"></i> Back to Home
        </a>
    </div>

    <div class="row g-4 align-items-stretch">

        <!-- LEFT COLUMN: ENLARGED CARD PREVIEW FRAME -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 overflow-hidden p-3 p-md-4 d-flex flex-column align-items-center justify-content-center h-100" style="background-color: #f4f5f7;">
                <div class="w-100 mb-2 text-start">
                    <span class="badge bg-white text-secondary border fw-semibold px-3 py-2 rounded-pill shadow-sm">
                        <i class="bi bi-eye-fill text-primary me-1"></i> Card Template Preview
                    </span>
                </div>

                <!-- Preview container expanding to full size -->
                <div class="preview-wrapper bg-white rounded-3 p-2 shadow-lg d-inline-block text-center my-auto w-100" style="max-width: 100%;">
                    <img src="@(string.IsNullOrEmpty(Model.ImagePath) ? "/images/default-card.jpg" : Model.ImagePath)"
                         alt="@Model.Name"
                         class="img-fluid rounded-2 mx-auto"
                         style="max-height: 680px; width: auto; max-width: 100%; object-fit: contain; display: block;" />
                </div>
            </div>
        </div>

        <!-- RIGHT COLUMN: INFORMATION PANEL & DESIGN TOOLS -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 p-4 bg-white h-100 d-flex flex-column justify-content-between">
                <div>
                    <!-- INFORMATION PANEL TITLE -->
                    <h5 class="fw-bold text-primary border-bottom pb-2 mb-3">
                        <i class="bi bi-info-circle-fill text-primary me-2"></i>Card Information
                    </h5>

                    <!-- CARD NAME & CATEGORY -->
                    <div class="mb-3">
                        <div class="fs-6 text-secondary mb-1">
                            <span class="fw-bold text-dark">Card Name:</span> @Model.Name
                        </div>
                        <div class="fs-6 text-secondary mb-2">
                            <span class="fw-bold text-dark">Category:</span> @(Model.Category?.Name ?? "E-Greeting Card")
                        </div>
                        <div class="fs-6 text-secondary mb-2">
                            <span class="fw-bold text-dark">Format:</span> Electronic Card (E-Card HD)
                        </div>
                        <div class="fs-6 text-secondary">
                            <span class="fw-bold text-dark">Compatibility:</span> PC, Tablet &amp; Mobile
                        </div>
                    </div>

                    <div class="d-flex align-items-center mb-4">
                        @if (Model.IsFree)
                        {
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill fw-bold fs-6">Free Access</span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-3 py-2 rounded-pill fw-bold fs-6"><i class="bi bi-star-fill me-1"></i>Premium VIP</span>
                        }
                    </div>

                    <!-- CUSTOM TEMPLATE BUTTON & SYNCHRONIZED WISHLIST BUTTON -->
                    <div class="d-flex gap-2 mb-4">
                        <button id="btnCustomize" class="btn btn-primary btn-lg flex-grow-1 rounded-pill py-3 fw-bold text-white fs-5 shadow-sm d-flex align-items-center justify-content-center gap-2">
                            <i class="bi bi-palette-fill"></i> Custom Template
                        </button>

                        <!-- WISHLIST BUTTON MATCHING HOME CARD STATES -->
                        <button id="btnSaveWishlist" class="btn btn-wishlist-custom" title="Save to Favorites" data-id="@Model.Id">
                            <i class="bi @(isWishlisted ? "bi-heart-fill text-danger" : "bi-heart text-secondary") wishlist-heart-icon" id="wishlistIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- KEY FEATURES LIST BELOW BUTTONS -->
                <div class="p-3 bg-light rounded-3 border">
                    <h6 class="fw-bold text-dark fs-7 mb-2"><i class="bi bi-stars text-warning me-1"></i>Key Features:</h6>
                    <ul class="list-unstyled text-secondary small mb-0 d-flex flex-column gap-2">
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Flexible editing of text, fonts, and colors.</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>Add custom stickers, photos, and background music.</li>
                        <li><i class="bi bi-check-circle-fill text-success me-2"></i>High-definition export and direct email delivery.</li>
                    </ul>
                </div>
            </div>
        </div>

    </div>

    <!-- YOU MAY ALSO LIKE SECTION -->
    <div class="mt-5 pt-5 border-top">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">You May Also Like</h4>
            <a asp-controller="Home" asp-action="Index" asp-route-categoryId="@Model.CategoryId" class="text-primary text-decoration-none fw-semibold small">
                View All <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
            @if (ViewBag.RelatedTemplates != null)
            {
                @foreach (var item in ViewBag.RelatedTemplates)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm hover-top transition-all rounded-4 overflow-hidden">
                            <div class="position-relative overflow-hidden bg-light d-flex align-items-center justify-content-center" style="height: 240px;">
                                <a asp-action="Details" asp-route-id="@item.Id" class="w-100 h-100 d-flex align-items-center justify-content-center">
                                    <img src="@item.ImagePath" class="card-img-top img-fluid p-2" style="max-height: 100%; object-fit: contain;" alt="@item.Name">
                                </a>
                                <span class="badge @(item.IsFree ? "bg-success" : "bg-warning text-dark") position-absolute top-0 end-0 m-2">
                                    @(item.IsFree ? "Free" : "VIP")
                                </span>
                            </div>
                            <div class="card-body text-center d-flex flex-column justify-content-between p-3">
                                <h6 class="card-title text-truncate fw-bold mb-2">@item.Name</h6>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill w-100 fw-semibold">
                                    View This Card
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- FREQUENTLY ASKED QUESTIONS SECTION -->
    <div class="mt-5 pt-4">
        <h4 class="fw-bold text-center mb-4">Frequently Asked Questions</h4>
        <div class="accordion accordion-flush max-w-2xl mx-auto shadow-sm rounded-3 overflow-hidden border" id="faqAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                        Can I edit the content on the card?
                    </button>
                </h2>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted small">
                        Yes, you can completely customize text, fonts, colors, add personal photos, and background music before saving or sending your card.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                        Can the card be sent directly via Email?
                    </button>
                </h2>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted small">
                        The E-Greeting system supports sending cards directly to recipient emails along with custom background music and personalized messages.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- VIP SUBSCRIPTION REQUIRED MODAL DIALOG -->
<div class="modal fade" id="vipAlertModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content rounded-4 border-0 shadow-lg text-center p-4">
            <div class="modal-body p-0">
                <div class="mx-auto rounded-circle bg-warning-subtle d-flex align-items-center justify-content-center mb-3" style="width: 75px; height: 75px;">
                    <i class="bi bi-star-fill text-warning display-4"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Premium VIP Required</h4>
                <p class="text-secondary small mb-4">
                    This template belongs to the VIP category. You need an active Premium VIP subscription (Service Plan 2) to customize and use this card!
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold border" data-bs-dismiss="modal">Cancel</button>
                    <a href="/Subscription" class="btn btn-warning text-dark fw-bold rounded-pill px-4 shadow-sm">
                        Upgrade to VIP
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- GENERAL CENTERED POPUP MODAL FOR AJAX NOTIFICATIONS -->
<div class="modal fade" id="generalAlertModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content text-center p-4 rounded-4 shadow border-0">
            <div class="modal-body p-0">
                <div class="mb-3" id="generalModalIconContainer">
                    <div class="mx-auto rounded-circle bg-danger-subtle d-flex align-items-center justify-content-center" style="width: 75px; height: 75px;">
                        <i class="bi bi-exclamation-triangle-fill text-danger display-4"></i>
                    </div>
                </div>
                <h4 class="fw-bold mb-2" id="generalModalTitle">Notice</h4>
                <p class="text-secondary small mb-4" id="generalModalMessage"></p>
                <button type="button" class="btn btn-danger fw-semibold px-5 py-2 rounded-pill" data-bs-dismiss="modal">
                    OK
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const isFreeTemplate = @(Model.IsFree ? "true" : "false");
            const isUserVip = @(isUserVip ? "true" : "false");
            const templateId = @Model.Id;

            let generalModalInstance = null;

            // Helper function to show dynamic centered alert popup
            function showCenterAlert(title, message) {
                document.getElementById('generalModalTitle').innerText = title;
                document.getElementById('generalModalMessage').innerText = message;

                if (!generalModalInstance) {
                    generalModalInstance = new bootstrap.Modal(document.getElementById('generalAlertModal'));
                }
                generalModalInstance.show();
            }

            // 1. HANDLE CUSTOM TEMPLATE BUTTON CLICK (STRICT PREMIUM VIP CHECK)
            const btnCustomize = document.getElementById("btnCustomize");
            if (btnCustomize) {
                btnCustomize.addEventListener("click", function (e) {
                    e.preventDefault();

                    // If template is VIP and user has no active ServiceId == 2 subscription
                    if (!isFreeTemplate && !isUserVip) {
                        const modal = new bootstrap.Modal(document.getElementById('vipAlertModal'));
                        modal.show();
                    } else {
                        window.location.href = `/Card/Personalize/${templateId}`;
                    }
                });
            }

            // 2. HANDLE WISHLIST TOGGLE BUTTON (AJAX WITH DYNAMIC ICON TOGGLE)
            const btnSaveWishlist = document.getElementById("btnSaveWishlist");
            const wishlistIcon = document.getElementById("wishlistIcon");

            if (btnSaveWishlist) {
                btnSaveWishlist.addEventListener("click", function (e) {
                    e.preventDefault();
                    fetch(`/Home/ToggleWishlist?templateId=${templateId}`, {
                        method: 'POST'
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data.success) {
                                if (data.isAdded) {
                                    // MATCHES IMAGE 3 & 4 (RED FILLED HEART)
                                    wishlistIcon.className = "bi bi-heart-fill text-danger wishlist-heart-icon";
                                } else {
                                    // MATCHES IMAGE 1 & 2 (GREY OUTLINED HEART)
                                    wishlistIcon.className = "bi bi-heart text-secondary wishlist-heart-icon";
                                }
                            } else {
                                showCenterAlert("Notice", data.message || "Failed to update wishlist status.");
                            }
                        })
                        .catch(err => {
                            showCenterAlert("Authentication Required", "Please log in to save favorite templates!");
                        });
                });
            }
        });
    </script>
}