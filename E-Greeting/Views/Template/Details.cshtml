@model E_Greeting.Models.Template
@{
    ViewData["Title"] = Model.Name ?? "Chi tiết thiệp";
}

<!-- Breadcrumb -->
<div class="container my-3">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-0 small text-muted">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Template" asp-action="Index" class="text-decoration-none text-muted">Invitations</a></li>
            <li class="breadcrumb-item"><a href="#" class="text-decoration-none text-muted">@Model.Category?.Name</a></li>
            <li class="breadcrumb-item active fw-bold text-dark" aria-current="page">@Model.Name</li>
        </ol>
    </nav>
</div>



<div class="container mb-5">
    <div class="row g-4 align-items-stretch">
        
        <!-- CỘT TRÁI: KHUNG THIỆP CÓ PHONG THƯ PHÍA DƯỚI -->
        <div class="col-lg-8">
            <div class="envelope-preview-bg rounded-4 p-4 p-md-5 position-relative d-flex justify-content-center align-items-center h-100">
                <!-- Nút Share & Save ở góc trên -->
                <div class="position-absolute top-0 end-0 p-3 d-flex gap-2 z-3">
                    <button class="btn btn-light rounded-pill px-3 py-1 shadow-sm btn-sm d-flex align-items-center gap-1 border">
                        <i class="bi bi-share"></i> Share
                    </button>
                    <button class="btn btn-light rounded-pill px-3 py-1 shadow-sm btn-sm d-flex align-items-center gap-1 border">
                        <i class="bi bi-heart"></i> Save
                    </button>
                </div>

                <!-- Envelope Wrapper: Bao gồm Phong thư nằm dưới & Thiệp nổi lên trên -->
                <div class="card-envelope-container">
                    <!-- Phong thư nằm dưới -->
                    <div class="envelope-back shadow-sm">
                        <div class="envelope-flap"></div>
                    </div>

                    <!-- Thiệp nổi đè lên trên phong thư -->
                    <div id="card-preview-area" class="card-floating-wrapper shadow-lg rounded-2 overflow-hidden">
                        <img src="@Model.ImagePath" alt="@Model.Name" class="img-fluid bg-card-img" />
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI: RIGHT-SIDEBAR THEO MẪU GIỐNG HÌNH -->
        <div class="col-lg-4">
            <div class="ps-lg-2 d-flex flex-column gap-3">
                
                <!-- 1. Header & Badges -->
                <div>
                    <h2 class="fw-bold fs-3 text-dark mb-1">@Model.Name</h2>
                    <div class="text-secondary small mb-3">@(Model.Category?.Name ?? "Wedding invitation")</div>
                    
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="text-secondary small">Size 5"x7"</span>
                        @if (Model.IsFree)
                        {
                            <span class="badge border text-dark fw-normal px-2 py-1 rounded">Free</span>
                        }
                        else
                        {
                            <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle px-2 py-1 rounded">Premium</span>
                        }
                    </div>

                    <!-- 2. Color Swatches (Chọn màu) -->
                    <div class="color-picker-box p-3 rounded-4 border mb-3">
                        <div class="small fw-semibold mb-2 text-dark">Color <span class="fw-normal text-muted" id="selected-color-name">White</span></div>
                        <div class="d-flex gap-2">
                            <span class="color-circle active bg-white border" data-color="White"></span>
                            <span class="color-circle" style="background-color: #d1b894;" data-color="Beige"></span>
                            <span class="color-circle" style="background-color: #1a233a;" data-color="Navy"></span>
                            <span class="color-circle" style="background-color: #5c0622;" data-color="Burgundy"></span>
                            <span class="color-circle" style="background-color: #111111;" data-color="Black"></span>
                        </div>
                    </div>

                    <!-- 3. Nút Customize chính màu xanh lá -->
                    <a asp-controller="Template" asp-action="Personalize" asp-route-id="@Model.Id" class="btn btn-customize w-100 rounded-pill py-3 fw-bold text-white fs-5 mb-3 shadow-sm">
                        Customize
                    </a>
                </div>

                <!-- 4. Khối Spread the joy -->
                <div class="sidebar-card p-3 rounded-4 border">
                    <h6 class="fw-bold text-dark fs-7 mb-3">Spread the joy</h6>
                    <div class="d-flex flex-column gap-2">
                        <a href="#" class="sidebar-action-item"><i class="bi bi-download"></i> Download image</a>
                        <a href="#" class="sidebar-action-item"><i class="bi bi-file-earmark-pdf"></i> Download PDF</a>
                        <a href="#" class="sidebar-action-item"><i class="bi bi-printer"></i> Print</a>
                        <a href="#" class="sidebar-action-item"><i class="bi bi-share"></i> Share</a>
                        <a href="#" class="sidebar-action-item"><i class="bi bi-card-checklist"></i> Order prints</a>
                    </div>
                </div>

                <!-- 5. Khối Add RSVP and manage your guests -->
                <div class="sidebar-card p-3 rounded-4 border">
                    <h6 class="fw-bold text-dark fs-7 mb-3">Add RSVP and manage your guests</h6>
                    <div class="d-flex flex-column gap-2 text-secondary small">
                        <div class="d-flex align-items-center gap-2"><i class="bi bi-people fs-6"></i> Unlimited guests, no signup required</div>
                        <div class="d-flex align-items-center gap-2"><i class="bi bi-calendar-event fs-6"></i> Set deadlines and guest limits</div>
                        <div class="d-flex align-items-center gap-2"><i class="bi bi-geo-alt fs-6"></i> Add maps and registries</div>
                        <div class="d-flex align-items-center gap-2"><i class="bi bi-qr-code fs-6"></i> Share via link or QR code</div>
                        <div class="d-flex align-items-center gap-2"><i class="bi bi-graph-up-arrow fs-6"></i> Track responses in real time</div>
                    </div>
                </div>

            </div>
        </div>

    </div>
   
    <!-- SECTION 2: DANH SÁCH MẪU THIỆP TƯƠNG TỰ (Gợi ý như hình 2) -->
    <div class="mt-5 pt-5 border-top">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h4 class="fw-bold mb-0">Có thể bạn cũng thích</h4>
            <a asp-controller="Template" asp-action="Index" class="text-primary text-decoration-none fw-semibold small">
                Xem tất cả <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-4 g-4">
            @if (ViewBag.RelatedTemplates != null)
            {
                @foreach (var item in ViewBag.RelatedTemplates)
                {
                    <div class="col">
                        <div class="card h-100 border-0 shadow-sm hover-top transition-all">
                            <div class="position-relative overflow-hidden rounded-top">
                                <img src="@item.ImagePath" class="card-img-top object-fit-cover" style="height: 260px;" alt="@item.Name">
                                <span class="badge @(item.IsFree ? "bg-success" : "bg-warning") position-absolute top-0 end-0 m-2">
                                    @(item.IsFree ? "Miễn phí" : "Trả phí")
                                </span>
                            </div>
                            <div class="card-body text-center d-flex flex-column justify-content-between">
                                <h6 class="card-title text-truncate fw-bold mb-2">@item.Name</h6>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm rounded-pill w-100">
                                    <i class="bi bi-magic me-1"></i> Tạo Thiệp Này
                                </a>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    <!-- SECTION 3: CÂU HỎI THƯỜNG GẶP (FAQ Accordion) -->
    <div class="mt-5 pt-4">
        <h4 class="fw-bold text-center mb-4">Các câu hỏi thường gặp</h4>
        <div class="accordion accordion-flush max-w-2xl mx-auto shadow-sm rounded-3 overflow-hidden border" id="faqAccordion">
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq1">
                        Tôi có thể chỉnh sửa nội dung trên thiệp không?
                    </button>
                </h2>
                <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted small">
                        Có, bạn hoàn toàn có thể thay đổi văn bản, font chữ, màu sắc, thêm hình ảnh cá nhân và nhạc nền trước khi xuất/gửi thiệp.
                    </div>
                </div>
            </div>
            <div class="accordion-item">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed fw-semibold" type="button" data-bs-toggle="collapse" data-bs-target="#faq2">
                        Thiệp có gửi trực tiếp qua Email được không?
                    </button>
                </h2>
                <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#faqAccordion">
                    <div class="accordion-body text-muted small">
                        Hệ thống E-Greeting hỗ trợ gửi thiệp trực tiếp đến email người nhận kèm theo nhạc nền và thông điệp tùy chỉnh của bạn.
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>