@{
    ViewData["Title"] = "Reset Password - E-Greeting";
    bool verified = ViewBag.Verified == true;
}

<style>
    .otp-box {
        width: 52px; height: 62px;
        font-size: 1.8rem; font-weight: 700; text-align: center;
        border: 2px solid #dee2e6; border-radius: 12px;
        transition: border-color .15s, box-shadow .15s;
    }
    .otp-box:focus {
        border-color: #0d6efd; outline: none;
        box-shadow: 0 0 0 4px rgba(13,110,253,.15);
    }
</style>

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="text-center mb-4">
                <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex p-3 mb-2">
                    <i class="bi @(verified ? "bi-key" : "bi-shield-lock") fs-2"></i>
                </div>
                @if (!verified)
                {
                    <h3 class="fw-bold text-dark">Enter OTP</h3>
                    <p class="text-muted small mb-0">We sent a 6-digit code to</p>
                    <p class="fw-semibold small">@ViewBag.Email</p>
                }
                else
                {
                    <h3 class="fw-bold text-dark">New Password</h3>
                    <p class="text-muted small">OTP verified. Please set your new password</p>
                }
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success rounded-3 mb-3">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                </div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger rounded-3 mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                </div>
            }

            @if (!verified)
            {
                <form asp-controller="Account" asp-action="VerifyOtp" method="post" id="otpForm">
                    <input type="hidden" name="email" value="@ViewBag.Email" />
                    <input type="hidden" name="otp" id="otpValue" />

                    <div class="d-flex justify-content-center gap-2 mb-4">
                        @for (int i = 0; i < 6; i++)
                        {
                            <input type="text" class="otp-box" maxlength="1" inputmode="numeric" autocomplete="off" />
                        }
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill w-100 fw-semibold py-2 shadow-sm mb-3">
                        Verify OTP
                    </button>

                    <div class="text-center small text-muted">
                        Didn't get the code?
                        <a asp-controller="Account" asp-action="ForgotPassword" class="fw-semibold text-primary text-decoration-none">Resend OTP</a>
                    </div>
                </form>

                <script>
                    const boxes = document.querySelectorAll('.otp-box');
                    boxes[0].focus();

                    boxes.forEach((box, i) => {
                        box.addEventListener('input', () => {
                            box.value = box.value.replace(/\D/g, '');
                            if (box.value && i < boxes.length - 1) boxes[i + 1].focus();
                        });
                        box.addEventListener('keydown', e => {
                            if (e.key === 'Backspace' && !box.value && i > 0) boxes[i - 1].focus();
                        });
                        box.addEventListener('paste', e => {
                            e.preventDefault();
                            const digits = (e.clipboardData.getData('text') || '').replace(/\D/g, '').slice(0, 6);
                            digits.split('').forEach((d, idx) => boxes[idx].value = d);
                            boxes[Math.min(digits.length, 5)].focus();
                        });
                    });

                    document.getElementById('otpForm').addEventListener('submit', e => {
                        const code = Array.from(boxes).map(b => b.value).join('');
                        if (code.length !== 6) { e.preventDefault(); boxes[0].focus(); return; }
                        document.getElementById('otpValue').value = code;
                    });
                </script>
            }
            else
            {
                <form asp-controller="Account" asp-action="ResetPassword" method="post">
                    <input type="hidden" name="email" value="@ViewBag.Email" />
                    <input type="hidden" name="otp" value="@ViewBag.Otp" />

                    <div class="mb-3">
                        <label class="form-label fw-semibold"><i class="bi bi-lock me-1"></i> New password</label>
                        <input type="password" name="newPassword" class="form-control rounded-3" placeholder="••••••••" required />
                    </div>
                    <div class="mb-4">
                        <label class="form-label fw-semibold"><i class="bi bi-lock-fill me-1"></i> Confirm password</label>
                        <input type="password" name="confirmPassword" class="form-control rounded-3" placeholder="••••••••" required />
                    </div>

                    <button type="submit" class="btn btn-primary rounded-pill w-100 fw-semibold py-2 shadow-sm">
                        Change password
                    </button>
                </form>
            }
        </div>
    </div>
</div>