@{
    ViewData["Title"] = "Forgot Password - E-Greeting";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6 col-lg-5">
        <div class="card border-0 shadow-sm rounded-4 p-4">
            <div class="text-center mb-4">
                <div class="bg-primary-subtle text-primary rounded-circle d-inline-flex p-3 mb-2">
                    <i class="bi bi-key fs-2"></i>
                </div>
                <h3 class="fw-bold text-dark">Forgot Password</h3>
                <p class="text-muted small">Enter your email and we will send you a 6-digit OTP code to reset your password</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success alert-dismissible fade show rounded-3 mb-3" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-3" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            }

            <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                <div class="mb-4">
                    <label class="form-label fw-semibold"><i class="bi bi-envelope me-1"></i> Email</label>
                    <input type="email" name="email" class="form-control rounded-3" placeholder="email@example.com" required />
                </div>

                <button type="submit" class="btn btn-primary rounded-pill w-100 fw-semibold py-2 shadow-sm mb-3">
                    Send OTP
                </button>

                <div class="text-center small text-muted">
                    Remember your password?
                    <a asp-controller="Account" asp-action="Login" class="fw-semibold text-primary text-decoration-none">Back to login</a>
                </div>
            </form>
        </div>
    </div>
</div>