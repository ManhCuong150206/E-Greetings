@using System.Security.Claims
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authentication.Cookies
@using Microsoft.EntityFrameworkCore
@inject E_Greeting.Models.AppDbContext _context
@{
    string userBadge = "";
    string displayName = User.Identity?.Name ?? "";

    // RETRIEVE ROUTE DATA AND REAL REQUEST PATH
    string currentController = (ViewContext.RouteData.Values["controller"]?.ToString() ?? "").ToLower();
    string currentAction = (ViewContext.RouteData.Values["action"]?.ToString() ?? "").ToLower();
    string currentPath = (Context.Request.Path.Value ?? "").ToLower();

    // ==========================================
    // USER NAVIGATION ACTIVE STATE LOGIC
    // ==========================================
    bool isHomeActive = (currentController == "home" && currentAction == "index") || currentPath == "/" || currentPath == "/home";
    bool isSubscriptionActive = currentController == "subscription" || currentPath.StartsWith("/subscription");
    bool isFeedbackActive = (currentController == "feedback" && !currentPath.Contains("admin")) || (currentPath.StartsWith("/feedback") && !currentPath.Contains("admin"));
    bool isHistoryActive = currentController == "card" || currentAction == "history" || currentPath.Contains("history");

    // ==========================================
    // ADMIN NAVIGATION ACTIVE STATE LOGIC
    // ==========================================
    bool isAdminDashboardActive = currentController == "admin" && (currentAction == "dashboard" || currentAction == "index");
    bool isAdminCategoriesActive = currentController == "admincategory" || currentController == "admintemplate" || currentPath.Contains("admincategory") || currentPath.Contains("admintemplate");
    bool isAdminUsersActive = currentController == "adminuservip" || currentPath.Contains("adminuservip");
    bool isAdminFeedbacksActive = currentController == "adminfeedback" || currentPath.Contains("adminfeedback");
    bool isAdminSentLogsActive = currentController == "adminsenthistory" || currentPath.Contains("adminsenthistory");

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        string userIdStr = User.FindFirstValue(ClaimTypes.NameIdentifier) ?? "";
        string currentUserName = User.Identity.Name ?? "";
        DateOnly today = DateOnly.FromDateTime(DateTime.Now);

        if (int.TryParse(userIdStr, out int currentUserId))
        {
            // 1. FETCH REALTIME USER NAME FROM DB TO SYNC WITH ADMIN EDITS IMMEDIATELY ON REFRESH
            var currentAccount = _context.Accounts.FirstOrDefault(a => a.Id == currentUserId);
            if (currentAccount != null)
            {
                string dbName = currentAccount.Name ?? currentAccount.Email;
                displayName = dbName;

                // REFRESH COOKIE CLAIMS AUTOMATICALLY IF ADMIN CHANGED THE NAME
                if (currentUserName != dbName)
                {
                    var userRole = (currentAccount.Role ?? "User").Trim().ToLower() == "admin" ? "Admin" : (currentAccount.Role ?? "User").Trim();
                    var updatedClaims = new List<Claim>
                    {
                        new(ClaimTypes.NameIdentifier, currentAccount.Id.ToString()),
                        new(ClaimTypes.Name, dbName),
                        new(ClaimTypes.Email, currentAccount.Email),
                        new(ClaimTypes.Role, userRole)
                    };
                    var identity = new ClaimsIdentity(updatedClaims, CookieAuthenticationDefaults.AuthenticationScheme);
                    Context.SignInAsync(CookieAuthenticationDefaults.AuthenticationScheme, new ClaimsPrincipal(identity));
                }
            }

            // 2. RETRIEVE ACTIVE VIP/PRO BADGES
            var activeServiceNames = _context.Subscriptions
                .Include(s => s.Service)
                .Include(s => s.Account)
                .Include(s => s.Payments)
                .Where(s => (s.AccountId == currentUserId || s.Account.Name == currentUserName || s.Account.Email == currentUserName)
                         && s.IsActive
                         && (s.EndDate == null || s.EndDate >= today)
                         && s.Payments.Any(p => p.Status == "PAID"))
                .Select(s => s.Service.Name)
                .ToList();

            if (activeServiceNames.Any(name => !string.IsNullOrEmpty(name) &&
                (name.Contains("VIP", StringComparison.OrdinalIgnoreCase) || name.Contains("Premium", StringComparison.OrdinalIgnoreCase))))
            {
                userBadge = "<span class='badge bg-warning text-dark fw-bold ms-1 shadow-sm'><i class='bi bi-crown-fill text-danger me-1'></i>VIP</span>";
            }
            else if (activeServiceNames.Any(name => !string.IsNullOrEmpty(name) &&
                     name.Contains("Pro", StringComparison.OrdinalIgnoreCase)))
            {
                userBadge = "<span class='badge bg-primary fw-bold ms-1 shadow-sm'><i class='bi bi-star-fill text-warning me-1'></i>PRO</span>";
            }
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E_Greeting</title>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- External CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Caveat:wght@600&family=Cinzel:wght@600;700&family=Cormorant+Garamond:ital,wght@0,600;1,600&family=Dancing+Script:wght@600;700&family=Great+Vibes&family=Montserrat:wght@500;700&family=Oswald:wght@500;700&family=Pacifico&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- HEADER & FLOATING NAVBAR -->
    <header>
        <nav id="smartNavbar" class="navbar navbar-expand-lg navbar-custom">
            <div class="container-fluid">
                <a class="navbar-brand navbar-brand-custom d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-envelope-heart-fill text-primary me-2 fs-3 fw-semibold"></i> E-Greeting
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3 align-items-center">
                        @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("ADMIN")))
                        {
                            <!-- ADMIN NAVIGATION LINKS MATCHING SEPARATE ADMIN CONTROLLERS -->
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom @(isAdminDashboardActive ? "active" : "")" asp-controller="Admin" asp-action="Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom @(isAdminCategoriesActive ? "active" : "")" asp-controller="AdminCategory" asp-action="Categories">Categories &amp; Templates</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom @(isAdminUsersActive ? "active" : "")" asp-controller="AdminUserVip" asp-action="Users">Users &amp; VIP</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom @(isAdminFeedbacksActive ? "active" : "")" asp-controller="AdminFeedback" asp-action="Feedbacks">Feedbacks</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom @(isAdminSentLogsActive ? "active" : "")" asp-controller="AdminSentHistory" asp-action="SentLogs">Sent History Logs</a>
                            </li>
                        }
                        else
                        {
                            <!-- USER NAVIGATION LINKS -->
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom @(isHomeActive ? "active" : "")" asp-controller="Home" asp-action="Index">Home</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom @(isSubscriptionActive ? "active" : "")" asp-controller="Subscription" asp-action="Index">Subscription</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom @(isFeedbackActive ? "active" : "")" asp-controller="Feedback" asp-action="Index">Feedback</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom @(isHistoryActive ? "active" : "")" asp-controller="Card" asp-action="History">History</a>
                            </li>
                        }
                    </ul>

                    <!-- ACCOUNT / AUTHENTICATION SECTION -->
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin") || User.IsInRole("ADMIN"))
                            {
                                <a class="btn btn-primary btn-sm rounded-pill px-3 fw-semibold" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Administrator
                                </a>
                            }
                            else
                            {
                                <a class="btn btn-outline-secondary btn-sm rounded-pill px-3 d-inline-flex align-items-center" asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person-circle me-1"></i> @displayName @Html.Raw(userBadge)
                                </a>
                            }

                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link text-secondary p-0 ms-2 text-decoration-none fs-5">
                                    <i class="bi bi-box-arrow-right" title="Logout"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-link text-decoration-none text-dark fw-semibold" asp-controller="Account" asp-action="Login">LOGIN</a>
                            <a class="btn btn-primary rounded-pill px-4 btn-sm fw-semibold shadow-sm" asp-controller="Account" asp-action="Register">Register here</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT AREA -->
    <div class="container my-5">
        <div id="toastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1080;"></div>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- GLOBAL NOTICE MODAL -->
    <div class="modal fade" id="noticeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content text-center p-4 border-0 shadow rounded-4">
                <div class="modal-body p-2">
                    <div id="noticeIcon" class="mb-3"></div>
                    <h5 id="noticeTitle" class="fw-bold text-dark mb-2"></h5>
                    <p id="noticeMessage" class="text-secondary small mb-4"></p>
                    <button type="button" class="btn btn-primary px-4 py-2 rounded-pill fw-bold" data-bs-dismiss="modal">OK</button>
                </div>
            </div>
        </div>
    </div>

    <!-- FOOTER -->
    <footer class="footer-custom pt-5">
        <div class="container pb-4">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="footer-heading d-flex align-items-center">
                        <i class="bi bi-envelope-heart me-2 text-primary"></i> E-Greeting
                    </h5>
                    <p class="small">An online e-greeting platform helping you deliver heartfelt messages, birthday wishes, wedding congratulations, and holiday greetings in the most personalized and meaningful way.</p>
                    <div class="d-flex gap-2 mt-3">
                        <a href="#" class="social-icon"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-heading">Quick Links</h5>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right me-1"></i> Home</a></li>
                        <li><a asp-controller="Subscription" asp-action="Index"><i class="bi bi-chevron-right me-1"></i> Subscriptions</a></li>
                        <li><a asp-controller="Feedback" asp-action="Index"><i class="bi bi-chevron-right me-1"></i> Feedback</a></li>
                        <li><a asp-controller="Account" asp-action="Login"><i class="bi bi-chevron-right me-1"></i> Login</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-heading">Greeting Service</h5>
                    <p class="small">Subscribe to our service to send automated scheduled greeting cards to your loved ones effortlessly.</p>
                    <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill w-100">
                        <i class="bi bi-card-checklist me-1"></i> Subscribe Now
                    </a>
                </div>
            </div>
        </div>

        <div class="border-top border-secondary py-3" style="background-color: #11151c;">
            <div class="container text-center text-md-between d-flex flex-column flex-md-row justify-content-between align-items-center small">
                <p class="mb-0">&copy; 2026 <strong>E-Greeting Web Application</strong>. All rights reserved.</p>
                <div class="mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy" class="me-3">Privacy Policy</a>
                    <a href="#">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- JS SCRIPTS -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <!-- GLOBAL NOTICE MODAL SCRIPT -->
    <script>
            function showNoticeModal(title, message, isSuccess = true, redirectUrl = null) {
                const modalEl = document.getElementById('noticeModal');
                if (!modalEl) {
                    alert(message);
                    if (redirectUrl) window.location.href = redirectUrl;
                    return;
                }

                document.getElementById('noticeTitle').innerText = title || (isSuccess ? "Success" : "Notification");
                document.getElementById('noticeMessage').innerText = message;

                const iconEl = document.getElementById('noticeIcon');
                if (isSuccess) {
                    iconEl.innerHTML = '<i class="bi bi-check-circle-fill text-success display-4"></i>';
                } else {
                    iconEl.innerHTML = '<i class="bi bi-exclamation-triangle-fill text-danger display-4"></i>';
                }

                const modalInstance = bootstrap.Modal.getOrCreateInstance(modalEl);

                if (redirectUrl) {
                    const handleClose = function() {
                        window.location.href = redirectUrl;
                        modalEl.removeEventListener('hidden.bs.modal', handleClose);
                    };
                    modalEl.addEventListener('hidden.bs.modal', handleClose);
                }

                modalInstance.show();
            }
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>