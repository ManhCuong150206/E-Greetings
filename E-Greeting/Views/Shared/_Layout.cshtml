@using System.Security.Claims
@using Microsoft.EntityFrameworkCore
@inject E_Greeting.Models.AppDbContext _context
@{
    // Default: No badge if not logged in or on a free plan
    string userBadge = "";

    if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        // Get current username or email
        string currentUserName = User.Identity.Name ?? "";

        // Convert DateTime.Now to DateOnly for DB comparison
        DateOnly today = DateOnly.FromDateTime(DateTime.Now);

        // Fetch active service names only if IsActive = true AND Payment Status = "PAID"
        var activeServiceNames = _context.Subscriptions
            .Include(s => s.Service)
            .Include(s => s.Account)
            .Include(s => s.Payments)
            .Where(s => (s.Account.Name == currentUserName || s.Account.Email == currentUserName)
                     && s.IsActive
                     && (s.EndDate == null || s.EndDate >= today)
                     && s.Payments.Any(p => p.Status == "PAID"))
            .Select(s => s.Service.Name)
            .ToList();

        // Prioritize displaying VIP / Premium if any VIP plan is active and paid
        if (activeServiceNames.Any(name => !string.IsNullOrEmpty(name) &&
            (name.Contains("VIP", StringComparison.OrdinalIgnoreCase) || name.Contains("Premium", StringComparison.OrdinalIgnoreCase))))
        {
            userBadge = "<span class='badge bg-warning text-dark fw-bold ms-1 shadow-sm'><i class='bi bi-crown-fill text-danger me-1'></i>VIP</span>";
        }
        else if (activeServiceNames.Any(name => !string.IsNullOrEmpty(name) &&
                 name.Contains("Pro", StringComparison.OrdinalIgnoreCase)))
        {
            userBadge = "<span class='badge bg-primary fw-bold ms-1 shadow-sm'><i class='bi bi-star-fill text-warning me-1'></i>PRO</span>";
        }
    }
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E_Greeting</title>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- External CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Caveat:wght@600&family=Cinzel:wght@600;700&family=Cormorant+Garamond:ital,wght@0,600;1,600&family=Dancing+Script:wght@600;700&family=Great+Vibes&family=Montserrat:wght@500;700&family=Oswald:wght@500;700&family=Pacifico&family=Playfair+Display:ital,wght@0,600;1,600&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- HEADER & NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
            <div class="container">
                <a class="navbar-brand navbar-brand-custom d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-envelope-heart-fill text-primary me-2 fs-3"></i> E-Greeting
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        @if (User.Identity != null && User.Identity.IsAuthenticated && (User.IsInRole("Admin") || User.IsInRole("ADMIN")))
                        {
                            <!-- 5 ADMIN BACK-OFFICE TABS -->
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom fw-semibold" asp-controller="Admin" asp-action="Dashboard">📊 Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom fw-semibold" asp-controller="Admin" asp-action="Categories">📁 Categories & Templates</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom fw-semibold" asp-controller="Admin" asp-action="Users">👥 Users & VIP</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom fw-semibold" asp-controller="Admin" asp-action="Feedbacks">💬 Feedbacks</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom fw-semibold" asp-controller="Admin" asp-action="SentLogs">✉️ Sent History Logs</a>
                            </li>
                        }
                        else
                        {
                            <!-- DEFAULT USER / CUSTOMER MENU -->
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Index">HOME</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Subscription" asp-action="Index">SUBSCRIBE</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Feedback" asp-action="Index">FEEDBACK</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" asp-controller="Card" asp-action="History">HISTORY</a>
                            </li>
                        }
                    </ul>

                    <!-- ACCOUNT / AUTH -->
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin") || User.IsInRole("ADMIN"))
                            {
                                <!-- ADMIN DIRECT DASHBOARD LINK -->
                                <a class="btn btn-danger btn-sm rounded-pill px-3 fw-semibold" asp-controller="Admin" asp-action="Dashboard">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Administrator (@User.Identity.Name)
                                </a>
                            }
                            else
                            {
                                <!-- REGULAR USER PROFILE -->
                                <a class="btn btn-outline-secondary btn-sm rounded-pill px-3 d-inline-flex align-items-center" asp-controller="Account" asp-action="Profile">
                                    <i class="bi bi-person-circle me-1"></i> @User.Identity.Name @Html.Raw(userBadge)
                                </a>
                            }

                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link text-secondary p-0 ms-2 text-decoration-none fs-5">
                                    <i class="bi bi-box-arrow-right" title="Logout"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-link text-decoration-none text-dark fw-semibold" asp-controller="Account" asp-action="Login">LOGIN</a>
                            <a class="btn btn-primary rounded-pill px-4 btn-sm fw-semibold shadow-sm" asp-controller="Account" asp-action="Register">Register here</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <div class="container my-5">
        <div id="toastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1080;"></div>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="footer-custom pt-5">
        <div class="container pb-4">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="footer-heading d-flex align-items-center">
                        <i class="bi bi-envelope-heart me-2 text-primary"></i> E-Greeting
                    </h5>
                    <p class="small">An online e-greeting platform helping you deliver heartfelt messages, birthday wishes, wedding congratulations, and holiday greetings in the most personalized and meaningful way.</p>
                    <div class="d-flex gap-2 mt-3">
                        <a href="#" class="social-icon"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-heading">Quick Links</h5>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right me-1"></i> Home</a></li>
                        <li><a asp-controller="Subscription" asp-action="Index"><i class="bi bi-chevron-right me-1"></i> Subscriptions</a></li>
                        <li><a asp-controller="Feedback" asp-action="Index"><i class="bi bi-chevron-right me-1"></i> Feedback</a></li>
                        <li><a asp-controller="Account" asp-action="Login"><i class="bi bi-chevron-right me-1"></i> Login</a></li>
                    </ul>
                </div>
                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-heading">Greeting Service</h5>
                    <p class="small">Subscribe to our service to send automated scheduled greeting cards to your loved ones effortlessly.</p>
                    <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill w-100">
                        <i class="bi bi-card-checklist me-1"></i> Subscribe Now
                    </a>
                </div>
            </div>
        </div>

        <div class="border-top border-secondary py-3" style="background-color: #11151c;">
            <div class="container text-center text-md-between d-flex flex-column flex-md-row justify-content-between align-items-center small">
                <p class="mb-0">&copy; 2026 <strong>E-Greeting Web Application</strong>. All rights reserved.</p>
                <div class="mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy" class="me-3">Privacy Policy</a>
                    <a href="#">Terms of Service</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- JS Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>