<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - E_Greeting</title>

    <!-- Bootstrap Icons -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <!-- External CSS -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/E_Greeting.styles.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- HEADER & NAVBAR -->
    <header>
        <nav class="navbar navbar-expand-lg navbar-custom sticky-top">
            <div class="container">
                <a class="navbar-brand navbar-brand-custom d-flex align-items-center" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-envelope-heart-fill text-primary me-2 fs-3"></i> E-Greeting
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 ms-lg-3">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Home" asp-action="Index">HOME</a>
                        </li>

                        <!-- CATEGORIES DROPDOWN chuẩn giao diện gốc -->
                        <li class="nav-item dropdown">
                            <a class="nav-link nav-link-custom dropdown-toggle" asp-controller="Category" asp-action="Index" id="catDropdown" role="button" data-bs-toggle="dropdown">
                                CATEGORIES
                            </a>
                            <ul class="dropdown-menu border-0 shadow-sm rounded-3">
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="theloai" asp-action="Index">
                                       <i class="bi bi-border-width me-2 text-default"></i>All
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="theloai" asp-action="sinh-nhat">
										@* asp-route-id="birthday" *@
                                        <i class="bi bi-cake2 me-2 text-warning"></i>Birthday
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Card" asp-action="Category" asp-route-id="wedding">
                                        <i class="bi bi-heart me-2 text-danger"></i>Wedding
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Card" asp-action="Category" asp-route-id="newyear">
                                        <i class="bi bi-stars me-2 text-info"></i>New Year
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item py-2" asp-controller="Card" asp-action="Category" asp-route-id="festivals">
                                        <i class="bi bi-balloon me-2 text-success"></i>Festivals
                                    </a>
                                </li>
                            </ul>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Subscription" asp-action="Index">SUBSCRIBE</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" asp-controller="Feedback" asp-action="Index">FEEDBACK</a>
                        </li>
                    </ul>

                    <!-- ACCOUNT / AUTH -->
                    <div class="d-flex align-items-center gap-2">
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            @if (User.IsInRole("Admin"))
                            {
                                <a class="btn btn-danger btn-sm rounded-pill px-3" asp-controller="Admin" asp-action="Index">
                                    <i class="bi bi-shield-lock-fill me-1"></i> Admin Dashboard
                                </a>
                            }
                            <a class="btn btn-outline-secondary btn-sm rounded-pill px-3" asp-controller="Account" asp-action="Profile">
                                <i class="bi bi-person-circle me-1"></i> @User.Identity.Name
                            </a>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-link text-secondary p-0 ms-2 text-decoration-none fs-5">
                                    <i class="bi bi-box-arrow-right" title="Logout"></i>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-link text-decoration-none text-dark fw-semibold" asp-controller="Account" asp-action="Login">LOGIN</a>
                            <a class="btn btn-primary rounded-pill px-4 btn-sm fw-semibold shadow-sm" asp-controller="Account" asp-action="Register">Register here</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT -->
    <div class="container my-5">
        <div id="toastContainer" class="position-fixed top-0 end-0 p-3" style="z-index: 1080;"></div>

        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="footer-custom pt-5">
        <div class="container pb-4">
            <div class="row g-4">
                <div class="col-lg-4 col-md-6">
                    <h5 class="footer-heading d-flex align-items-center">
                        <i class="bi bi-envelope-heart me-2 text-primary"></i> E-Greeting
                    </h5>
                    <p class="small">Nền tảng gửi thiệp điện tử trực tuyến giúp bạn truyền tải thông điệp yêu thương, lời chúc mừng sinh nhật, tiệc cưới và các lễ hội một cách cá nhân hóa và ý nghĩa nhất.</p>
                    <div class="d-flex gap-2 mt-3">
                        <a href="#" class="social-icon"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="social-icon"><i class="bi bi-twitter-x"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-md-6">
                    <h5 class="footer-heading">Liên kết nhanh</h5>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Home" asp-action="Index"><i class="bi bi-chevron-right me-1"></i> Trang chủ</a></li>
                        <li><a asp-controller="Subscription" asp-action="Index"><i class="bi bi-chevron-right me-1"></i> Gói Subscribe</a></li>
                        <li><a asp-controller="Feedback" asp-action="Index"><i class="bi bi-chevron-right me-1"></i> Phản hồi</a></li>
                        <li><a asp-controller="Account" asp-action="Login"><i class="bi bi-chevron-right me-1"></i> Đăng nhập</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-heading">Danh mục thiệp</h5>
                    <ul class="list-unstyled small d-flex flex-column gap-2">
                        <li><a asp-controller="Card" asp-action="Category" asp-route-id="birthday"><i class="bi bi-cake2 me-2"></i>Thiệp Sinh Nhật</a></li>
                        <li><a asp-controller="Card" asp-action="Category" asp-route-id="wedding"><i class="bi bi-heart me-2"></i>Thiệp Đám Cưới</a></li>
                        <li><a asp-controller="Card" asp-action="Category" asp-route-id="newyear"><i class="bi bi-stars me-2"></i>Thiệp Năm Mới</a></li>
                        <li><a asp-controller="Card" asp-action="Category" asp-route-id="festivals"><i class="bi bi-balloon me-2"></i>Lễ Hội Khác</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h5 class="footer-heading">Dịch vụ gửi thiệp</h5>
                    <p class="small">Đăng ký dịch vụ tự động để gửi thiệp hàng ngày đến danh sách người thân yêu của bạn.</p>
                    <a asp-controller="Subscription" asp-action="Index" class="btn btn-outline-light btn-sm rounded-pill w-100">
                        <i class="bi bi-card-checklist me-1"></i> Đăng ký dịch vụ
                    </a>
                </div>
            </div>
        </div>

        <div class="border-top border-secondary py-3" style="background-color: #11151c;">
            <div class="container text-center text-md-between d-flex flex-column flex-md-row justify-content-between align-items-center small">
                <p class="mb-0">&copy; 2026 <strong>E-Greeting Web Application</strong>. All rights reserved.</p>
                <div class="mt-2 mt-md-0">
                    <a asp-controller="Home" asp-action="Privacy" class="me-3">Chính sách bảo mật</a>
                    <a href="#">Điều khoản sử dụng</a>
                </div>
            </div>
        </div>
    </footer>

    <!-- JS Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>