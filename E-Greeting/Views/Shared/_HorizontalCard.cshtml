@model dynamic

<div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="position-relative">
        <img src="@Model.ImagePath" class="card-img-top object-fit-cover" style="height: 200px;" alt="@Model.Name">
        <span class="badge bg-info text-dark position-absolute top-0 start-0 m-2 px-2 py-1">
            <i class="bi bi-aspect-ratio me-1"></i> Dáng ngang
        </span>
        <button class="btn btn-light btn-sm rounded-circle position-absolute top-0 end-0 m-2 shadow-sm text-danger">
            <i class="bi bi-heart"></i>
        </button>
    </div>
    <div class="card-body d-flex flex-column justify-content-between text-center p-3">
        <h6 class="card-title fw-bold text-truncate mb-2">@Model.Name</h6>
        <a href="#" class="btn btn-outline-primary btn-sm rounded-pill fw-semibold w-100">
            Tạo thiệp ngay
        </a>
    </div>
</div>