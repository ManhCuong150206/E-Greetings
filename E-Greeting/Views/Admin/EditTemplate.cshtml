@model E_Greeting.Models.Template
@using System.Text.Json;

@{
    ViewData["Title"] = "Chỉnh Sửa Template - Admin Editor";

    string bgImage = "/uploads/templates/default-card.jpg";
    JsonElement elementsArray = default;
    bool hasElements = false;

    if (!string.IsNullOrWhiteSpace(Model?.ConfigData))
    {
        try
        {
            using var doc = JsonDocument.Parse(Model.ConfigData);
            var root = doc.RootElement;

            if (root.TryGetProperty("background_image", out var bgProp) && !string.IsNullOrWhiteSpace(bgProp.GetString()))
            {
                bgImage = bgProp.GetString()!;
            }
            else if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                bgImage = Model.ImagePath;
            }

            if (root.TryGetProperty("elements", out var elProp) && elProp.ValueKind == JsonValueKind.Array)
            {
                elementsArray = elProp.Clone();
                hasElements = elementsArray.GetArrayLength() > 0;
            }
        }
        catch { }
    }
    else if (!string.IsNullOrEmpty(Model?.ImagePath))
    {
        bgImage = Model.ImagePath;
    }
}

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="bi bi-pencil-square me-2 text-warning"></i> Trình Chỉnh Sửa Template #@(Model?.Id ?? 0)</h3>
        <a asp-action="Templates" asp-route-categoryId="@(Model?.CategoryId ?? 0)" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left"></i> Hủy & Quay lại
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="EditTemplate" method="post" enctype="multipart/form-data" id="form-edit-template">
        <input type="hidden" name="id" value="@Model?.Id" />
        <input type="hidden" name="configData" id="input-config-data" />

        <div class="row">
            <!-- BÊN TRÁI: KHUNG TRẮNG CANVAS 600x420 -->
            <div class="col-md-7">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-card-image me-1"></i> Khung Thiết Kế Ảnh Bìa</span>
                        <span class="badge bg-light text-primary">Mẫu #@(Model?.Id ?? 0)</span>
                    </div>
                    <div class="card-body p-3 d-flex justify-content-center bg-dark bg-opacity-10 overflow-auto">
                        <div id="card-preview-area"
                             class="position-relative shadow border rounded bg-white overflow-hidden"
                             style="width: 100%; max-width: 600px; height: 420px; background-image: url('@bgImage'); background-size: contain; background-repeat: no-repeat; background-position: center; user-select: none;">

                            @if (hasElements)
                            {
                                bool isFirst = true;
                                foreach (var item in elementsArray.EnumerateArray())
                                {
                                    string content = item.TryGetProperty("content", out var c) ? c.GetString() ?? "" : "";
                                    string top = item.TryGetProperty("top", out var t) ? t.GetString() ?? "75%" : "75%";
                                    string left = item.TryGetProperty("left", out var l) ? l.GetString() ?? "15%" : "15%";
                                    string width = item.TryGetProperty("width", out var w_val) ? w_val.GetString() ?? "273px" : "273px";
                                    string font = item.TryGetProperty("fontFamily", out var f) ? f.GetString() ?? "Arial" : "Arial";
                                    string size = item.TryGetProperty("fontSize", out var s) ? s.GetString() ?? "18px" : "18px";
                                    string color = item.TryGetProperty("color", out var cl) ? cl.GetString() ?? "#000000" : "#000000";
                                    string weight = item.TryGetProperty("fontWeight", out var w) ? w.GetString() ?? "bold" : "bold";
                                    string style = item.TryGetProperty("fontStyle", out var st) ? st.GetString() ?? "normal" : "normal";

                                    <div class="draggable-text-box @(isFirst ? "active" : "") position-absolute p-2 rounded text-center d-flex align-items-center justify-content-center"
                                         style="top: @top; left: @left; width: @width; min-height: 110px; color: @color; font-family: @font; font-size: @size; font-weight: @weight; font-style: @style; cursor: move; border: @(isFirst ? "2px dashed #0d6efd" : "1px dashed rgba(13,110,253,0.5)"); background: rgba(255,255,255,0.4); box-sizing: border-box;">
                                        <span class="text-content" style="white-space: pre-wrap; display: block; width: 100%;">@content</span>
                                    </div>
                                    isFirst = false;
                                }
                            }
                            else
                            {
                                <div class="draggable-text-box active position-absolute p-2 rounded text-center d-flex align-items-center justify-content-center"
                                     style="top: 75%; left: 15%; width: 273px; min-height: 110px; color: #000000; font-family: Arial; font-size: 18px; font-weight: bold; font-style: normal; cursor: move; border: 2px dashed #0d6efd; background: rgba(255,255,255,0.4); box-sizing: border-box;">
                                    <span class="text-content" style="white-space: pre-wrap; display: block; width: 100%;">Lời Chúc Mẫu Dành Cho User</span>
                                </div>
                            }

                        </div>
                    </div>
                </div>
            </div>

            <!-- BÊN PHẢI: BẢNG CÔNG CỤ -->
            <div class="col-md-5">
                <div class="card shadow-sm p-4">
                    <h6 class="fw-bold text-primary mb-3">
                        <i class="bi bi-tools me-1"></i> Công Cụ Đặt Text Mẫu Cho User
                    </h6>

                    <div class="d-flex gap-2 mb-3">
                        <button type="button" id="btn-add-text" class="btn btn-sm btn-outline-primary w-50">
                            <i class="bi bi-plus-circle me-1"></i> Thêm Khung Chữ
                        </button>
                        <button type="button" id="btn-delete-text" class="btn btn-sm btn-outline-danger w-50">
                            <i class="bi bi-trash me-1"></i> Xóa Khung Chữ
                        </button>
                    </div>

                    <div class="mb-3 p-2 border rounded bg-light">
                        <label class="form-label form-label-sm fw-bold text-dark mb-1">
                            <i class="bi bi-pencil me-1"></i> Sửa nội dung văn bản đang chọn:
                        </label>
                        <textarea id="tool-text-val" class="form-control form-control-sm" rows="2" placeholder="Nhấp chọn một khung chữ để sửa..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-bold">Định dạng văn bản:</label>
                        <div class="row g-2 mb-2">
                            <div class="col-7">
                                <!-- ĐỒNG BỘ NGUYÊN DANH SÁCH FONT TỪ PERSONALIZE -->
                                <select id="tool-font" class="form-select form-select-sm">
                                    <option value="Arial">Arial</option>
                                    <option value="'Roboto', sans-serif">Roboto</option>
                                    <option value="'Dancing Script', cursive">Dancing Script</option>
                                    <option value="'Pacifico', cursive">Pacifico</option>
                                    <option value="'Montserrat', sans-serif">Montserrat</option>
                                </select>
                            </div>
                            <div class="col-5">
                                <select id="tool-size" class="form-select form-select-sm">
                                    <option value="14px">14px</option>
                                    <option value="16px">16px</option>
                                    <option value="18px">18px</option>
                                    <option value="20px">20px</option>
                                    <option value="24px">24px</option>
                                    <option value="28px">28px</option>
                                    <option value="32px">32px</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="small fw-semibold me-1">Màu chữ:</span>
                            <input type="color" id="tool-color" class="form-control form-control-color form-control-sm" value="#000000" title="Chọn màu chữ">
                            <button type="button" id="btn-toggle-bold" class="btn btn-sm btn-outline-secondary px-3 fw-bold">B</button>
                            <button type="button" id="btn-toggle-italic" class="btn btn-sm btn-outline-secondary px-3 fst-italic">I</button>
                        </div>

                        <div class="mt-2">
                            <div class="d-flex justify-content-between">
                                <label for="slider-text-width" class="form-label form-label-sm mb-0">Độ rộng khung chữ:</label>
                                <span id="val-text-width" class="small text-muted fw-bold">273px</span>
                            </div>
                            <input type="range" id="slider-text-width" class="form-range form-range-sm" min="100" max="580" value="273">
                        </div>
                    </div>

                    <hr class="my-3" />

                    <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary">
                        <i class="bi bi-info-circle me-1"></i> Thông Tin Template
                    </h5>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên Template (*)</label>
                        <input type="text" name="name" class="form-control" value="@Model?.Name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Thuộc Danh Mục</label>
                        <select name="categoryId" class="form-select">
                            @if (ViewBag.Categories != null)
                            {
                                foreach (var cat in (List<E_Greeting.Models.Category>)ViewBag.Categories)
                                {
                                    <option value="@cat.Id" selected="@(cat.Id == Model?.CategoryId)">@cat.Name</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label fw-semibold">Gói Quyền Lợi</label>
                            <select name="isFree" class="form-select">
                                <option value="true" selected="@(Model?.IsFree == true)">Miễn Phí (Free)</option>
                                <option value="false" selected="@(Model?.IsFree == false)">Trả Phí (VIP Premium)</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label fw-semibold">Trạng Thái Hiển Thị</label>
                            <select name="isActive" class="form-select">
                                <option value="true" selected="@(Model?.IsActive == true)">Hiển Thị (Active)</option>
                                <option value="false" selected="@(Model?.IsActive == false)">Ẩn (Inactive)</option>
                            </select>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-image text-primary me-1"></i> 1. Thay Ảnh Bìa Thô Canvas mới (Nếu có)
                        </label>
                        <input type="file" name="imageFile" id="input-bg-file" class="form-control" accept="image/*" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-card-image text-primary me-1"></i> 2. Thay Ảnh Đại Diện Card Preview mới (Nếu có)
                        </label>
                        <input type="file" name="thumbnailFile" class="form-control" accept="image/*" />
                    </div>

                    <button type="submit" class="btn btn-warning btn-lg w-100 mt-2 fw-semibold">
                        <i class="bi bi-save me-1"></i> Lưu Cập Nhật Template
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let selectedItem = null;

        function rgbToHex(rgb) {
            if (!rgb) return '#000000';
            if (rgb.startsWith('#')) return rgb;
            const res = rgb.match(/\d+/g);
            return res ? "#" + res.slice(0, 3).map(x => parseInt(x).toString(16).padStart(2, '0')).join('') : rgb;
        }

        document.getElementById('input-bg-file').addEventListener('change', function (e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function (evt) {
                    document.getElementById('card-preview-area').style.backgroundImage = `url('${evt.target.result}')`;
                }
                reader.readAsDataURL(file);
            }
        });

        function bindElementEvents(el) {
            el.addEventListener('click', function (e) {
                e.stopPropagation();
                document.querySelectorAll('.draggable-text-box').forEach(item => {
                    item.classList.remove('active');
                    item.style.border = '1px dashed rgba(13,110,253,0.5)';
                });
                selectedItem = el;
                selectedItem.classList.add('active');
                selectedItem.style.border = '2px dashed #0d6efd';

                const textNode = selectedItem.querySelector('.text-content');
                document.getElementById('tool-text-val').value = textNode ? textNode.innerText : '';
                document.getElementById('tool-font').value = selectedItem.style.fontFamily.replace(/['"]/g, '') || 'Arial';
                document.getElementById('tool-size').value = selectedItem.style.fontSize || '18px';
                document.getElementById('tool-color').value = rgbToHex(selectedItem.style.color) || '#000000';

                const currentWidth = parseInt(selectedItem.style.width) || selectedItem.offsetWidth || 273;
                document.getElementById('slider-text-width').value = currentWidth;
                document.getElementById('val-text-width').innerText = currentWidth + 'px';

                const isBold = selectedItem.style.fontWeight === 'bold' || selectedItem.style.fontWeight === '700';
                const isItalic = selectedItem.style.fontStyle === 'italic';

                document.getElementById('btn-toggle-bold').classList.toggle('btn-primary', isBold);
                document.getElementById('btn-toggle-bold').classList.toggle('text-white', isBold);
                document.getElementById('btn-toggle-bold').classList.toggle('btn-outline-secondary', !isBold);

                document.getElementById('btn-toggle-italic').classList.toggle('btn-primary', isItalic);
                document.getElementById('btn-toggle-italic').classList.toggle('text-white', isItalic);
                document.getElementById('btn-toggle-italic').classList.toggle('btn-outline-secondary', !isItalic);
            });

            let isDragging = false, offsetCustomX = 0, offsetCustomY = 0;
            const container = document.getElementById('card-preview-area');

            el.addEventListener('mousedown', function (e) {
                isDragging = true;
                const rect = el.getBoundingClientRect();
                offsetCustomX = e.clientX - rect.left;
                offsetCustomY = e.clientY - rect.top;
            });

            document.addEventListener('mousemove', function (e) {
                if (!isDragging || selectedItem !== el) return;
                const containerRect = container.getBoundingClientRect();
                let leftPX = e.clientX - containerRect.left - offsetCustomX;
                let topPX = e.clientY - containerRect.top - offsetCustomY;

                let leftPercent = (leftPX / containerRect.width) * 100;
                let topPercent = (topPX / containerRect.height) * 100;

                leftPercent = Math.max(0, Math.min(leftPercent, 95));
                topPercent = Math.max(0, Math.min(topPercent, 95));

                el.style.left = leftPercent.toFixed(2) + '%';
                el.style.top = topPercent.toFixed(2) + '%';
            });

            document.addEventListener('mouseup', function () { isDragging = false; });
        }

        document.querySelectorAll('.draggable-text-box').forEach(el => {
            bindElementEvents(el);
        });

        const initialActive = document.querySelector('.draggable-text-box.active') || document.querySelector('.draggable-text-box');
        if (initialActive) {
            initialActive.click();
        }

        document.getElementById('slider-text-width').addEventListener('input', function (e) {
            const val = e.target.value;
            document.getElementById('val-text-width').innerText = val + 'px';
            if (selectedItem) {
                selectedItem.style.width = val + 'px';
            }
        });

        document.getElementById('tool-text-val').addEventListener('input', function (e) {
            if (selectedItem) {
                const textNode = selectedItem.querySelector('.text-content');
                if (textNode) textNode.innerText = e.target.value || ' ';
            }
        });

        document.getElementById('tool-font').addEventListener('change', function (e) {
            if (selectedItem) selectedItem.style.fontFamily = e.target.value;
        });

        document.getElementById('tool-size').addEventListener('change', function (e) {
            if (selectedItem) selectedItem.style.fontSize = e.target.value;
        });

        document.getElementById('tool-color').addEventListener('input', function (e) {
            if (selectedItem) selectedItem.style.color = e.target.value;
        });

        document.getElementById('btn-toggle-bold').addEventListener('click', function () {
            if (selectedItem) {
                const isCurrentBold = selectedItem.style.fontWeight === 'bold' || selectedItem.style.fontWeight === '700';
                selectedItem.style.fontWeight = isCurrentBold ? 'normal' : 'bold';
                this.classList.toggle('btn-primary', !isCurrentBold);
                this.classList.toggle('text-white', !isCurrentBold);
                this.classList.toggle('btn-outline-secondary', isCurrentBold);
            }
        });

        document.getElementById('btn-toggle-italic').addEventListener('click', function () {
            if (selectedItem) {
                const isCurrentItalic = selectedItem.style.fontStyle === 'italic';
                selectedItem.style.fontStyle = isCurrentItalic ? 'normal' : 'italic';
                this.classList.toggle('btn-primary', !isCurrentItalic);
                this.classList.toggle('text-white', !isCurrentItalic);
                this.classList.toggle('btn-outline-secondary', isCurrentItalic);
            }
        });

        // SỬA NỘI DUNG VĂN BẢN MỚI THÀNH "Văn bản mới" VÀ MÀU ĐEN (#000000)
        document.getElementById('btn-add-text').addEventListener('click', function () {
            document.querySelectorAll('.draggable-text-box').forEach(item => {
                item.classList.remove('active');
                item.style.border = '1px dashed rgba(13,110,253,0.5)';
            });

            const newEl = document.createElement('div');
            newEl.className = 'draggable-text-box active position-absolute p-2 rounded text-center d-flex align-items-center justify-content-center';
            newEl.style.cssText = 'top: 40%; left: 15%; width: 273px; min-height: 110px; color: #000000; font-family: Arial; font-size: 18px; font-weight: bold; font-style: normal; border: 2px dashed #0d6efd; background: rgba(255,255,255,0.4); cursor: move; box-sizing: border-box;';
            newEl.innerHTML = '<span class="text-content" style="white-space: pre-wrap; display: block; width: 100%;">Văn bản mới</span>';

            document.getElementById('card-preview-area').appendChild(newEl);
            bindElementEvents(newEl);
            newEl.click();
        });

        document.getElementById('btn-delete-text').addEventListener('click', function () {
            const allItems = document.querySelectorAll('.draggable-text-box');
            if (allItems.length > 1 && selectedItem) {
                selectedItem.remove();
                selectedItem = document.querySelector('.draggable-text-box');
                if (selectedItem) selectedItem.click();
            } else {
                alert('Phải giữ lại ít nhất 1 khung chữ mẫu!');
            }
        });

        document.getElementById('form-edit-template').addEventListener('submit', function (e) {
            const elements = [];
            document.querySelectorAll('#card-preview-area .draggable-text-box').forEach(el => {
                const textNode = el.querySelector('.text-content');

                let topVal = el.style.top || '75%';
                let leftVal = el.style.left || '15%';

                if (!topVal.toString().includes('%') && !topVal.toString().includes('px')) topVal += '%';
                if (!leftVal.toString().includes('%') && !leftVal.toString().includes('px')) leftVal += '%';

                elements.push({
                    content: textNode ? textNode.innerText : '',
                    top: topVal,
                    left: leftVal,
                    width: el.style.width || '273px',
                    fontFamily: el.style.fontFamily || 'Arial',
                    fontSize: el.style.fontSize || '18px',
                    fontWeight: el.style.fontWeight || 'bold',
                    fontStyle: el.style.fontStyle || 'normal',
                    color: el.style.color || '#000000'
                });
            });

            const currentBg = "@bgImage";
            document.getElementById('input-config-data').value = JSON.stringify({
                background_image: currentBg,
                elements: elements
            });
        });
    </script>
}