@model E_Greeting.Models.UserManagementViewModel
@{
    ViewData["Title"] = "Manage Users & VIP Packages";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-bold text-primary mb-0">
            <i class="bi bi-people-fill me-2"></i>Manage User Accounts & VIP Packages
        </h3>
    </div>

    <!-- MAIN TABS -->
    <ul class="nav nav-pills mb-4 gap-2 bg-light p-2 rounded border" id="userManagementTabs" role="tablist">
        <li class="nav-item">
            <a class="nav-link fw-bold @(Model.ActiveTab == "users" ? "active" : "")" href="/Admin/Users?tab=users">
                <i class="bi bi-person-badge me-2"></i>1. User Accounts List
            </a>
        </li>
        <li class="nav-item">
            <a class="nav-link fw-bold @(Model.ActiveTab == "payments" ? "active" : "")" href="/Admin/Users?tab=payments">
                <i class="bi bi-card-checklist me-2"></i>2. VIP Packages & Payment History
            </a>
        </li>
    </ul>

    <div class="tab-content">
        <!-- SUB-TAB 1: USERS LIST -->
        @if (Model.ActiveTab == "users")
        {
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <form id="userSearchForm" method="get" action="/Admin/Users" class="row g-2 align-items-center">
                        <input type="hidden" name="tab" value="users" />
                        <div class="col-md-6">
                            <div class="input-group">
                                <span class="input-group-text bg-light"><i class="bi bi-search text-primary"></i></span>
                                <input type="text" id="searchUserInput" name="searchUser" class="form-control" placeholder="Search by name or email..." value="@Model.SearchUser">
                            </div>
                        </div>
                        <div class="col-md-1">
                            <a href="/Admin/Users?tab=users" class="btn btn-outline-secondary w-100" title="Reset search">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>
                        </div>
                    </form>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th width="80">No.</th>
                                    <th>User Name</th>
                                    <th>Email Address</th>
                                    <th>Current VIP Package</th>
                                    <th>Sent Cards</th>
                                    <th width="120">Status</th>
                                    <th class="text-end pe-4" width="180">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Users != null && Model.Users.Any())
                                {
                                    @foreach (var u in Model.Users)
                                    {
                                        <tr>
                                            <td class="fw-bold">@u.Id</td>
                                            <td class="fw-bold text-dark">@u.Name</td>
                                            <td>@u.Email</td>
                                            <td>
                                                @if (u.CurrentVipPackage != "Free" && u.CurrentVipPackage != "Free Package")
                                                {
                                                    <span class="badge bg-success">@u.CurrentVipPackage</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">Free Package</span>
                                                }
                                            </td>
                                            <td><span class="fw-bold">@u.SentCardsCount</span> cards</td>
                                            <td>
                                                <div style="min-width: 85px;">
                                                    @if (u.Status)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success px-2 py-1">Active</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger px-2 py-1">Locked</span>
                                                    }
                                                </div>
                                            </td>
                                            <td class="text-end pe-4">
                                                <div class="d-inline-flex gap-1 justify-content-end align-items-center" style="white-space: nowrap;">
                                                    <button type="button" class="btn btn-sm btn-outline-primary" data-bs-toggle="modal" data-bs-target="#editUserModal_@u.Id" style="width: 70px;">
                                                        <i class="bi bi-pencil me-1"></i>Edit
                                                    </button>

                                                    <button type="button" class="btn btn-sm @(u.Status ? "btn-outline-danger" : "btn-outline-success")" data-bs-toggle="modal" data-bs-target="#toggleStatusModal_@u.Id" style="width: 85px;">
                                                        @if (u.Status)
                                                        {
                                                            <span><i class="bi bi-lock me-1"></i>Lock</span>
                                                        }
                                                        else
                                                        {
                                                            <span><i class="bi bi-unlock me-1"></i>Unlock</span>
                                                        }
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="7" class="text-center py-4 text-muted">No accounts found.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- USERS PAGINATION -->
                @if (ViewBag.TotalPagesUser > 1)
                {
                    <div class="card-footer bg-white d-flex justify-content-center py-2">
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                @for (int i = 1; i <= ViewBag.TotalPagesUser; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPageUser ? "active" : "")">
                                        <a class="page-link" href="/Admin/Users?tab=users&searchUser=@Model.SearchUser&pageUser=@i">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>

            <!-- MODALS FOR USER EDIT & LOCK/UNLOCK CONFIRMATION -->
            @if (Model.Users != null && Model.Users.Any())
            {
                @foreach (var u in Model.Users)
                {
                    <!-- EDIT USER MODAL (EMAIL SET TO READONLY) -->
                    <div class="modal fade text-start" id="editUserModal_@u.Id" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content shadow border-0 rounded-4">
                                <form method="post" action="/Admin/EditUser">
                                    <div class="modal-header bg-primary text-white border-0 py-3">
                                        <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit User Information</h5>
                                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                    </div>
                                    <div class="modal-body p-4">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Email Address (Read-only)</label>
                                            <input type="email" class="form-control bg-light" value="@u.Email" readonly disabled />
                                            <small class="text-muted d-block mt-2">
                                                <i class="bi bi-exclamation-circle-fill text-warning me-1"></i>Email serves as the unique account identity and cannot be changed.
                                            </small>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold">Full Name</label>
                                            <input type="text" name="name" class="form-control" value="@u.Name" required />
                                        </div>
                                    </div>
                                    <div class="modal-footer border-0 pb-4 pe-4">
                                        <button type="button" class="btn btn-secondary fw-semibold px-4" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-primary fw-semibold px-4">Save Changes</button>
                                    </div>
                                </form>
                            </div>
                        </div>
                    </div>

                    <!-- LOCK / UNLOCK CONFIRMATION MODAL -->
                    <div class="modal fade" id="toggleStatusModal_@u.Id" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                            <div class="modal-content text-center p-4 rounded-4 shadow border-0">
                                <div class="modal-body p-0">
                                    <div class="mb-3">
                                        @if (u.Status)
                                        {
                                            <div class="mx-auto rounded-circle bg-danger-subtle d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                                                <i class="bi bi-exclamation-octagon text-danger display-5"></i>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="mx-auto rounded-circle bg-success-subtle d-flex align-items-center justify-content-center" style="width: 70px; height: 70px;">
                                                <i class="bi bi-shield-check text-success display-5"></i>
                                            </div>
                                        }
                                    </div>
                                    <h4 class="fw-bold mb-2">@(u.Status ? "Lock Account?" : "Unlock Account?")</h4>
                                    <p class="text-secondary small mb-4">
                                        Are you sure you want to @(u.Status ? "lock" : "unlock") account <strong>@u.Name</strong>?
                                    </p>
                                    <form method="post" action="/Admin/ToggleUserStatus">
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <div class="d-flex justify-content-center gap-2">
                                            <button type="button" class="btn btn-light fw-semibold px-4 py-2" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn @(u.Status ? "btn-danger" : "btn-success") fw-semibold px-4 py-2">
                                                Confirm @(u.Status ? "Lock" : "Unlock")
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        }

        <!-- SUB-TAB 2: VIP PACKAGES & PAYMENT HISTORY -->
        @if (Model.ActiveTab == "payments")
        {
            <!-- BLOCK 1: SERVICE PACKAGES MANAGEMENT -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-box-seam me-2 text-primary"></i>VIP Services List (Services)</h6>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        @foreach (var s in Model.Services)
                        {
                            <div class="col-md-6">
                                <div class="p-3 border rounded bg-light d-flex justify-content-between align-items-start h-100">
                                    <div style="max-width: 70%;">
                                        <span class="badge bg-primary mb-2 fs-6">@s.Id. @s.Name</span>
                                        <div class="text-muted small mb-1">Price: <strong class="text-danger">@s.Price.ToString("N0") VNĐ</strong></div>
                                        <div class="text-secondary small lh-base">Features: @s.Features</div>
                                    </div>
                                    <div>
                                        <button class="btn btn-sm btn-outline-primary fw-semibold" data-bs-toggle="modal" data-bs-target="#editServiceModal_@s.Id">
                                            <i class="bi bi-pencil me-1"></i> Edit Package
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Modal Edit Service (PRICE EDITABLE ONLY) -->
                            <div class="modal fade text-start" id="editServiceModal_@s.Id" tabindex="-1">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content shadow border-0 rounded-4">
                                        <form method="post" action="/Admin/EditService">
                                            <div class="modal-header bg-primary text-white border-0 py-3">
                                                <h5 class="modal-title fw-bold"><i class="bi bi-pencil-square me-2"></i>Edit VIP Service Price</h5>
                                                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                            </div>
                                            <div class="modal-body p-4">
                                                <input type="hidden" name="id" value="@s.Id" />

                                                <!-- Package Name (READONLY) -->
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Package Name</label>
                                                    <input type="text" class="form-control bg-light" value="@s.Name" readonly />
                                                </div>

                                                <!-- Price (EDITABLE WITH NON-NEGATIVE & REQUIRED VALIDATION) -->
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Price (VNĐ)</label>
                                                    <input type="number" name="price" class="form-control" value="@s.Price" step="1000" min="0" required />
                                                </div>

                                                <!-- Package Features (READONLY) -->
                                                <div class="mb-3">
                                                    <label class="form-label fw-semibold">Package Features</label>
                                                    <textarea class="form-control bg-light" rows="3" readonly>@s.Features</textarea>
                                                    <small class="text-muted d-block mt-2">
                                                        <i class="bi bi-exclamation-circle-fill text-warning me-1"></i>Package identity and features are locked to preserve historical subscription integrity.
                                                    </small>
                                                </div>
                                            </div>
                                            <div class="modal-footer border-0 pb-4 pe-4">
                                                <button type="button" class="btn btn-secondary fw-semibold px-4" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary fw-semibold px-4">Save Price</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- BLOCK 2: TRANSACTION HISTORY & AUTO-FILTER -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <form id="txSearchForm" method="get" action="/Admin/Users" class="row g-2 align-items-center">
                        <input type="hidden" name="tab" value="payments" />
                        <div class="col-md-5">
                            <input type="text" id="searchTxInput" name="searchTx" class="form-control" placeholder="Search by name, email, invoice ID..." value="@Model.SearchTransaction">
                        </div>
                        <div class="col-md-3">
                            <select name="serviceId" class="form-select auto-submit-tx">
                                <option value="">-- All VIP Packages --</option>
                                @foreach (var s in Model.Services)
                                {
                                    <option value="@s.Id" selected="@(Model.SelectedServiceId == s.Id)">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <select name="status" class="form-select auto-submit-tx">
                                <option value="">-- All Statuses --</option>
                                <option value="PAID" selected="@(Model.SelectedStatus == "PAID")">PAID</option>
                                <option value="UNPAID" selected="@(Model.SelectedStatus == "UNPAID")">UNPAID</option>
                                <option value="EXPIRED" selected="@(Model.SelectedStatus == "EXPIRED")">EXPIRED</option>
                            </select>
                        </div>
                        <div class="col-md-1">
                            <a href="/Admin/Users?tab=payments" class="btn btn-outline-secondary w-100" title="Reset filter">
                                <i class="bi bi-arrow-counterclockwise"></i>
                            </a>
                        </div>
                    </form>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th width="80">No.</th>
                                    <th>Buyer</th>
                                    <th>Subscribed Package</th>
                                    <th>Amount</th>
                                    <th>Invoice Date</th>
                                    <th>VIP Expiry Date</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4" width="180">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Transactions != null && Model.Transactions.Any())
                                {
                                    @foreach (var t in Model.Transactions)
                                    {
                                        <tr>
                                            <td class="fw-bold">@t.PaymentId</td>
                                            <td>
                                                <div class="fw-bold">@t.UserName</div>
                                                <div class="small text-muted">@t.UserEmail</div>
                                            </td>
                                            <td><span class="badge bg-info text-dark">@t.ServiceName</span></td>
                                            <td class="fw-bold text-success">@t.Amount.ToString("N0") VNĐ</td>
                                            <td>@t.PaymentDate.ToString("dd/MM/yyyy")</td>
                                            <td>
                                                @if (t.VipStartDate.HasValue && t.VipEndDate.HasValue)
                                                {
                                                    <div class="small fw-semibold text-dark">
                                                        @t.VipStartDate.Value.ToString("dd/MM/yy") - @t.VipEndDate.Value.ToString("dd/MM/yy")
                                                    </div>

                                                    @if (t.Status == "PAID")
                                                    {
                                                        if (t.VipEndDate.Value >= DateTime.Now.Date)
                                                        {
                                                            <span class="badge bg-success-subtle text-success border border-success mt-1" style="font-size: 10px;">
                                                                <i class="bi bi-clock-check me-1"></i>Active
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge bg-secondary-subtle text-secondary border border-secondary mt-1" style="font-size: 10px;">
                                                                <i class="bi bi-clock-history me-1"></i>Expired
                                                            </span>
                                                        }
                                                    }
                                                }
                                                else
                                                {
                                                    <span class="text-muted small">N/A</span>
                                                }
                                            </td>
                                            <td>
                                                @if (t.Status == "PAID")
                                                {
                                                    <span class="badge bg-success">PAID</span>
                                                }
                                                else if (t.Status == "UNPAID")
                                                {
                                                    <span class="badge bg-warning text-dark">UNPAID</span>
                                                }
                                                else if (t.Status == "EXPIRED")
                                                {
                                                    <span class="badge bg-secondary">EXPIRED</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-secondary">@t.Status</span>
                                                }
                                            </td>
                                            <td class="text-end pe-4">
                                                @if (t.Status == "UNPAID" || t.Status == "EXPIRED")
                                                {
                                                    <button type="button" class="btn btn-sm btn-success" data-bs-toggle="modal" data-bs-target="#approvePaymentModal_@t.PaymentId">
                                                        <i class="bi bi-check-lg me-1"></i>Approve PAID
                                                    </button>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-success border border-success"><i class="bi bi-check-circle-fill me-1"></i>Completed</span>
                                                }
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr><td colspan="8" class="text-center py-4 text-muted">No transactions found.</td></tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- PAYMENTS PAGINATION -->
                @if (ViewBag.TotalPagesTx > 1)
                {
                    <div class="card-footer bg-white d-flex justify-content-center py-2">
                        <nav>
                            <ul class="pagination pagination-sm mb-0">
                                @for (int i = 1; i <= ViewBag.TotalPagesTx; i++)
                                {
                                    <li class="page-item @(i == ViewBag.CurrentPageTx ? "active" : "")">
                                        <a class="page-link" href="/Admin/Users?tab=payments&searchTx=@Model.SearchTransaction&serviceId=@Model.SelectedServiceId&status=@Model.SelectedStatus&pageTx=@i">@i</a>
                                    </li>
                                }
                            </ul>
                        </nav>
                    </div>
                }
            </div>

            <!-- MODALS FOR PAYMENT APPROVAL CONFIRMATION -->
            @if (Model.Transactions != null && Model.Transactions.Any())
            {
                @foreach (var t in Model.Transactions)
                {
                    <div class="modal fade" id="approvePaymentModal_@t.PaymentId" tabindex="-1">
                        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                            <div class="modal-content text-center p-4 rounded-4 shadow border-0">
                                <div class="modal-body p-0">
                                    <div class="mx-auto rounded-circle bg-warning-subtle d-flex align-items-center justify-content-center mb-3" style="width: 70px; height: 70px;">
                                        <i class="bi bi-star-fill text-warning display-5"></i>
                                    </div>
                                    <h4 class="fw-bold mb-2">Approve Transaction?</h4>
                                    <p class="text-secondary small mb-4">
                                        Confirm manual approval for invoice <strong>#@t.PaymentId</strong> of user <strong>@t.UserName</strong>?
                                    </p>
                                    <form method="post" action="/Admin/ApprovePayment">
                                        <input type="hidden" name="paymentId" value="@t.PaymentId" />
                                        <div class="d-flex justify-content-center gap-2">
                                            <button type="button" class="btn btn-light fw-semibold px-4 py-2" data-bs-dismiss="modal">Cancel</button>
                                            <button type="submit" class="btn btn-warning fw-semibold px-4 py-2 text-dark">
                                                Approve PAID
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            }
        }
    </div>
</div>

<!-- FLOATING CENTER NOTIFICATION POPUP -->
@if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
{
    <div class="modal fade" id="globalAlertModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content text-center p-4 rounded-4 shadow border-0">
                <div class="modal-body p-0">
                    <div class="mb-3">
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="mx-auto rounded-circle bg-success-subtle d-flex align-items-center justify-content-center" style="width: 75px; height: 75px;">
                                <i class="bi bi-check-circle-fill text-success display-4"></i>
                            </div>
                        }
                        else
                        {
                            <div class="mx-auto rounded-circle bg-danger-subtle d-flex align-items-center justify-content-center" style="width: 75px; height: 75px;">
                                <i class="bi bi-exclamation-triangle-fill text-danger display-4"></i>
                            </div>
                        }
                    </div>
                    <h4 class="fw-bold mb-2">@(TempData["SuccessMessage"] != null ? "Success!" : "Notice")</h4>
                    <p class="text-secondary small mb-4">
                        @(TempData["SuccessMessage"] ?? TempData["ErrorMessage"])
                    </p>
                    <button type="button" class="btn @(TempData["SuccessMessage"] != null ? "btn-success" : "btn-danger") fw-semibold px-5 py-2" data-bs-dismiss="modal">
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // AUTOMATICALLY SHOW CENTERED POPUP MODAL ON SUCCESS/ERROR
            const alertModalEl = document.getElementById('globalAlertModal');
            if (alertModalEl) {
                const alertModal = new bootstrap.Modal(alertModalEl);
                alertModal.show();
            }

            // 1. User Search Auto-Submit with Debounce
            const userSearchInput = document.getElementById('searchUserInput');
            const userSearchForm = document.getElementById('userSearchForm');
            if (userSearchInput && userSearchForm) {
                let userTimer;
                userSearchInput.addEventListener('input', function () {
                    clearTimeout(userTimer);
                    userTimer = setTimeout(() => {
                        userSearchForm.submit();
                    }, 400);
                });
            }

            // 2. Transaction Search & Dropdowns Auto-Submit
            const txSearchInput = document.getElementById('searchTxInput');
            const txSearchForm = document.getElementById('txSearchForm');
            if (txSearchInput && txSearchForm) {
                let txTimer;
                txSearchInput.addEventListener('input', function () {
                    clearTimeout(txTimer);
                    txTimer = setTimeout(() => {
                        txSearchForm.submit();
                    }, 400);
                });

                document.querySelectorAll('.auto-submit-tx').forEach(selectEl => {
                    selectEl.addEventListener('change', function () {
                        txSearchForm.submit();
                    });
                });
            }
        });
    </script>
}