@{
    ViewData["Title"] = "Thêm Template Mới - Admin Editor";
}

<div class="container-fluid my-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3><i class="bi bi-magic me-2 text-primary"></i> Trình Thiết Kế Mẫu Template (Admin Preset)</h3>
        <a asp-action="Templates" asp-route-categoryId="@ViewBag.CategoryId" class="btn btn-outline-secondary rounded-pill">
            <i class="bi bi-arrow-left"></i> Hủy & Quay lại
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="CreateTemplate" method="post" enctype="multipart/form-data" id="form-create-template">
        <input type="hidden" name="categoryId" value="@ViewBag.CategoryId" />
        <input type="hidden" name="configData" id="input-config-data" />

        <div class="row">
            <!-- BÊN TRÁI: KHUNG TRẮNG CANVAS 600x420 CHUẨN USER -->
            <div class="col-md-7">
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-card-image me-1"></i> Khung Thiết Kế Ảnh Bìa</span>
                        <span class="badge bg-light text-primary">Admin Create</span>
                    </div>
                    <div class="card-body p-3 d-flex justify-content-center bg-dark bg-opacity-10 overflow-auto">
                        <div id="card-preview-area"
                             class="position-relative shadow border rounded bg-white overflow-hidden"
                             style="width: 100%; max-width: 600px; height: 420px; background-image: url('data:image/svg+xml;charset=UTF-8,%3Csvg%20width%3D%22600%22%20height%3D%22420%22%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%3E%3Crect%20width%3D%22100%25%22%20height%3D%22100%25%22%20fill%3D%22%23ffffff%22%2F%3E%3Ctext%20x%3D%2250%25%22%20y%3D%2250%25%22%20font-size%3D%2218%22%20fill%3D%22%236c757d%22%20text-anchor%3D%22middle%22%20dy%3D%22.3em%22%3ECh%C6%B0a%20Upload%20%20%20nh%20B%C3%ACa%20Th%C3%B4%3C%2Ftext%3E%3C%2Fsvg%3E'); background-size: contain; background-repeat: no-repeat; background-position: center; user-select: none;">

                            <div class="draggable-text-box active position-absolute p-2 rounded text-center"
                                 style="top: 75%; left: 15%; width: 273px; color: #ff0000; font-family: Arial; font-size: 18px; font-weight: bold; font-style: normal; cursor: move; border: 2px dashed #0d6efd; background: rgba(255,255,255,0.4);">
                                <span class="text-content" style="white-space: pre-wrap; display: block;">Lời Chúc Mẫu Dành Cho User</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- BÊN PHẢI: BẢNG CÔNG CỤ -->
            <div class="col-md-5">
                <div class="card shadow-sm p-4">
                    <h5 class="fw-bold mb-3 border-bottom pb-2 text-primary">
                        <i class="bi bi-info-circle me-1"></i> Thông Tin Template
                    </h5>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tên Template (*)</label>
                        <input type="text" name="name" class="form-control" placeholder="Ví dụ: Thiệp Sinh Nhật Sang Trọng 01" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">Loại Gói Quyền Lợi</label>
                        <select name="isFree" class="form-select">
                            <option value="true">Miễn Phí (Free)</option>
                            <option value="false">Trả Phí (VIP Premium)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-image text-primary me-1"></i> 1. Upload Ảnh Bìa Thô (Background Canvas *)
                        </label>
                        <input type="file" name="imageFile" id="input-bg-file" class="form-control" accept="image/*" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            <i class="bi bi-card-image text-primary me-1"></i> 2. Upload Ảnh Đại Diện Card (Preview Thumbnail)
                        </label>
                        <input type="file" name="thumbnailFile" class="form-control" accept="image/*" />
                    </div>

                    <hr />

                    <h6 class="fw-bold text-primary mb-3">
                        <i class="bi bi-fonts me-1"></i> Công Cụ Đặt Text Mẫu Cho User
                    </h6>

                    <div class="d-flex gap-2 mb-3">
                        <button type="button" id="btn-add-text" class="btn btn-sm btn-outline-primary w-50">
                            <i class="bi bi-plus-circle me-1"></i> Thêm Khung Chữ
                        </button>
                        <button type="button" id="btn-delete-text" class="btn btn-sm btn-outline-danger w-50">
                            <i class="bi bi-trash me-1"></i> Xóa Khung Chữ
                        </button>
                    </div>

                    <div class="mb-2">
                        <label class="form-label small fw-semibold">Nội dung chữ đang chọn:</label>
                        <textarea id="tool-text-val" class="form-control form-control-sm" rows="2" placeholder="Nhập văn bản...">Lời Chúc Mẫu Dành Cho User</textarea>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Font chữ:</label>
                            <select id="tool-font" class="form-select form-select-sm">
                                <option value="Arial">Arial</option>
                                <option value="'Roboto', sans-serif">Roboto</option>
                                <option value="'Dancing Script', cursive">Dancing Script</option>
                                <option value="'Pacifico', cursive">Pacifico</option>
                                <option value="'Montserrat', sans-serif">Montserrat</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Kích thước (Size):</label>
                            <select id="tool-size" class="form-select form-select-sm">
                                <option value="14px">14px</option>
                                <option value="16px">16px</option>
                                <option value="18px" selected>18px</option>
                                <option value="20px">20px</option>
                                <option value="24px">24px</option>
                                <option value="28px">28px</option>
                                <option value="32px">32px</option>
                            </select>
                        </div>
                        <div class="col-6 mt-2">
                            <label class="form-label small fw-semibold">Màu chữ:</label>
                            <input type="color" id="tool-color" class="form-control form-control-color w-100" value="#ff0000" />
                        </div>
                        <div class="col-6 mt-2 d-flex align-items-end gap-1">
                            <button type="button" id="btn-toggle-bold" class="btn btn-sm btn-dark flex-fill fw-bold" title="In đậm">B</button>
                            <button type="button" id="btn-toggle-italic" class="btn btn-sm btn-outline-dark flex-fill fst-italic" title="In nghiêng">I</button>
                        </div>
                    </div>

                    <div class="mb-3">
                        <div class="d-flex justify-content-between">
                            <label for="slider-text-width" class="form-label small fw-semibold mb-1">Độ rộng khung chữ:</label>
                            <span id="val-text-width" class="small text-muted fw-bold">273px</span>
                        </div>
                        <input type="range" id="slider-text-width" class="form-range form-range-sm" min="100" max="580" value="273">
                    </div>

                    <button type="submit" class="btn btn-success btn-lg w-100 mt-2 fw-semibold">
                        <i class="bi bi-cloud-upload me-1"></i> Lưu & Tạo Template
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let selectedItem = document.querySelector('.draggable-text-box');

        function rgbToHex(rgb) {
            if (!rgb) return '#ff0000';
            if (rgb.startsWith('#')) return rgb;
            const res = rgb.match(/\d+/g);
            return res ? "#" + res.slice(0, 3).map(x => parseInt(x).toString(16).padStart(2, '0')).join('') : rgb;
        }

        document.getElementById('input-bg-file').addEventListener('change', function(e) {
            const file = e.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(evt) {
                    document.getElementById('card-preview-area').style.backgroundImage = `url('${evt.target.result}')`;
                }
                reader.readAsDataURL(file);
            }
        });

        function bindElementEvents(el) {
            el.addEventListener('click', function(e) {
                e.stopPropagation();
                document.querySelectorAll('.draggable-text-box').forEach(item => {
                    item.classList.remove('active');
                    item.style.border = '1px dashed rgba(13,110,253,0.5)';
                });
                selectedItem = el;
                selectedItem.classList.add('active');
                selectedItem.style.border = '2px dashed #0d6efd';

                const textNode = selectedItem.querySelector('.text-content');
                document.getElementById('tool-text-val').value = textNode ? textNode.innerText : '';
                document.getElementById('tool-font').value = selectedItem.style.fontFamily.replace(/['"]/g, '') || 'Arial';
                document.getElementById('tool-size').value = selectedItem.style.fontSize || '18px';
                document.getElementById('tool-color').value = rgbToHex(selectedItem.style.color) || '#ff0000';

                const currentWidth = parseInt(selectedItem.style.width) || selectedItem.offsetWidth || 273;
                document.getElementById('slider-text-width').value = currentWidth;
                document.getElementById('val-text-width').innerText = currentWidth + 'px';

                const isBold = selectedItem.style.fontWeight === 'bold' || selectedItem.style.fontWeight === '700';
                const isItalic = selectedItem.style.fontStyle === 'italic';

                document.getElementById('btn-toggle-bold').classList.toggle('btn-dark', isBold);
                document.getElementById('btn-toggle-bold').classList.toggle('btn-outline-dark', !isBold);

                document.getElementById('btn-toggle-italic').classList.toggle('btn-dark', isItalic);
                document.getElementById('btn-toggle-italic').classList.toggle('btn-outline-dark', !isItalic);
            });

            let isDragging = false, offsetCustomX = 0, offsetCustomY = 0;
            const container = document.getElementById('card-preview-area');

            el.addEventListener('mousedown', function(e) {
                isDragging = true;
                const rect = el.getBoundingClientRect();
                offsetCustomX = e.clientX - rect.left;
                offsetCustomY = e.clientY - rect.top;
            });

            document.addEventListener('mousemove', function(e) {
                if (!isDragging || selectedItem !== el) return;
                const containerRect = container.getBoundingClientRect();
                let leftPX = e.clientX - containerRect.left - offsetCustomX;
                let topPX = e.clientY - containerRect.top - offsetCustomY;

                let leftPercent = (leftPX / containerRect.width) * 100;
                let topPercent = (topPX / containerRect.height) * 100;

                leftPercent = Math.max(0, Math.min(leftPercent, 80));
                topPercent = Math.max(0, Math.min(topPercent, 90));

                el.style.left = leftPercent.toFixed(2) + '%';
                el.style.top = topPercent.toFixed(2) + '%';
            });

            document.addEventListener('mouseup', function() { isDragging = false; });
        }

        if (selectedItem) bindElementEvents(selectedItem);

        document.getElementById('slider-text-width').addEventListener('input', function(e) {
            const val = e.target.value;
            document.getElementById('val-text-width').innerText = val + 'px';
            if (selectedItem) {
                selectedItem.style.width = val + 'px';
            }
        });

        document.getElementById('tool-text-val').addEventListener('input', function(e) {
            if (selectedItem) {
                const textNode = selectedItem.querySelector('.text-content');
                if (textNode) textNode.innerText = e.target.value || ' ';
            }
        });

        document.getElementById('tool-font').addEventListener('change', function(e) {
            if (selectedItem) selectedItem.style.fontFamily = e.target.value;
        });

        document.getElementById('tool-size').addEventListener('change', function(e) {
            if (selectedItem) selectedItem.style.fontSize = e.target.value;
        });

        document.getElementById('tool-color').addEventListener('input', function(e) {
            if (selectedItem) selectedItem.style.color = e.target.value;
        });

        document.getElementById('btn-toggle-bold').addEventListener('click', function() {
            if (selectedItem) {
                const isCurrentBold = selectedItem.style.fontWeight === 'bold' || selectedItem.style.fontWeight === '700';
                selectedItem.style.fontWeight = isCurrentBold ? 'normal' : 'bold';
                this.classList.toggle('btn-dark', !isCurrentBold);
                this.classList.toggle('btn-outline-dark', isCurrentBold);
            }
        });

        document.getElementById('btn-toggle-italic').addEventListener('click', function() {
            if (selectedItem) {
                const isCurrentItalic = selectedItem.style.fontStyle === 'italic';
                selectedItem.style.fontStyle = isCurrentItalic ? 'normal' : 'italic';
                this.classList.toggle('btn-dark', !isCurrentItalic);
                this.classList.toggle('btn-outline-dark', isCurrentItalic);
            }
        });

        document.getElementById('btn-add-text').addEventListener('click', function() {
            const newEl = document.createElement('div');
            newEl.className = 'draggable-text-box position-absolute p-2 rounded text-center';
            newEl.style.cssText = 'top: 40%; left: 15%; width: 273px; color: #ff0000; font-family: Arial; font-size: 18px; font-weight: bold; font-style: normal; background: rgba(255,255,255,0.4); cursor: move;';
            newEl.innerHTML = '<span class="text-content" style="white-space: pre-wrap; display: block;">Chữ Mới Thêm</span>';

            document.getElementById('card-preview-area').appendChild(newEl);
            bindElementEvents(newEl);
            newEl.click();
        });

        document.getElementById('btn-delete-text').addEventListener('click', function() {
            const allItems = document.querySelectorAll('.draggable-text-box');
            if (allItems.length > 1 && selectedItem) {
                selectedItem.remove();
                selectedItem = document.querySelector('.draggable-text-box');
                if (selectedItem) selectedItem.click();
            } else {
                alert('Phải giữ lại ít nhất 1 khung chữ mẫu!');
            }
        });

        document.getElementById('form-create-template').addEventListener('submit', function(e) {
            const elements = [];
            document.querySelectorAll('#card-preview-area .draggable-text-box').forEach(el => {
                const textNode = el.querySelector('.text-content');

                let topVal = el.style.top || '75%';
                let leftVal = el.style.left || '15%';

                if (!topVal.toString().includes('%') && !topVal.toString().includes('px')) topVal += '%';
                if (!leftVal.toString().includes('%') && !leftVal.toString().includes('px')) leftVal += '%';

                elements.push({
                    content: textNode ? textNode.innerText : '',
                    top: topVal,
                    left: leftVal,
                    width: el.style.width || '273px',
                    fontFamily: el.style.fontFamily || 'Arial',
                    fontSize: el.style.fontSize || '18px',
                    fontWeight: el.style.fontWeight || 'bold',
                    fontStyle: el.style.fontStyle || 'normal',
                    color: el.style.color || '#ff0000'
                });
            });

            document.getElementById('input-config-data').value = JSON.stringify({ elements: elements });
        });
    </script>
}