@model IEnumerable<E_Greeting.Models.Category>

@{
    ViewData["Title"] = "Category & Template Management";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold">
            <i class="bi bi-folder-fill me-2"></i>Category & Template Management
        </h2>
    </div>

    <!-- SEARCH BAR & CREATE NEW CATEGORY FORM -->
    <div class="row g-3 my-2">
        <div class="col-md-7">
            <div class="card shadow-sm p-3 rounded-3 h-100">
                <h6 class="fw-bold mb-2"><i class="bi bi-plus-circle text-primary me-1"></i> Add New Category</h6>
                <form asp-controller="AdminCategory" asp-action="Create" method="post" class="row g-2 align-items-center">
                    <div class="col-8">
                        <input type="text" name="Name" class="form-control" placeholder="Enter new category name..." required />
                    </div>
                    <div class="col-4">
                        <button type="submit" class="btn btn-primary fw-semibold w-100">
                            <i class="bi bi-save me-1"></i> Add New
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm p-3 rounded-3 h-100 bg-light">
                <h6 class="fw-bold mb-2"><i class="bi bi-search text-primary me-1"></i> Search Category</h6>
                <form asp-controller="AdminCategory" asp-action="Categories" method="get" class="row g-2">
                    <div class="col-7">
                        <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control" placeholder="Enter category name..." />
                    </div>
                    <div class="col-5 d-flex gap-1">
                        <button type="submit" class="btn btn-primary text-white fw-semibold flex-fill">
                            <i class="bi bi-search me-1"></i> Search
                        </button>
                        <a asp-controller="AdminCategory" asp-action="Categories" class="btn btn-outline-secondary" title="Reset search">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- CATEGORY LIST TABLE -->
    <div class="card shadow-sm rounded-3 mt-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th width="80">No.</th>
                        <th>Category Name</th>
                        <th class="text-center">Manage Card Templates</th>
                        <th width="220" class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.Id</td>
                                <td class="fw-semibold">@item.Name</td>

                                <td class="text-center">
                                    <a asp-controller="AdminTemplate" asp-action="Templates" asp-route-categoryId="@item.Id" class="btn btn-sm btn-outline-info rounded-pill fw-semibold me-1">
                                        <i class="bi bi-images me-1"></i> View (@(item.Templates?.Count ?? 0) Templates)
                                    </a>

                                    <a asp-controller="AdminTemplate" asp-action="CreateTemplate" asp-route-categoryId="@item.Id" class="btn btn-sm btn-success rounded-pill fw-semibold" title="Quickly create card template for this category">
                                        <i class="bi bi-plus-lg me-1"></i> Add New Template
                                    </a>
                                </td>

                                <td class="text-center">
                                    <div class="d-inline-flex gap-1 justify-content-center">
                                        <!-- TRIGGER EDIT MODAL -->
                                        <button type="button" class="btn btn-sm btn-warning fw-semibold" data-bs-toggle="modal" data-bs-target="#editCategoryModal-@item.Id">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </button>

                                        <!-- TRIGGER DELETE CONFIRMATION MODAL -->
                                        <button type="button" class="btn btn-sm btn-danger fw-semibold" data-bs-toggle="modal" data-bs-target="#deleteCategoryModal-@item.Id">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </div>

                                    <!-- EDIT CATEGORY POPUP MODAL (CENTERED) -->
                                    <div class="modal fade text-start" id="editCategoryModal-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content shadow border-0 rounded-4">
                                                <div class="modal-header bg-primary text-white border-0 py-3">
                                                    <h5 class="modal-title fw-bold">
                                                        <i class="bi bi-pencil-square me-2"></i>Edit Category
                                                    </h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <form asp-controller="AdminCategory" asp-action="Edit" asp-route-id="@item.Id" method="post">
                                                    <div class="modal-body p-4">
                                                        <input type="hidden" name="Id" value="@item.Id" />
                                                        <div class="mb-3">
                                                            <label class="form-label fw-semibold">Category Name (*)</label>
                                                            <input type="text" name="Name" class="form-control" value="@item.Name" required />
                                                        </div>
                                                    </div>
                                                    <div class="modal-footer border-0 pb-4 pe-4">
                                                        <button type="button" class="btn btn-secondary fw-semibold px-4" data-bs-dismiss="modal">Cancel</button>
                                                        <button type="submit" class="btn btn-primary fw-semibold px-4">
                                                            <i class="bi bi-save me-1"></i> Save Changes
                                                        </button>
                                                    </div>
                                                </form>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- DELETE CONFIRMATION POPUP MODAL (CENTERED) -->
                                    <div class="modal fade text-center" id="deleteCategoryModal-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
                                            <div class="modal-content p-4 rounded-4 shadow border-0">
                                                <div class="modal-body p-0">
                                                    <div class="mx-auto rounded-circle bg-danger-subtle d-flex align-items-center justify-content-center mb-3" style="width: 75px; height: 75px;">
                                                        <i class="bi bi-exclamation-octagon text-danger display-4"></i>
                                                    </div>
                                                    <h4 class="fw-bold mb-2">Delete Category?</h4>
                                                    <p class="text-secondary small mb-4">
                                                        Are you sure you want to delete category <strong>@item.Name</strong>? This action cannot be undone.
                                                    </p>
                                                    <form asp-controller="AdminCategory" asp-action="Delete" asp-route-id="@item.Id" method="post">
                                                        <div class="d-flex justify-content-center gap-2">
                                                            <button type="button" class="btn btn-light fw-semibold px-4 py-2" data-bs-dismiss="modal">Cancel</button>
                                                            <button type="submit" class="btn btn-danger fw-semibold px-4 py-2">
                                                                Confirm Delete
                                                            </button>
                                                        </div>
                                                    </form>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No matching categories found.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-center py-2">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-controller="AdminCategory" asp-action="Categories" asp-route-searchName="@ViewBag.SearchName" asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- FLOATING CENTER NOTIFICATION POPUP (MATCHING GLOBAL DESIGN) -->
@if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
{
    <div class="modal fade" id="globalCategoryAlertModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content text-center p-4 rounded-4 shadow border-0">
                <div class="modal-body p-0">
                    <div class="mb-3">
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="mx-auto rounded-circle bg-success-subtle d-flex align-items-center justify-content-center" style="width: 75px; height: 75px;">
                                <i class="bi bi-check-circle-fill text-success display-4"></i>
                            </div>
                        }
                        else
                        {
                            <div class="mx-auto rounded-circle bg-danger-subtle d-flex align-items-center justify-content-center" style="width: 75px; height: 75px;">
                                <i class="bi bi-exclamation-triangle-fill text-danger display-4"></i>
                            </div>
                        }
                    </div>
                    <h4 class="fw-bold mb-2">@(TempData["SuccessMessage"] != null ? "Success!" : "Notice")</h4>
                    <p class="text-secondary small mb-4">
                        @(TempData["SuccessMessage"] ?? TempData["ErrorMessage"])
                    </p>
                    <button type="button" class="btn @(TempData["SuccessMessage"] != null ? "btn-success" : "btn-danger") fw-semibold px-5 py-2" data-bs-dismiss="modal">
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // AUTOMATICALLY SHOW CENTERED POPUP MODAL ON SUCCESS/ERROR
            const alertModalEl = document.getElementById('globalCategoryAlertModal');
            if (alertModalEl) {
                const alertModal = new bootstrap.Modal(alertModalEl);
                alertModal.show();
            }
        });
    </script>
}