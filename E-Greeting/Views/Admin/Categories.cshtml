@model IEnumerable<E_Greeting.Models.Category>

@{
    ViewData["Title"] = "Quản lý Danh mục & Template";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-folder-fill text-primary"></i> Quản lý Danh mục & Template</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- THANH TÌM KIẾM & FORM THÊM MỚI DANH MỤC -->
    <div class="row g-3 my-2">
        <div class="col-md-7">
            <div class="card shadow-sm p-3 rounded-3 h-100">
                <h6 class="fw-bold mb-2"><i class="bi bi-plus-circle text-primary me-1"></i> Thêm Danh mục Mới</h6>
                <form asp-action="Create" method="post" class="row g-2 align-items-center">
                    <div class="col-8">
                        <input type="text" name="Name" class="form-control" placeholder="Nhập tên danh mục mới..." required />
                    </div>
                    <div class="col-4">
                        <button type="submit" class="btn btn-primary fw-semibold w-100">
                            <i class="bi bi-save me-1"></i> Thêm mới
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="col-md-5">
            <div class="card shadow-sm p-3 rounded-3 h-100 bg-light">
                <h6 class="fw-bold mb-2"><i class="bi bi-search text-info me-1"></i> Tìm kiếm Danh mục</h6>
                <form asp-action="Categories" method="get" class="row g-2">
                    <div class="col-8">
                        <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control" placeholder="Nhập tên danh mục cần tìm..." />
                    </div>
                    <div class="col-4">
                        <button type="submit" class="btn btn-info text-white fw-semibold w-100">
                            <i class="bi bi-search me-1"></i> Tìm
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- BẢNG DANH SÁCH CATEGORY -->
    <div class="card shadow-sm rounded-3 mt-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th width="80">ID</th>
                        <th>Tên Danh Mục</th>
                        <th class="text-center">Quản lý Mẫu Thiệp</th>
                        <th width="240" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">#@item.Id</td>
                                <td class="fw-semibold">@item.Name</td>

                                <td class="text-center">
                                    <a asp-action="Templates" asp-route-categoryId="@item.Id" class="btn btn-sm btn-outline-info rounded-pill fw-semibold me-1">
                                        <i class="bi bi-images me-1"></i> Xem (@(item.Templates?.Count ?? 0) Template)
                                    </a>
                                    
                                    <!-- NÚT FAST-ACCESS: TẠO TEMPLATE NHANH TRỰC TIẾP -->
                                    <a asp-action="CreateTemplate" asp-route-categoryId="@item.Id" class="btn btn-sm btn-success rounded-pill fw-semibold" title="Tạo mẫu thiệp nhanh cho danh mục này">
                                        <i class="bi bi-plus-lg me-1"></i> Thêm Template Mới
                                    </a>
                                </td>

                                <td class="text-center">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1 fw-semibold">
                                        <i class="bi bi-pencil-square"></i> Sửa
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                                        <button type="submit" class="btn btn-sm btn-danger fw-semibold">
                                            <i class="bi bi-trash"></i> Xóa
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Khôn tìm thấy danh mục nào phù hợp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PHÂN TRANG -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-center py-2">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-action="Categories" asp-route-searchName="@ViewBag.SearchName" asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>