@model E_Greeting.Models.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Quản Trị Hệ Thống";
}

<!-- Nhập thư viện Chart.js vẽ biểu đồ -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<div class="container-fluid py-4">
    <h3 class="fw-bold mb-4 text-primary">
        <i class="bi bi-speedometer2 me-2"></i>Dashboard Quản Trị Hệ Thống
    </h3>

    <!-- KHỐI 1: CÁC THẺ THỐNG KÊ TỔNG QUAN -->
    <div class="row g-3 mb-4">
        <!-- Tổng Doanh Thu Tất Cả Các Gói -->
        <div class="col-md-4 col-xl-2-4">
            <div class="card bg-primary text-white shadow-sm rounded-3 border-0">
                <div class="card-body p-3">
                    <div class="text-white-50 small fw-bold text-uppercase">TỔNG DOANH THU CÁC GÓI</div>
                    <h4 class="fw-bold mb-0 mt-1">@Model.TotalRevenue.ToString("N0") VNĐ</h4>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-xl-2-4">
            <div class="card bg-success text-white shadow-sm rounded-3 border-0">
                <div class="card-body p-3">
                    <div class="text-white-50 small fw-bold text-uppercase">THIỆP ĐÃ GỬI</div>
                    <h4 class="fw-bold mb-0 mt-1">@Model.TotalSentCards</h4>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-xl-2-4">
            <div class="card bg-info text-white shadow-sm rounded-3 border-0">
                <div class="card-body p-3">
                    <div class="text-white-50 small fw-bold text-uppercase">THÀNH VIÊN (USERS)</div>
                    <h4 class="fw-bold mb-0 mt-1">@Model.TotalUsers</h4>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-2-4">
            <div class="card bg-warning text-white shadow-sm rounded-3 border-0">
                <div class="card-body p-3">
                    <div class="text-white-50 small fw-bold text-uppercase">TỔNG TEMPLATE</div>
                    <h4 class="fw-bold mb-0 mt-1">@Model.TotalTemplates</h4>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-xl-2-4">
            <div class="card bg-secondary text-white shadow-sm rounded-3 border-0">
                <div class="card-body p-3">
                    <div class="text-white-50 small fw-bold text-uppercase">DANH MỤC THIỆP</div>
                    <h4 class="fw-bold mb-0 mt-1">@Model.TotalCategories</h4>
                </div>
            </div>
        </div>
    </div>

    <!-- KHỐI 2: THỐNG KÊ CHI TIẾT TỪNG GÓI DỊCH VỤ (SERVICE) -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-white py-3">
            <h6 class="fw-bold text-dark mb-0">
                <i class="bi bi-box-seam me-2 text-primary"></i>Chi Tiết Doanh Thu & Lượt Đăng Ký Theo Gói Dịch Vụ
            </h6>
        </div>
        <div class="card-body">
            <div class="row g-3">
                @if (Model.ServiceStats != null && Model.ServiceStats.Any())
                {
                    @foreach (var s in Model.ServiceStats)
                    {
                        <div class="col-md-6">
                            <div class="p-3 border rounded bg-light d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-primary mb-1">ID #@s.ServiceId</span>
                                    <h5 class="fw-bold text-dark mb-1">@s.ServiceName</h5>
                                    <div class="text-muted small">Giá niêm yết: <strong class="text-danger">@s.Price.ToString("N0") VNĐ</strong></div>
                                </div>
                                <div class="text-end">
                                    <div class="fw-bold fs-5 text-success">@s.TotalRevenue.ToString("N0") VNĐ</div>
                                    <div class="small text-secondary">
                                        <i class="bi bi-people me-1"></i><strong>@s.TotalSubscribers</strong> lượt mua thành công
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="col-12 text-center text-muted py-2">Không tìm thấy thông tin gói dịch vụ.</div>
                }
            </div>
        </div>
    </div>

    <!-- KHỐI 3: BIỂU ĐỒ DOANH THU & BẢNG GIAO DỊCH GẦN ĐÂY -->
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-bar-chart-line me-2 text-primary"></i>Doanh Thu Tổng Các Gói Theo Tháng (@DateTime.Now.Year)</h6>
                </div>
                <div class="card-body">
                    <canvas id="revenueChart" style="max-height: 300px;"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h6 class="fw-bold text-dark mb-0"><i class="bi bi-clock-history me-2 text-primary"></i>Giao Dịch Gần Đây</h6>
                    <a href="/Admin/Users" class="btn btn-sm btn-outline-primary">Xem tất cả</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 small">
                            <thead class="table-light">
                                <tr>
                                    <th>Người dùng</th>
                                    <th>Gói VIP</th>
                                    <th>Số tiền</th>
                                    <th>Ngày</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.RecentPayments != null && Model.RecentPayments.Any())
                                {
                                    @foreach (var item in Model.RecentPayments)
                                    {
                                        <tr>
                                            <td class="fw-bold">@item.UserName</td>
                                            <td><span class="badge bg-info text-dark">@item.PackageName</span></td>
                                            <td class="text-success fw-bold">@item.Amount.ToString("N0") đ</td>
                                            <td class="text-muted">@item.PaymentDate.ToString("dd/MM/yyyy")</td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="4" class="text-center text-muted py-3">Chưa có giao dịch nào phát sinh.</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- SCRIPT VẼ BIỂU ĐỒ BẰNG CHART.JS -->
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const ctx = document.getElementById('revenueChart').getContext('2d');
        const monthlyRevenueData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MonthlyRevenue));

        new Chart(ctx, {
            type: 'bar',
            data: {
                labels: ['Thg 1', 'Thg 2', 'Thg 3', 'Thg 4', 'Thg 5', 'Thg 6', 'Thg 7', 'Thg 8', 'Thg 9', 'Thg 10', 'Thg 11', 'Thg 12'],
                datasets: [{
                    label: 'Doanh thu (VNĐ)',
                    data: monthlyRevenueData,
                    backgroundColor: 'rgba(13, 110, 253, 0.75)',
                    borderColor: '#0d6efd',
                    borderWidth: 1,
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            callback: function(value) {
                                return value.toLocaleString('vi-VN') + ' đ';
                            }
                        }
                    }
                }
            }
        });
    });
</script>