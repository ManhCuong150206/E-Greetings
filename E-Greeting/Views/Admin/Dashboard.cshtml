@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="container-fluid my-4">
    <h3 class="fw-bold mb-4"><i class="bi bi-speedometer2 text-primary me-2"></i> Dashboard Quản Trị Hệ Thống</h3>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card bg-primary text-white p-3 shadow-sm rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase small mb-1">Tổng Template Thiệp</h6>
                        <h2 class="fw-bold mb-0">@ViewBag.TotalTemplates</h2>
                    </div>
                    <i class="bi bi-card-image display-5"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-success text-white p-3 shadow-sm rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase small mb-1">Danh Mục Thiệp</h6>
                        <h2 class="fw-bold mb-0">@ViewBag.TotalCategories</h2>
                    </div>
                    <i class="bi bi-folder-check display-5"></i>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card bg-info text-white p-3 shadow-sm rounded-3">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="text-uppercase small mb-1">Thành Viên (Users)</h6>
                        <h2 class="fw-bold mb-0">@ViewBag.TotalUsers</h2>
                    </div>
                    <i class="bi bi-people-fill display-5"></i>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm p-4">
        <h5 class="fw-bold mb-3"><i class="bi bi-rocket-takeoff text-success me-2"></i> Lối Tắt Quản Lý</h5>
        <div class="d-flex gap-2">
            <a asp-action="Categories" class="btn btn-outline-primary">
                <i class="bi bi-folder me-1"></i> Quản Lý Danh Mục
            </a>
        </div>
    </div>
</div>