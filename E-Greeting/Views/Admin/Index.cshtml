@model IEnumerable<E_Greeting.Models.Category>

@{
    ViewData["Title"] = "Quản lý Danh mục & Template";
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-folder-fill text-primary"></i> Quản lý Danh mục & Template</h2>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Form Thêm mới danh mục -->
    <div class="card shadow-sm my-3 p-3 rounded-3">
        <h5 class="fw-bold"><i class="bi bi-plus-circle me-1"></i> Thêm Danh mục Mới</h5>
        <form asp-action="Create" method="post" class="row g-2 align-items-center mt-1">
            <div class="col-md-5">
                <input type="text" name="Name" class="form-control" placeholder="Nhập tên danh mục..." required />
            </div>
            <div class="col-auto">
                <button type="submit" class="btn btn-primary fw-semibold">
                    <i class="bi bi-save me-1"></i> Thêm mới
                </button>
            </div>
        </form>
    </div>

    <!-- Bảng hiển thị danh sách Category -->
    <div class="card shadow-sm rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th width="80">ID</th>
                        <th>Tên Danh Mục</th>
                        <th>Danh sách Template trực thuộc</th>
                        <th width="200" class="text-center">Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold">#@item.Id</td>
                            <td class="fw-semibold">@item.Name</td>

                            <!-- Danh sách Template trực thuộc -->
                            <td>
                                @if (item.Templates != null && item.Templates.Any())
                                {
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var tpl in item.Templates)
                                        {
                                            <span class="badge bg-info text-dark p-2">
                                                <i class="bi bi-card-image me-1"></i>Template #@tpl.Id
                                            </span>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted small">Chưa có mẫu thiệp nào</span>
                                }
                            </td>

                            <!-- Cột Thao tác CRUD -->
                            <td class="text-center">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning me-1 fw-semibold">
                                    <i class="bi bi-pencil-square"></i> Sửa
                                </a>
                                <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="d-inline" onsubmit="return confirm('Bạn có chắc muốn xóa danh mục này?');">
                                    <button type="submit" class="btn btn-sm btn-danger fw-semibold">
                                        <i class="bi bi-trash"></i> Xóa
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>