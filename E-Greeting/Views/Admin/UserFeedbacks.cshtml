@model IEnumerable<E_Greeting.Models.Feedback>

@{
    ViewData["Title"] = "Danh sách Feedback của " + ViewBag.AccountName;
    int stt = 1;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4>
            <i class="bi bi-chat-left-text-fill text-primary me-2"></i>Danh sách Góp ý của User:
            <span class="text-primary fw-bold">@ViewBag.AccountName</span>
            <small class="text-muted fs-6">(@ViewBag.AccountEmail)</small>
        </h4>
        <a asp-controller="AdminFeedback" asp-action="Feedbacks" class="btn btn-outline-secondary rounded-pill fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Quay lại Danh sách User
        </a>
    </div>

    <!-- BẢNG DANH SÁCH FEEDBACK CHI TIẾT CỦA USER (GỌN GÀNG 3 CỘT) -->
    <div class="card shadow-sm rounded-3 mt-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th width="70" class="text-center">STT</th>
                        <th width="220">Thời gian gửi</th>
                        <th>Nội dung gửi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var props = item.GetType().GetProperties();
                            string contentVal = props.FirstOrDefault(p => p.Name.Equals("Content", StringComparison.OrdinalIgnoreCase))?.GetValue(item)?.ToString() ?? "";
                            DateTime? createdAt = props.FirstOrDefault(p => p.Name.Equals("CreatedAt", StringComparison.OrdinalIgnoreCase))?.GetValue(item) as DateTime?;

                            <tr>
                                <td class="text-center fw-bold">@(stt++)</td>
                                <td>
                                    <span class="fw-semibold text-dark">
                                        <i class="bi bi-clock me-1 text-muted"></i>
                                        @(createdAt.HasValue ? createdAt.Value.ToString("dd/MM/yyyy HH:mm") : "N/A")
                                    </span>
                                </td>
                                <td>
                                    <div class="p-2 bg-light border rounded text-dark">
                                        <i class="bi bi-quote me-1 text-primary fs-5"></i>@contentVal
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="3" class="text-center py-4 text-muted">User này chưa gửi đóng góp / phản hồi nào.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PHÂN TRANG -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-center py-2">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-controller="AdminFeedback" asp-action="UserFeedbacks" asp-route-accountId="@ViewBag.AccountId" asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>