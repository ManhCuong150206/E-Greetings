@model IEnumerable<E_Greeting.Models.SentCard>

@{
    ViewData["Title"] = "Sent Cards History - " + ViewBag.AccountName;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold mb-0">
            <i class="bi bi-envelope-paper-fill me-2"></i>Card Sending History from User:
            <span>@ViewBag.AccountName</span>
            <small class="text-muted fs-6">(@ViewBag.AccountEmail)</small>
        </h2>
        <a asp-controller="AdminSentHistory" asp-action="SentLogs" class="btn btn-outline-secondary rounded-pill fw-semibold">
            <i class="bi bi-arrow-left me-1"></i> Back to Users List
        </a>
    </div>

    <!-- DETAILED SENT CARDS TABLE -->
    <div class="card shadow-sm rounded-3 mt-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th width="70" class="text-center">No.</th>
                        <th>Used Card Template</th>
                        <th>Recipient Email</th>
                        <th>Sent Time / Schedule</th>
                        <th class="text-center">Opened Time</th>
                        <th>Recipient RSVP Reply</th>
                        <th class="text-center" width="130">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var props = item.GetType().GetProperties();
                            string recipientEmail = props.FirstOrDefault(p => p.Name.Equals("RecipientEmail", StringComparison.OrdinalIgnoreCase))?.GetValue(item)?.ToString() ?? "N/A";
                            string subjectVal = props.FirstOrDefault(p => p.Name.Equals("Subject", StringComparison.OrdinalIgnoreCase))?.GetValue(item)?.ToString() ?? "";
                            string rawMessage = props.FirstOrDefault(p => p.Name.Equals("Message", StringComparison.OrdinalIgnoreCase))?.GetValue(item)?.ToString() ?? "";
                            string imagePath = props.FirstOrDefault(p => p.Name.Equals("ImagePath", StringComparison.OrdinalIgnoreCase))?.GetValue(item)?.ToString() ?? item.Template?.ImagePath ?? "";
                            string audioPath = props.FirstOrDefault(p => p.Name.Equals("AudioPath", StringComparison.OrdinalIgnoreCase))?.GetValue(item)?.ToString() ?? "";
                            string rawReply = props.FirstOrDefault(p => p.Name.Equals("RecipientReply", StringComparison.OrdinalIgnoreCase))?.GetValue(item)?.ToString() ?? "";

                            DateTime? sentAt = props.FirstOrDefault(p => p.Name.Equals("SentAt", StringComparison.OrdinalIgnoreCase))?.GetValue(item) as DateTime?;
                            DateTime? scheduledAt = props.FirstOrDefault(p => p.Name.Equals("ScheduledAt", StringComparison.OrdinalIgnoreCase))?.GetValue(item) as DateTime?;
                            DateTime? openAt = props.FirstOrDefault(p => p.Name.Equals("OpenAt", StringComparison.OrdinalIgnoreCase))?.GetValue(item) as DateTime?;

                            bool isVip = item.Template != null && !item.Template.IsFree;

                            // PARSE RECIPIENT RSVP REPLY JSON
                            string replyStatus = "";
                            string replyText = "";
                            if (!string.IsNullOrWhiteSpace(rawReply))
                            {
                                try
                                {
                                    using var replyDoc = System.Text.Json.JsonDocument.Parse(rawReply);
                                    var root = replyDoc.RootElement;
                                    if (root.TryGetProperty("Status", out var statusProp))
                                    {
                                        replyStatus = statusProp.GetString() ?? "";
                                    }
                                    else if (root.TryGetProperty("status", out var statusProp2))
                                    {
                                        replyStatus = statusProp2.GetString() ?? "";
                                    }

                                    if (root.TryGetProperty("Text", out var textProp))
                                    {
                                        replyText = textProp.GetString() ?? "";
                                    }
                                    else if (root.TryGetProperty("text", out var textProp2))
                                    {
                                        replyText = textProp2.GetString() ?? "";
                                    }
                                }
                                catch
                                {
                                    replyStatus = rawReply;
                                }
                            }

                            <tr>
                                <td class="text-center fw-bold">@item.Id</td>
                                <td>
                                    <span class="badge @(isVip ? "bg-warning text-dark" : "bg-info text-dark") fs-6 shadow-sm">
                                        <i class="bi @(isVip ? "bi-star-fill" : "bi-card-image") me-1"></i>
                                        @(item.Template?.Name ?? "Card Template") @(isVip ? "(VIP)" : "(Free)")
                                    </span>
                                </td>
                                <td class="fw-semibold text-primary">@recipientEmail</td>
                                <td>
                                    @if (scheduledAt.HasValue)
                                    {
                                        <div><span class="badge text-white mb-1" style="background-color: #6f42c1;"><i class="bi bi-clock me-1"></i>Scheduled</span></div>
                                        <small class="fw-semibold text-dark">@scheduledAt.Value.ToString("dd/MM/yyyy HH:mm")</small>
                                    }
                                    else if (sentAt.HasValue)
                                    {
                                        <span class="fw-semibold text-dark">@sentAt.Value.ToString("dd/MM/yyyy HH:mm")</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">Pending...</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (openAt.HasValue)
                                    {
                                        <span class="badge bg-info text-dark border px-2 py-1">
                                            <i class="bi bi-envelope-open me-1"></i>@openAt.Value.ToString("dd/MM/yyyy HH:mm")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary opacity-75">Unopened</span>
                                    }
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(replyStatus) || !string.IsNullOrWhiteSpace(replyText))
                                    {
                                        <div class="d-flex flex-column align-items-start gap-1">
                                            @if (!string.IsNullOrWhiteSpace(replyStatus))
                                            {
                                                if (replyStatus.Contains("Sẽ tham dự", StringComparison.OrdinalIgnoreCase) || replyStatus.Contains("Attending", StringComparison.OrdinalIgnoreCase) || (replyStatus.Contains("tham dự", StringComparison.OrdinalIgnoreCase) && !replyStatus.Contains("Không", StringComparison.OrdinalIgnoreCase)))
                                                {
                                                    <span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Will Attend</span>
                                                }
                                                else if (replyStatus.Contains("Phân vân", StringComparison.OrdinalIgnoreCase) || replyStatus.Contains("Maybe", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge bg-warning text-dark"><i class="bi bi-question-circle-fill me-1"></i>Undecided</span>
                                                }
                                                else if (replyStatus.Contains("Không", StringComparison.OrdinalIgnoreCase) || replyStatus.Contains("Decline", StringComparison.OrdinalIgnoreCase) || replyStatus.Contains("Cannot", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <span class="badge bg-danger"><i class="bi bi-x-circle-fill me-1"></i>Cannot Attend</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-primary">@replyStatus</span>
                                                }
                                            }

                                            @if (!string.IsNullOrWhiteSpace(replyText))
                                            {
                                                <div class="p-1 px-2 bg-light border rounded text-dark small w-100" style="max-width: 200px;">
                                                    <i class="bi bi-chat-quote-fill text-primary me-1"></i>"@replyText"
                                                </div>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted fst-italic">No reply yet</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn btn-sm btn-primary fw-semibold rounded-pill parse-json-btn"
                                            data-bs-toggle="modal"
                                            data-bs-target="#modalCard-@item.Id"
                                            data-raw="@rawMessage"
                                            data-email="@recipientEmail"
                                            data-subject="@subjectVal"
                                            data-img="@imagePath"
                                            data-audio="@audioPath">
                                        <i class="bi bi-eye me-1"></i> View
                                    </button>

                                    <!-- MODAL FOR DETAILED CARD INFORMATION -->
                                    <div class="modal fade" id="modalCard-@item.Id" tabindex="-1" aria-hidden="true">
                                        <div class="modal-dialog modal-lg modal-dialog-centered">
                                            <div class="modal-content text-start">
                                                <div class="modal-header bg-primary text-white py-2">
                                                    <h5 class="modal-title fs-6 fw-bold">
                                                        <i class="bi bi-file-earmark-text me-2"></i>Detailed Card Attachment Information No.@item.Id
                                                    </h5>
                                                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                                                </div>
                                                <div class="modal-body p-4">
                                                    <!-- 1. CARD COVER IMAGE -->
                                                    @if (!string.IsNullOrWhiteSpace(imagePath))
                                                    {
                                                        <div class="text-center mb-3">
                                                            <label class="fw-bold text-muted d-block mb-2"><i class="bi bi-image me-1"></i>Selected Card Cover Image:</label>
                                                            <img src="@imagePath" class="img-fluid rounded shadow-sm border" style="max-height: 250px; object-fit: contain;" alt="Card cover image" />
                                                        </div>
                                                    }

                                                    <!-- 2. ATTACHED BACKGROUND MUSIC (AUDIO_PATH) -->
                                                    @if (!string.IsNullOrWhiteSpace(audioPath))
                                                    {
                                                        <div class="card p-3 mb-3 border-0 bg-light rounded-3 shadow-sm">
                                                            <h6 class="fw-bold text-primary mb-2">
                                                                <i class="bi bi-music-note-beamed me-1"></i>Attached Background Music:
                                                            </h6>
                                                            <audio controls class="w-100">
                                                                <source src="@audioPath" type="audio/mpeg">
                                                                Your browser does not support the audio tag.
                                                            </audio>
                                                        </div>
                                                    }

                                                    <!-- 3. DETAILED EVENT FORM DETAILS -->
                                                    <div class="border rounded-3 p-3 bg-light shadow-sm">
                                                        <h6 class="fw-bold text-primary mb-3">
                                                            <i class="bi bi-journal-text me-1"></i>Card Event & Recipient Information:
                                                        </h6>
                                                        <div class="row g-3">
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-bold small text-dark">Recipient Name (*):</label>
                                                                <input type="text" class="form-control form-control-sm bg-white modal-field-name" readonly />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-bold small text-dark">Event Time (*):</label>
                                                                <input type="text" class="form-control form-control-sm bg-white modal-field-time" readonly />
                                                            </div>
                                                            <div class="col-12">
                                                                <label class="form-label fw-bold small text-dark">Event Location / Venue Address (*):</label>
                                                                <input type="text" class="form-control form-control-sm bg-white modal-field-address" readonly />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-bold small text-dark">Recipient Email (*):</label>
                                                                <input type="text" class="form-control form-control-sm bg-white modal-field-email" value="@recipientEmail" readonly />
                                                            </div>
                                                            <div class="col-md-6">
                                                                <label class="form-label fw-bold small text-dark">Email Subject:</label>
                                                                <input type="text" class="form-control form-control-sm bg-white modal-field-subject" value="@subjectVal" readonly />
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="modal-footer py-2">
                                                    <button type="button" class="btn btn-sm btn-secondary fw-semibold" data-bs-dismiss="modal">Close</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center py-4 text-muted">This user has not sent any e-cards yet.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-center py-2">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-controller="AdminSentHistory" asp-action="UserSentCards" asp-route-accountId="@ViewBag.AccountId" asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.parse-json-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const rawData = this.getAttribute('data-raw');
                const targetModal = document.querySelector(this.getAttribute('data-bs-target'));

                const inputName = targetModal.querySelector('.modal-field-name');
                const inputTime = targetModal.querySelector('.modal-field-time');
                const inputAddress = targetModal.querySelector('.modal-field-address');

                let rName = "N/A", rTime = "N/A", rAddr = "N/A";

                if (rawData && rawData.trim() !== '') {
                    try {
                        const jsonObj = JSON.parse(rawData);
                        rName = jsonObj.recipientName || jsonObj.Name || jsonObj.name || "N/A";
                        rAddr = jsonObj.eventAddress || jsonObj.Address || jsonObj.address || "N/A";

                        let timeVal = jsonObj.eventTime || jsonObj.Time || jsonObj.time;
                        if (timeVal) {
                            try { rTime = new Date(timeVal).toLocaleString('en-US'); } catch (e) { rTime = timeVal; }
                        }
                    } catch (e) {
                        rName = rawData;
                    }
                }

                inputName.value = rName;
                inputTime.value = rTime;
                inputAddress.value = rAddr;
            });
        });
    </script>
}