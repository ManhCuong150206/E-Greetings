@model IEnumerable<E_Greeting.Models.Account>

@{
    ViewData["Title"] = "System Feedback & Feedback Management";
    var feedbackCounts = ViewBag.FeedbackCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold"><i class="bi bi-chat-left-text-fill me-2"></i>System Feedback & Review Management</h2>
    </div>

    <!-- USER SEARCH BAR WITH AUTO-SUBMIT -->
    <div class="card shadow-sm p-3 mb-4 rounded-3 bg-light">
        <form id="feedbackSearchForm" asp-controller="AdminFeedback" asp-action="Feedbacks" method="get" class="row g-2 align-items-center">
            <div class="col-md-11">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" id="searchFeedbackInput" name="search" value="@ViewBag.Search" class="form-control" placeholder="Enter sender name or email address..." />
                </div>
            </div>
            <div class="col-md-1">
                <a asp-controller="AdminFeedback" asp-action="Feedbacks" class="btn btn-outline-secondary w-100" title="Reset search">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- USERS WITH FEEDBACK LIST TABLE -->
    <div class="card shadow-sm rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th width="80" class="text-center">No.</th>
                        <th>User Name</th>
                        <th>Email</th>
                        <th class="text-center" width="240">Total Feedbacks</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            int count = feedbackCounts.ContainsKey(user.Id) ? feedbackCounts[user.Id] : 0;
                            <tr>
                                <td class="text-center fw-bold">@user.Id</td>
                                <td class="fw-semibold text-dark">@user.Name</td>
                                <td>@user.Email</td>
                                <td class="text-center">
                                    <a asp-controller="AdminFeedback" asp-action="UserFeedbacks" asp-route-accountId="@user.Id" class="btn btn-info text-dark rounded-pill fw-bold shadow-sm px-3 py-1">
                                        <i class="bi bi-chat-quote-fill me-1"></i> @count Feedback@(count > 1 ? "s" : "")
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No feedbacks or reviews recorded yet from users.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-center py-2">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-controller="AdminFeedback" asp-action="Feedbacks" asp-route-search="@ViewBag.Search" asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>

<!-- FLOATING CENTER NOTIFICATION POPUP (GLOBAL DESIGN) -->
@if (TempData["SuccessMessage"] != null || TempData["ErrorMessage"] != null)
{
    <div class="modal fade" id="globalFeedbackAlertModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
            <div class="modal-content text-center p-4 rounded-4 shadow border-0">
                <div class="modal-body p-0">
                    <div class="mb-3">
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="mx-auto rounded-circle bg-success-subtle d-flex align-items-center justify-content-center" style="width: 75px; height: 75px;">
                                <i class="bi bi-check-circle-fill text-success display-4"></i>
                            </div>
                        }
                        else
                        {
                            <div class="mx-auto rounded-circle bg-danger-subtle d-flex align-items-center justify-content-center" style="width: 75px; height: 75px;">
                                <i class="bi bi-exclamation-triangle-fill text-danger display-4"></i>
                            </div>
                        }
                    </div>
                    <h4 class="fw-bold mb-2">@(TempData["SuccessMessage"] != null ? "Success!" : "Notice")</h4>
                    <p class="text-secondary small mb-4">
                        @(TempData["SuccessMessage"] ?? TempData["ErrorMessage"])
                    </p>
                    <button type="button" class="btn @(TempData["SuccessMessage"] != null ? "btn-success" : "btn-danger") fw-semibold px-5 py-2" data-bs-dismiss="modal">
                        OK
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // SHOW POPUP MODAL AUTOMATICALLY IF TEMP DATA EXISTS
            const alertModalEl = document.getElementById('globalFeedbackAlertModal');
            if (alertModalEl) {
                const alertModal = new bootstrap.Modal(alertModalEl);
                alertModal.show();
            }

            // AUTO-SUBMIT SEARCH FORM WITH DEBOUNCE
            const searchInput = document.getElementById('searchFeedbackInput');
            const searchForm = document.getElementById('feedbackSearchForm');
            if (searchInput && searchForm) {
                let timer;
                searchInput.addEventListener('input', function () {
                    clearTimeout(timer);
                    timer = setTimeout(() => {
                        searchForm.submit();
                    }, 400);
                });
            }
        });
    </script>
}