@model IEnumerable<E_Greeting.Models.Account>

@{
    ViewData["Title"] = "Quản lý Phản hồi & Góp ý";
    var feedbackCounts = ViewBag.FeedbackCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
    int stt = 1;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-chat-left-text-fill text-primary me-2"></i>Quản lý Phản hồi & Góp ý Hệ thống</h2>
    </div>

    <!-- THANH TÌM KIẾM USER -->
    <div class="card shadow-sm p-3 mb-4 rounded-3 bg-light">
        <form asp-controller="AdminFeedback" asp-action="Feedbacks" method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Nhập tên hoặc email người gửi góp ý..." />
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary fw-semibold w-100">
                    <i class="bi bi-filter me-1"></i> Tìm kiếm User
                </button>
            </div>
        </form>
    </div>

    <!-- BẢNG DANH SÁCH USERS CÓ FEEDBACK -->
    <div class="card shadow-sm rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th width="70" class="text-center">STT</th>
                        <th>Tên người dùng</th>
                        <th>Email</th>
                        <th class="text-center" width="240">Tổng số Feedback</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            int count = feedbackCounts.ContainsKey(user.Id) ? feedbackCounts[user.Id] : 0;
                            <tr>
                                <td class="text-center fw-bold">@(stt++)</td>
                                <td class="fw-semibold">@user.Name</td>
                                <td>@user.Email</td>
                                <td class="text-center">
                                    <a asp-controller="AdminFeedback" asp-action="UserFeedbacks" asp-route-accountId="@user.Id" class="btn btn-info text-dark rounded-pill fw-bold shadow-sm px-3 py-1">
                                        <i class="bi bi-chat-quote-fill me-1"></i> @count Feedback
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Chưa có góp ý / phản hồi nào từ phía người dùng.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PHÂN TRANG -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-center py-2">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-controller="AdminFeedback" asp-action="Feedbacks" asp-route-search="@ViewBag.Search" asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>