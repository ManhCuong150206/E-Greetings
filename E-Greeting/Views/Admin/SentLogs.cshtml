@model IEnumerable<E_Greeting.Models.Account>

@{
    ViewData["Title"] = "Card Sending History Logs";
    var sentCounts = ViewBag.SentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="text-primary fw-bold"><i class="bi bi-clock-history text-primary me-2"></i>Card Sending History Logs</h2>
    </div>

    <!-- USER SEARCH BAR -->
    <div class="card shadow-sm p-3 mb-4 rounded-3 bg-light">
        <form asp-controller="AdminSentHistory" asp-action="SentLogs" method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Enter sender name or email address..." />
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary fw-semibold w-100">
                    <i class="bi bi-filter me-1"></i> Search User
                </button>
            </div>
        </form>
    </div>

    <!-- USERS LIST TABLE WITH SENT CARDS -->
    <div class="card shadow-sm rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th width="70" class="text-center">No.</th>
                        <th>User Name</th>
                        <th>Email</th>
                        <th class="text-center" width="240">Total Sent Cards</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            int count = sentCounts.ContainsKey(user.Id) ? sentCounts[user.Id] : 0;
                            <tr>
                                <td class="text-center fw-bold">@user.Id</td>
                                <td class="fw-semibold text-dark">@user.Name</td>
                                <td>@user.Email</td>
                                <td class="text-center">
                                    <a asp-controller="AdminSentHistory" asp-action="UserSentCards" asp-route-accountId="@user.Id" class="btn btn-info text-dark rounded-pill fw-bold shadow-sm px-3 py-1">
                                        <i class="bi bi-envelope-paper-fill me-1"></i> @count Card@(count > 1 ? "s" : "") Sent
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">No card sending logs recorded yet from users.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PAGINATION -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-center py-2">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-controller="AdminSentHistory" asp-action="SentLogs" asp-route-search="@ViewBag.Search" asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>