@model IEnumerable<E_Greeting.Models.Account>

@{
    ViewData["Title"] = "Thống kê Lịch sử Gửi Thiệp theo User";
    var sentCounts = ViewBag.SentCounts as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2><i class="bi bi-clock-history text-primary me-2"></i>Quản lý Lịch sử Gửi Thiệp theo Tài Khoản</h2>
    </div>

    <!-- THANH TÌM KIẾM USER -->
    <div class="card shadow-sm p-3 mb-4 rounded-3 bg-light">
        <form asp-controller="AdminSentHistory" asp-action="SentLogs" method="get" class="row g-2 align-items-center">
            <div class="col-md-9">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@ViewBag.Search" class="form-control" placeholder="Nhập tên hoặc email tài khoản người gửi..." />
                </div>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-primary fw-semibold w-100">
                    <i class="bi bi-filter me-1"></i> Tìm kiếm User
                </button>
            </div>
        </form>
    </div>

    <!-- BẢNG DANH SÁCH 4 CỘT -->
    <div class="card shadow-sm rounded-3">
        <div class="card-body p-0">
            <table class="table table-hover table-striped align-middle mb-0">
                <thead class="table-dark">
                    <tr>
                        <th width="100">User ID</th>
                        <th>Họ & Tên Người Gửi</th>
                        <th>Email Tài Khoản</th>
                        <th class="text-center" width="220">Tổng Số Thiệp Đã Gửi</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var user in Model)
                        {
                            int count = sentCounts.ContainsKey(user.Id) ? sentCounts[user.Id] : 0;
                            <tr>
                                <td class="fw-bold">#@user.Id</td>
                                <td class="fw-semibold">@user.Name</td>
                                <td>@user.Email</td>
                                <td class="text-center">
                                    <!-- BADGE TỔNG SỐ THIỆP ĐÃ ĐƯỢC GẮN ĐƯỜNG DẪN DẠNG NÚT BẤM -->
                                    <a asp-controller="AdminSentHistory" asp-action="UserSentCards" asp-route-accountId="@user.Id" class="btn btn-info text-dark rounded-pill fw-bold shadow-sm px-3 py-1">
                                        <i class="bi bi-envelope-paper-fill me-1"></i> @count Thiệp
                                    </a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">Chưa có tài khoản nào thực hiện gửi thiệp.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- PHÂN TRANG -->
        @if (ViewBag.TotalPages > 1)
        {
            <div class="card-footer bg-white d-flex justify-content-center py-2">
                <nav>
                    <ul class="pagination pagination-sm mb-0">
                        @for (int i = 1; i <= ViewBag.TotalPages; i++)
                        {
                            <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                                <a class="page-link" asp-controller="AdminSentHistory" asp-action="SentLogs" asp-route-search="@ViewBag.Search" asp-route-page="@i">@i</a>
                            </li>
                        }
                    </ul>
                </nav>
            </div>
        }
    </div>
</div>