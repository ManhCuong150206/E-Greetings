@model IEnumerable<E_Greeting.Models.Template>

@{
    ViewData["Title"] = "Danh sách Template - " + ViewBag.CategoryName;
}

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4><i class="bi bi-images text-primary"></i> Quản lý Template thuộc Danh mục: <span class="text-primary">@ViewBag.CategoryName</span></h4>
        <div>
            <a asp-controller="AdminCategory" asp-action="Categories" class="btn btn-outline-secondary me-2 rounded-pill">
                <i class="bi bi-arrow-left"></i> Quay lại Category
            </a>
            <a asp-controller="AdminTemplate" asp-action="CreateTemplate" asp-route-categoryId="@ViewBag.CategoryId" class="btn btn-success rounded-pill fw-semibold">
                <i class="bi bi-plus-lg me-1"></i> Thêm Template Mới (Canvas Editor)
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- FORM LỌC ĐA NĂNG (SEARCH & FILTER) -->
    <div class="card shadow-sm p-3 mb-3 bg-light rounded-3">
        <form asp-controller="AdminTemplate" asp-action="Templates" method="get" class="row g-2 align-items-center">
            <input type="hidden" name="categoryId" value="@ViewBag.CategoryId" />

            <div class="col-md-4">
                <input type="text" name="searchName" value="@ViewBag.SearchName" class="form-control form-control-sm" placeholder="Tìm theo tên template..." />
            </div>

            <div class="col-md-3">
                <select name="isFree" class="form-select form-select-sm">
                    <option value="">-- Tất cả gói (Free & VIP) --</option>
                    <option value="true" selected="@(ViewBag.IsFree == "true")">Chỉ Miễn Phí (Free)</option>
                    <option value="false" selected="@(ViewBag.IsFree == "false")">Chỉ Trả Phí (VIP)</option>
                </select>
            </div>

            <div class="col-md-3">
                <select name="isActive" class="form-select form-select-sm">
                    <option value="">-- Tất cả trạng thái --</option>
                    <option value="true" selected="@(ViewBag.IsActive == "true")">Đang Hiển Thị</option>
                    <option value="false" selected="@(ViewBag.IsActive == "false")">Đã Ẩn</option>
                </select>
            </div>

            <div class="col-md-2 d-flex gap-1">
                <button type="submit" class="btn btn-sm btn-primary flex-fill fw-semibold">
                    <i class="bi bi-filter me-1"></i> Lọc
                </button>
                <a asp-controller="AdminTemplate" asp-action="Templates" asp-route-categoryId="@ViewBag.CategoryId" class="btn btn-sm btn-outline-secondary" title="Xóa bộ lọc">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>

    <!-- DANH SÁCH TEMPLATES -->
    <div class="row g-3">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                string displayThumb = item.ImagePath;
                if (!string.IsNullOrWhiteSpace(item.ConfigData))
                {
                    try
                    {
                        using var doc = System.Text.Json.JsonDocument.Parse(item.ConfigData);
                        if (doc.RootElement.TryGetProperty("preview_thumbnail", out var thumbProp))
                        {
                            string? jsonThumb = thumbProp.GetString();
                            if (!string.IsNullOrWhiteSpace(jsonThumb)) displayThumb = jsonThumb;
                        }
                    }
                    catch { }
                }

                <div class="col-md-3">
                    <div class="card h-100 shadow-sm border-0 d-flex flex-column justify-content-between @(!item.IsActive ? "opacity-75 bg-light" : "")" id="card-template-@item.Id">
                        <div>
                            <div class="position-relative">
                                <img src="@displayThumb" class="card-img-top" style="height: 200px; object-fit: cover;" alt="@item.Name">
                                <span class="position-absolute top-0 end-0 badge m-2 status-badge-@item.Id @(item.IsActive ? "bg-success" : "bg-secondary")">
                                    @(item.IsActive ? "Đang Hiển Thị" : "Đã Ẩn")
                                </span>
                            </div>
                            <div class="card-body">
                                <h6 class="card-title fw-bold text-truncate">@item.Name</h6>
                                <span class="badge @(item.IsFree ? "bg-info text-dark" : "bg-warning text-dark")">
                                    @(item.IsFree ? "Miễn Phí (Free)" : "Trả Phí (VIP)")
                                </span>
                            </div>
                        </div>

                        <!-- FOOTER VỚI CÔNG TẮC SWITCH AJAX TOGGLE -->
                        <div class="card-footer bg-white border-top-0 d-flex justify-content-between align-items-center p-2">
                            <a asp-controller="AdminTemplate" asp-action="EditTemplate" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning fw-semibold">
                                <i class="bi bi-pencil-square"></i> Sửa
                            </a>

                            <div class="form-check form-switch m-0" title="Gạt công tắc để Bật/Tắt hiển thị">
                                <input class="form-check-input switch-toggle-status" type="checkbox" role="switch" data-id="@item.Id" @(item.IsActive ? "checked" : "") style="cursor: pointer;">
                                <label class="form-check-small fw-semibold small text-muted ms-1 switch-label-@item.Id">
                                    @(item.IsActive ? "Hiện" : "Ẩn")
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5 text-muted">
                <i class="bi bi-folder-x fs-1"></i>
                <p class="mt-2">Không tìm thấy mẫu thiệp nào phù hợp với bộ lọc.</p>
            </div>
        }
    </div>

    <!-- PHÂN TRANG TEMPLATE -->
    @if (ViewBag.TotalPages > 1)
    {
        <div class="d-flex justify-content-center mt-4">
            <nav>
                <ul class="pagination">
                    @for (int i = 1; i <= ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-controller="AdminTemplate" asp-action="Templates"
                               asp-route-categoryId="@ViewBag.CategoryId"
                               asp-route-searchName="@ViewBag.SearchName"
                               asp-route-isFree="@ViewBag.IsFree"
                               asp-route-isActive="@ViewBag.IsActive"
                               asp-route-page="@i">@i</a>
                        </li>
                    }
                </ul>
            </nav>
        </div>
    }
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.switch-toggle-status').forEach(el => {
            el.addEventListener('change', function() {
                const templateId = this.getAttribute('data-id');
                const isChecked = this.checked;

                fetch('/Admin/ToggleTemplateStatusAjax?id=' + templateId, {
                    method: 'POST'
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            const badge = document.querySelector('.status-badge-' + templateId);
                            const label = document.querySelector('.switch-label-' + templateId);
                            const card = document.getElementById('card-template-' + templateId);

                            if (data.isActive) {
                                badge.className = 'position-absolute top-0 end-0 badge m-2 status-badge-' + templateId + ' bg-success';
                                badge.innerText = 'Đang Hiển Thị';
                                label.innerText = 'Hiện';
                                card.classList.remove('opacity-75', 'bg-light');
                            } else {
                                badge.className = 'position-absolute top-0 end-0 badge m-2 status-badge-' + templateId + ' bg-secondary';
                                badge.innerText = 'Đã Ẩn';
                                label.innerText = 'Ẩn';
                                card.classList.add('opacity-75', 'bg-light');
                            }
                        } else {
                            alert('Lỗi: ' + data.message);
                            this.checked = !isChecked;
                        }
                    })
                    .catch(() => {
                        alert('Không thể kết nối đến Server!');
                        this.checked = !isChecked;
                    });
            });
        });
    </script>
}