@model E_Greeting.Models.SentCard
@using System.Text.Json;

@{
    ViewData["Title"] = "Thiệp Chúc Mừng Dành Cho Bạn";

    // 1. TRÍCH XUẤT DỮ LIỆU FORM THÔ TỪ MODEL.MESSAGE AN TOÀN
    string recipientName = "";
    string eventTime = "";
    string eventAddress = "";

    if (!string.IsNullOrWhiteSpace(Model?.Message))
    {
        try
        {
            string jsonString = Model.Message;
            if (jsonString.StartsWith("\"") && jsonString.EndsWith("\""))
            {
                jsonString = JsonSerializer.Deserialize<string>(jsonString) ?? jsonString;
            }

            using var doc = JsonDocument.Parse(jsonString);
            var root = doc.RootElement;

            recipientName = root.TryGetProperty("recipientName", out var r) ? r.GetString() ?? "" : "";

            string rawTime = root.TryGetProperty("eventTime", out var t) ? t.GetString() ?? "" : "";
            if (DateTime.TryParse(rawTime, out DateTime parsedDate))
            {
                eventTime = parsedDate.ToString("HH:mm - dd/MM/yyyy");
            }
            else
            {
                eventTime = rawTime;
            }

            eventAddress = root.TryGetProperty("eventAddress", out var a) ? a.GetString() ?? "" : "";
        }
        catch
        {
            recipientName = Model.Message;
        }
    }

    // 2. LẤY ĐƯỜNG DẪN ẢNH MẶT THIỆP ĐÃ GỘP SẠCH SẼ TỪ CSDL
    string mergedCardImgPath = Model?.ImagePath ?? "";
    if (string.IsNullOrEmpty(mergedCardImgPath) && Model?.Template != null)
    {
        mergedCardImgPath = Model.Template.ImagePath ?? "";
    }

    mergedCardImgPath = mergedCardImgPath.Replace("url('", "").Replace("')", "").Replace("url(\"", "").Replace("\")", "").Replace("url(", "").Trim();
    if (!string.IsNullOrEmpty(mergedCardImgPath) && !mergedCardImgPath.StartsWith("http") && !mergedCardImgPath.StartsWith("/"))
    {
        mergedCardImgPath = "/" + mergedCardImgPath;
    }
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- 1. BỨC ẢNH MẶT THIỆP HOÀN CHỈNH ĐÃ MERGE -->
            <div class="card shadow-lg mb-4 rounded-3 border-0">
                <div class="card-header bg-gradient bg-primary text-white text-center py-3">
                    <h4 class="fw-bold mb-0"><i class="bi bi-envelope-open-heart me-2"></i>Thiệp Chúc Mừng Dành Cho Bạn</h4>
                </div>
                <div class="card-body p-4 bg-light d-flex justify-content-center">
                    <div class="shadow border rounded bg-white overflow-hidden text-center" style="max-width: 600px; width: 100%;">
                        <img src="@mergedCardImgPath" alt="Thiệp chúc mừng" class="img-fluid rounded" style="width: 100%; height: auto; display: block;" />
                    </div>
                </div>
            </div>

            <!-- 2. THANH ĐIỀU KHIỂN PHÁT NHẠC -->
            <div class="card shadow-sm p-3 mb-4 bg-light border-0">
                <div class="d-flex align-items-center gap-3">
                    <i class="bi bi-music-note-beamed fs-3 text-primary"></i>
                    <div class="flex-grow-1">
                        <label class="fw-bold text-dark small mb-1">Nhạc nền kèm theo thiệp:</label>
                        <audio id="bg-audio" controls loop class="w-100" style="height: 40px; display: block !important;">
                            <source src="@(string.IsNullOrEmpty(Model?.AudioPath) ? "/audio/Nhạc nền 1.mp3" : Model.AudioPath)" type="audio/mpeg">
                            Trình duyệt của bạn không hỗ trợ phát âm thanh.
                        </audio>
                    </div>
                </div>
            </div>

            <!-- 3. FORM THÔNG TIN CỐ ĐỊNH & PHẢN HỒI -->
            <div class="card shadow-sm p-4 border-0">
                <h5 class="fw-bold text-primary mb-3">
                    <i class="bi bi-info-circle me-1"></i> Thông Tin Sự Kiện & Phản Hồi Tham Dự
                </h5>

                <div class="row g-3 mb-4 bg-light p-3 rounded border">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Kính gửi người nhận:</label>
                        <input type="text" class="form-control bg-white fw-bold" value="@recipientName" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold text-secondary small">Thời gian diễn ra:</label>
                        <input type="text" class="form-control bg-white fw-bold text-danger" value="@eventTime" readonly />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold text-secondary small">Địa điểm tổ chức:</label>
                        <input type="text" class="form-control bg-white fw-bold" value="@eventAddress" readonly />
                    </div>
                </div>

                <hr />

                <!-- FORM PHẢN HỒI LẠI USER -->
                <form asp-controller="Card" asp-action="ReplyCard" method="post" id="form-reply">
                    <input type="hidden" name="CardId" value="@Model?.Id" />

                    <label class="form-label fw-bold text-dark mb-2">Bạn sẽ tham dự sự kiện chứ? (*)</label>
                    <div class="d-flex gap-2 mb-3">
                        <input type="radio" class="btn-check" name="replyStatus" id="btn-yes" value="Yes" required>
                        <label class="btn btn-outline-success flex-fill fw-bold py-2" for="btn-yes">
                            <i class="bi bi-check-circle me-1"></i> Sẽ tham dự
                        </label>

                        <input type="radio" class="btn-check" name="replyStatus" id="btn-maybe" value="Maybe">
                        <label class="btn btn-outline-warning flex-fill fw-bold py-2" for="btn-maybe">
                            <i class="bi bi-question-circle me-1"></i> Phân vân
                        </label>

                        <input type="radio" class="btn-check" name="replyStatus" id="btn-no" value="No">
                        <label class="btn btn-outline-danger flex-fill fw-bold py-2" for="btn-no">
                            <i class="bi bi-x-circle me-1"></i> Không thể tham dự
                        </label>
                    </div>

                    <div class="mb-3">
                        <label for="input-reply-desc" class="form-label form-label-sm fw-semibold">Lời nhắn gửi lại (Description / Lời chúc đáp lại):</label>
                        <textarea name="ReplyMessage" id="input-reply-desc" class="form-control form-control-sm" rows="3" placeholder="Nhập lời nhắn của bạn gửi lại cho người tạo thiệp..."></textarea>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 fw-bold py-2 shadow-sm">
                        <i class="bi bi-send me-1"></i> Gửi Phản Hồi Cho Người Tạo Thiệp
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const audio = document.getElementById("bg-audio");
        if (audio) {
            const promise = audio.play();
            if (promise !== undefined) {
                promise.catch(() => {
                    console.log("Trình duyệt yêu cầu người dùng nhấp Play để phát nhạc.");
                });
            }
        }
    });
</script>