@model E_Greeting.Models.SentCard
@using System.Text.Json

@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = !string.IsNullOrEmpty(Model?.Subject) ? Model.Subject : "Greeting Card For You";

    // Parse JSON from Message field
    string recipientName = "";
    string eventTime = "";
    string eventAddress = "";

    if (!string.IsNullOrWhiteSpace(Model?.Message))
    {
        try
        {
            using var doc = JsonDocument.Parse(Model.Message);
            var root = doc.RootElement;
            if (root.ValueKind == JsonValueKind.Object)
            {
                if (root.TryGetProperty("recipientName", out var r)) recipientName = r.GetString() ?? "";
                if (root.TryGetProperty("eventTime", out var t)) eventTime = t.GetString() ?? "";

                if (root.TryGetProperty("eventAddress", out var a) && !string.IsNullOrWhiteSpace(a.GetString()))
                    eventAddress = a.GetString()!;
                else if (root.TryGetProperty("location", out var l) && !string.IsNullOrWhiteSpace(l.GetString()))
                    eventAddress = l.GetString()!;
                else if (root.TryGetProperty("Location", out var l2) && !string.IsNullOrWhiteSpace(l2.GetString()))
                    eventAddress = l2.GetString()!;
            }
            else { recipientName = Model.Message; }
        }
        catch { recipientName = Model.Message; }
    }

    bool hasValidHtmlContent = !string.IsNullOrWhiteSpace(Model?.CardHtmlContent)
        && !Model.CardHtmlContent.TrimStart().StartsWith("{")
        && !Model.CardHtmlContent.Contains("\"recipientName\"");

    string cardImgPath = !string.IsNullOrEmpty(Model?.ImagePath) && !Model.ImagePath.TrimStart().StartsWith("{")
        ? Model.ImagePath
        : (Model?.Template?.ImagePath ?? "/uploads/templates/default-card.jpg");

    bool isEventPassed = ViewBag.IsEventPassed ?? false;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <!-- Bootstrap 5 CSS & Icons CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" />

    <style>
            body {
                background-color: #f4f6f9;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .preview-card-wrapper {
                max-width: 620px;
                margin: 30px auto;
            }

            .preview-box {
                background: #ffffff;
                border-radius: 12px;
                box-shadow: 0 4px 20px rgba(0,0,0,0.08);
                border: 1px solid #e2e8f0;
                overflow: hidden;
            }

            .preview-header {
                background-color: #0d6efd;
                color: #ffffff;
                font-weight: 700;
                padding: 12px 20px;
                text-align: center;
                font-size: 1.05rem;
            }

            .info-input-like {
                background-color: #f8f9fa;
                border: 1px solid #dee2e6;
                border-radius: 6px;
                padding: 8px 12px;
                font-size: 0.875rem;
                color: #212529;
                font-weight: 600;
                min-height: 38px;
                word-break: break-word;
            }

            .card-render-container {
                position: relative;
                width: 100%;
                overflow: hidden;
                border-radius: 8px;
                background-color: #ffffff;
            }

                .card-render-container img {
                    max-width: 100%;
                    height: auto;
                }
    </style>
</head>
<body>

    <div class="container my-4">
        <div class="preview-card-wrapper">

            <div class="preview-box mb-4">
                <!-- 1. Card Title Header -->
                <div class="preview-header">
                    <i class="bi bi-envelope-open-fill me-2"></i>@ViewData["Title"]
                </div>

                <div class="p-3 bg-light">
                    <!-- 2. Interactive Designed Card Content -->
                    <div class="text-center p-2 bg-white rounded border shadow-sm mb-3">
                        @if (hasValidHtmlContent)
                        {
                            <div class="card-render-container d-inline-block text-start position-relative">
                                @Html.Raw(Model.CardHtmlContent)
                            </div>
                        }
                        else
                        {
                            <img src="@cardImgPath" alt="Greeting Card" class="img-fluid rounded" style="max-height: 550px; width: auto; object-fit: contain;" />
                        }
                    </div>

                    <!-- 3. Background Audio Player -->
                    @if (!string.IsNullOrEmpty(Model?.AudioPath))
                    {
                        <div class="p-3 bg-white border rounded shadow-sm mb-3">
                            <div class="fw-bold text-secondary small mb-2">
                                <i class="bi bi-music-note-beamed text-primary me-1"></i>Background Music Included
                            </div>
                            <audio controls autoplay loop class="w-100" style="height: 36px;">
                                <source src="@Model.AudioPath" type="audio/mpeg">
                            </audio>
                        </div>
                    }

                    <!-- 4. Event & Card Details -->
                    <div class="p-3 bg-white border rounded shadow-sm mb-3">
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-info-circle-fill me-1"></i>Event & Card Details
                        </h6>

                        <div class="row g-2 text-start">
                            <div class="col-6 mb-2">
                                <label class="form-label small text-muted mb-1">Recipient Name:</label>
                                <div class="info-input-like">@(string.IsNullOrWhiteSpace(recipientName) ? "---" : recipientName)</div>
                            </div>
                            <div class="col-6 mb-2">
                                <label class="form-label small text-muted mb-1">Event Time:</label>
                                <div class="info-input-like">@(string.IsNullOrWhiteSpace(eventTime) ? "---" : eventTime)</div>
                            </div>
                            <div class="col-12 mb-2">
                                <label class="form-label small text-muted mb-1">Event Location:</label>
                                <div class="info-input-like">@(string.IsNullOrWhiteSpace(eventAddress) ? "---" : eventAddress)</div>
                            </div>
                            <div class="col-6 mb-2">
                                <label class="form-label small text-muted mb-1">Recipient Email:</label>
                                <div class="info-input-like">@(string.IsNullOrWhiteSpace(Model?.RecipientEmail) ? "---" : Model.RecipientEmail)</div>
                            </div>
                            <div class="col-6 mb-2">
                                <label class="form-label small text-muted mb-1">Email Subject:</label>
                                <div class="info-input-like">@(string.IsNullOrWhiteSpace(Model?.Subject) ? "---" : Model.Subject)</div>
                            </div>
                        </div>
                    </div>

                    <!-- 5. Recipient Reply Form -->
                    <div class="p-3 bg-white border rounded shadow-sm">
                        <h6 class="fw-bold text-primary mb-3">
                            <i class="bi bi-reply-fill me-1"></i>Online RSVP & Response
                        </h6>

                        <form id="form-reply">
                            <input type="hidden" name="CardId" value="@Model?.Id" />

                            <div class="mb-3">
                                <label class="form-label small fw-bold text-dark mb-2">Confirm your attendance (*):</label>
                                <div class="d-flex gap-2">
                                    <input type="radio" class="btn-check" name="AttendanceStatus" id="status-yes" value="Yes" required>
                                    <label class="btn btn-outline-success flex-fill btn-sm fw-bold py-2" for="status-yes">Attending</label>

                                    <input type="radio" class="btn-check" name="AttendanceStatus" id="status-maybe" value="Maybe">
                                    <label class="btn btn-outline-warning flex-fill btn-sm fw-bold py-2 text-dark" for="status-maybe">Undecided</label>

                                    <input type="radio" class="btn-check" name="AttendanceStatus" id="status-no" value="No">
                                    <label class="btn btn-outline-danger flex-fill btn-sm fw-bold py-2" for="status-no">Unable to attend</label>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label for="input-reply" class="form-label small text-muted mb-1">Message to the host:</label>
                                <textarea name="ReplyMessage" id="input-reply" class="form-control form-control-sm" rows="3" placeholder="Write your reply or warm wishes here..."></textarea>
                            </div>

                            <button type="button" id="btnSubmitReply" class="btn btn-primary w-100 fw-bold rounded-pill py-2">
                                <i class="bi bi-send-fill me-1"></i><span id="btnSubmitText">Submit Response</span>
                            </button>
                        </form>

                        @* Thông báo hết hạn nằm bên dưới Form Reply *@
                        @if (isEventPassed)
                        {
                            <div class="alert alert-warning text-center mt-3 mb-0 fw-semibold rounded-3 shadow-sm border-warning-subtle">
                                <i class="bi bi-lock-fill me-1"></i> The event has passed. Response updating is now closed!
                            </div>
                        }
                    </div>

                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <script>
            document.addEventListener("DOMContentLoaded", function() {
                const isEventPassed = @(isEventPassed.ToString().ToLower());
                const rawReply = @Html.Raw(Json.Serialize(Model?.RecipientReply));

                // 1. Automatically pre-fill previous response data if available
                if (rawReply) {
                    try {
                        const replyData = typeof rawReply === 'string' ? JSON.parse(rawReply) : rawReply;

                        // Pre-fill message
                        if (replyData.Text) {
                            const messageInput = document.getElementById('input-reply');
                            if (messageInput) messageInput.value = replyData.Text;
                        }

                        // Pre-fill status
                        const status = replyData.RawStatus || replyData.Status;
                        if (status) {
                            let radioId = '';
                            if (status === 'Yes' || status === 'Attending') radioId = 'status-yes';
                            else if (status === 'Maybe' || status === 'Undecided') radioId = 'status-maybe';
                            else if (status === 'No' || status === 'Unable to attend') radioId = 'status-no';

                            if (radioId) {
                                const radioEl = document.getElementById(radioId);
                                if (radioEl) radioEl.checked = true;
                            }
                        }

                        // Change button text to "Update Response" if not expired
                        const btnText = document.getElementById('btnSubmitText');
                        if (btnText && !isEventPassed) {
                            btnText.innerText = "Update Response";
                        }
                    } catch (e) {
                        console.error("Error parsing recipient reply JSON:", e);
                    }
                }

                // 2. Lock form & trigger modal warning on user click if event date has passed
                if (isEventPassed) {
                    const warningMessage = "The event has passed. Response updating is now closed!";
                    const warningTitle = "Notice";

                    const messageInput = document.getElementById('input-reply');
                    if (messageInput) {
                        messageInput.setAttribute('readonly', 'readonly');
                    }

                    // Chọn 3 nút trạng thái (labels), khung tin nhắn và nút submit
                    const interactiveElements = document.querySelectorAll('#form-reply label.btn, #input-reply, #btnSubmitReply');

                    interactiveElements.forEach(el => {
                        el.addEventListener('click', function(e) {
                            e.preventDefault();
                            e.stopPropagation();

                            if (document.activeElement) {
                                document.activeElement.blur();
                            }

                            // Gọi Modal cảnh báo toàn cục
                            if (typeof showNoticeModal === 'function') {
                                showNoticeModal(warningTitle, warningMessage, false);
                            } else {
                                alert(warningMessage);
                            }
                        });
                    });
                }
            });

            // Handle form submission
            document.getElementById("btnSubmitReply")?.addEventListener("click", function() {
                const isEventPassed = @(isEventPassed.ToString().ToLower());
                if (isEventPassed) return; // Nếu hết hạn thì không thực thi gửi AJAX

                const form = document.getElementById("form-reply");
                const statusChecked = form.querySelector('input[name="AttendanceStatus"]:checked');

                if (!statusChecked) {
                    showNoticeModal("RSVP Notice", "Please select your attendance status!", false);
                    return;
                }

                const cardId = parseInt(form.querySelector('input[name="CardId"]')?.value || "0");
                const attendanceStatus = statusChecked.value;
                const replyMessage = document.getElementById("input-reply")?.value?.trim() || "";

                const btnSubmit = this;
                btnSubmit.disabled = true;

                fetch('/Card/ReplyCard', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Accept': 'application/json'
                    },
                    body: JSON.stringify({
                        cardId: cardId,
                        attendanceStatus: attendanceStatus,
                        replyMessage: replyMessage
                    })
                })
                    .then(res => res.json())
                    .then(data => {
                        if (data.success) {
                            showNoticeModal("RSVP Notice", "Thank you! Your response has been updated successfully.", true, window.location.href);
                        } else {
                            showNoticeModal("RSVP Error", data.message || "Failed to submit response.", false);
                            btnSubmit.disabled = false;
                        }
                    })
                    .catch(err => {
                        console.error("Reply Submission Error:", err);
                        showNoticeModal("Server Error", "A server connection error occurred!", false);
                        btnSubmit.disabled = false;
                    });
            });
    </script>
</body>
</html>