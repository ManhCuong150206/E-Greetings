@{
    ViewData["Title"] = "Thiệp Chúc Mừng Dành Cho Bạn";
    var senderInfo = ViewBag.SenderName ?? ViewBag.SenderEmail ?? "Người bạn thân";
    string bgImage = ViewBag.ImagePath as string ?? "";
}

<!-- CSS Chuẩn hóa hiển thị khớp 100% với lúc thiết kế ở trang Personalize -->
<style>
    /* 1. Khung chứa thiệp chuẩn tỷ lệ 4:3 (600px x 450px) */
    #card-preview-area {
        position: relative !important;
        width: 100% !important;
        max-width: 600px !important;
        height: 450px !important; /* Đổi từ 400px thành 450px để khớp tỷ lệ lúc chỉnh sửa */
        background-size: 100% 100% !important; /* Giúp ảnh template trọn vẹn 100%, không bị cắt viền */
        background-repeat: no-repeat !important;
        background-position: center !important;
        background-color: #ffffff;
        margin: 0 auto;
        overflow: hidden;
    }

        /* 2. Đảm bảo các phần tử chữ & ảnh đặt đúng vị trí tuyệt đối */
        #card-preview-area .draggable-element,
        #card-preview-area .draggable-text-box {
            position: absolute !important;
            box-sizing: border-box !important;
            border: none !important;
            outline: none !important;
            box-shadow: none !important;
            cursor: default !important;
        }

        /* 3. Giữ nguyên định dạng ngắt dòng, khoảng cách chữ chuẩn như lúc nhập */
        #card-preview-area .text-content,
        #card-preview-area p,
        #card-preview-area div {
            white-space: pre-wrap !important;
            word-wrap: break-word !important;
            word-break: break-word !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        /* 4. Định dạng ảnh cá nhân được chèn vào bên trong */
        #card-preview-area img:not(.bg-template) {
            max-width: 100%;
            height: auto;
            object-fit: contain;
            display: block;
        }

        /* 5. Triệt tiêu hoàn toàn thanh cuộn scrollbar */
        #card-preview-area::-webkit-scrollbar,
        .draggable-text-box::-webkit-scrollbar,
        .text-content::-webkit-scrollbar {
            display: none !important;
            width: 0 !important;
            height: 0 !important;
        }

    #card-preview-area,
    .draggable-text-box,
    .text-content {
        -ms-overflow-style: none !important;
        scrollbar-width: none !important;
    }
</style>

<div class="container my-5 text-center" style="max-width: 650px;">
    <!-- THÔNG BÁO TỪ NGƯỜI GỬI -->
    <div class="mb-3">
        <span class="badge bg-danger fs-6 px-3 py-2">🎁 Bạn nhận được một tấm thiệp từ @senderInfo</span>
        <p class="text-muted small mt-2">Đã mở lúc: @ViewBag.OpenAt</p>
    </div>

    <!-- KHUNG HIỂN THỊ THIỆP -->
    <div id="card-preview-area"
         class="card shadow-lg border-0 rounded-3"
         style="background-image: url('@bgImage');">

        @if (!string.IsNullOrEmpty(ViewBag.CardHtmlContent as string))
        {
            @Html.Raw(ViewBag.CardHtmlContent)
        }
    </div>

    <!-- TRÌNH PHÁT NHẠC NỀN -->
    @if (!string.IsNullOrEmpty(ViewBag.AudioPath as string))
    {
        <div class="my-4 p-3 bg-light rounded shadow-sm d-flex align-items-center justify-content-center gap-3">
            <span>🎵 Nhạc nền thiệp:</span>
            <audio id="card-audio" controls autoplay loop style="height: 35px;">
                <source src="@ViewBag.AudioPath" type="audio/mpeg">
            </audio>
        </div>
    }

    <hr class="my-4" />

    <!-- FORM GỬI LỜI CẢM ƠN -->
    <div class="card p-4 shadow-sm text-start bg-white rounded-3">
        <h5 class="card-title text-primary mb-3">💌 Gửi lời cảm ơn / Phản hồi</h5>
        <div class="mb-3">
            <textarea id="reply-message" class="form-control" rows="3"
                      placeholder="Cảm ơn bạn vì tấm thiệp rất đáng yêu này..."></textarea>
        </div>
        <button id="btn-send-reply" class="btn btn-primary w-100 fw-bold py-2">
            Gửi Phản Hồi
        </button>
    </div>
</div>

@section Scripts {
    <script src="~/js/view-card.js" asp-append-version="true"></script>
}