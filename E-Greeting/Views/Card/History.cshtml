@model E_Greeting.Models.UserHistoryViewModel
@using System.Text.Json

@{
    ViewData["Title"] = "Lịch Sử Hoạt Động & Giao Dịch";
    string activeTab = ViewBag.ActiveTab as string ?? "cards";
}

<div class="container my-5">
    <!-- Header Section -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-3 border-bottom">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="bi bi-clock-history me-2"></i>Lịch Sử Hoạt Động & Giao Dịch
            </h2>
            <p class="text-muted small mb-0">Quản lý lịch sử gửi thiệp chúc mừng và thông tin các gói dịch vụ VIP đã đăng ký</p>
        </div>
        <div class="mt-3 mt-md-0 d-flex gap-2">
            <a href="/" class="btn btn-primary fw-semibold shadow-sm">
                <i class="bi bi-plus-circle me-1"></i> Tạo Thiệp Mới
            </a>
            <a href="/Subscription" class="btn btn-outline-success fw-semibold shadow-sm">
                <i class="bi bi-star-fill me-1"></i> Nâng Cấp VIP
            </a>
        </div>
    </div>

    <!-- Navigation Tabs -->
    <ul class="nav nav-pills gap-2 mb-4 p-2 bg-light rounded-3 border shadow-sm" id="historyTab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold px-4 py-2.5 @(activeTab == "cards" ? "active" : "")"
                    id="cards-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#cards-content"
                    type="button"
                    role="tab"
                    aria-controls="cards-content"
                    aria-selected="@(activeTab == "cards" ? "true" : "false")">
                <i class="bi bi-card-heading me-2"></i>1. Lịch Sử Gửi Thiệp
                <span class="badge bg-secondary ms-2">@(Model.SentCards?.Count ?? 0)</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link fw-bold px-4 py-2.5 @(activeTab == "payments" ? "active" : "")"
                    id="payments-tab"
                    data-bs-toggle="pill"
                    data-bs-target="#payments-content"
                    type="button"
                    role="tab"
                    aria-controls="payments-content"
                    aria-selected="@(activeTab == "payments" ? "true" : "false")">
                <i class="bi bi-credit-card-2-front me-2"></i>2. Lịch Sử Gói VIP
                <span class="badge bg-secondary ms-2">@(Model.Subscriptions?.Count ?? 0)</span>
            </button>
        </li>
    </ul>

    <!-- Tab Content Container -->
    <div class="tab-content" id="historyTabContent">

        <!-- TAB 1: LỊCH SỬ GỬI THIỆP -->
        <div class="tab-pane fade @(activeTab == "cards" ? "show active" : "")" id="cards-content" role="tabpanel" aria-labelledby="cards-tab">
            @if (Model.SentCards == null || !Model.SentCards.Any())
            {
                <div class="text-center py-5 bg-light rounded-3 border shadow-sm">
                    <div class="mb-3">
                        <i class="bi bi-card-heading text-muted opacity-50 display-1"></i>
                    </div>
                    <h5 class="fw-bold text-secondary">Bạn chưa gửi thiệp nào</h5>
                    <p class="text-muted small mb-3">Hãy tạo thiệp chúc mừng đầu tiên để gửi tới người thân và bạn bè!</p>
                    <a href="/" class="btn btn-primary fw-semibold px-4">
                        <i class="bi bi-magic me-1"></i> Tạo Thiệp Ngay
                    </a>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark text-nowrap">
                                <tr>
                                    <th style="width: 80px;" class="text-center">Ảnh</th>
                                    <th>Thông Tin Thiệp & Người Nhận</th>
                                    <th class="text-center">Thời Gian Gửi</th>
                                    <th class="text-center">Trạng Thái Mở</th>
                                    <th>Phản Hồi Từ Người Nhận</th>
                                    <th class="text-center" style="width: 140px;">Thao Tác</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var card in Model.SentCards)
                                {
                                    string displayImg = !string.IsNullOrEmpty(card.ImagePath)
                                        ? card.ImagePath
                                        : (card.Template?.ImagePath ?? "/images/default-card.jpg");

                                    string attendanceStatus = "";
                                    string replyMessage = "";

                                    if (!string.IsNullOrWhiteSpace(card.RecipientReply))
                                    {
                                        try
                                        {
                                            using var doc = JsonDocument.Parse(card.RecipientReply);
                                            if (doc.RootElement.TryGetProperty("Status", out var statusProp))
                                                attendanceStatus = statusProp.GetString() ?? "";
                                            if (doc.RootElement.TryGetProperty("Text", out var textProp))
                                                replyMessage = textProp.GetString() ?? "";
                                        }
                                        catch
                                        {
                                            replyMessage = card.RecipientReply;
                                        }
                                    }

                                    <tr>
                                        <!-- Cột 1: Ảnh Xem Trước -->
                                        <td class="text-center">
                                            <img src="@displayImg"
                                                 class="img-thumbnail rounded shadow-sm object-fit-cover"
                                                 style="width: 65px; height: 65px;"
                                                 alt="Ảnh thiệp"
                                                 onerror="this.src='/images/default-card.jpg';" />
                                        </td>

                                        <!-- Cột 2: Thông Tin Thiệp & Người Nhận -->
                                        <td>
                                            <div class="fw-bold text-dark fs-6 mb-1">
                                                @(string.IsNullOrWhiteSpace(card.Subject) ? "Thiệp chúc mừng" : card.Subject)
                                            </div>
                                            <div class="text-muted small">
                                                <i class="bi bi-envelope-at me-1 text-primary"></i>
                                                <span class="user-select-all">@card.RecipientEmail</span>
                                            </div>
                                        </td>

                                        <!-- Cột 3: Thời Gian Gửi & Trạng Thái Theo Bảng Yêu Cầu (Hình 6) -->
                                        <td class="text-center text-nowrap small">
                                            @if (card.ScheduledAt.HasValue && card.SentAt == null)
                                            {
                                                <!-- Trường hợp 1: Hẹn giờ (Chờ gửi) -->
                                                <span class="badge bg-warning text-dark px-2.5 py-1.5 shadow-sm">
                                                    <i class="bi bi-clock-history me-1"></i>Hẹn gửi:<br />
                                                    <strong>@card.ScheduledAt.Value.ToString("dd/MM/yyyy HH:mm")</strong>
                                                </span>
                                                <div class="mt-1">
                                                    <span class="badge bg-light text-primary border">Đã lên lịch</span>
                                                </div>
                                            }
                                            else if (card.ScheduledAt.HasValue && card.SentAt.HasValue)
                                            {
                                                <!-- Trường hợp 2: Hẹn giờ (Đã gửi xong) -->
                                                <div class="text-success fw-bold">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Đã gửi
                                                </div>
                                                <div class="text-secondary small">
                                                    @card.SentAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                </div>
                                                <div class="mt-1">
                                                    <span class="badge bg-light text-muted border" style="font-size: 0.7rem;">
                                                        Hẹn: @card.ScheduledAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                    </span>
                                                </div>
                                            }
                                            else if (card.SentAt.HasValue)
                                            {
                                                <!-- Trường hợp 3: Gửi ngay -->
                                                <div class="text-secondary">
                                                    <i class="bi bi-calendar3 me-1"></i>@card.SentAt.Value.ToString("dd/MM/yyyy")<br />
                                                    <i class="bi bi-clock me-1"></i>@card.SentAt.Value.ToString("HH:mm")
                                                </div>
                                                <div class="mt-1">
                                                    <span class="badge bg-success shadow-sm">Đã gửi</span>
                                                </div>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary opacity-75">Chưa gửi</span>
                                            }
                                        </td>

                                        <!-- Cột 4: Thời Gian Mở Thiệp -->
                                        <td class="text-center text-nowrap">
                                            @if (card.OpenAt.HasValue)
                                            {
                                                <span class="badge bg-info text-dark px-2.5 py-1.5 shadow-sm">
                                                    <i class="bi bi-eye-fill me-1"></i>@card.OpenAt.Value.ToString("dd/MM/yyyy HH:mm")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-light text-muted border px-2.5 py-1.5">
                                                    <i class="bi bi-eye-slash me-1"></i>Chưa mở
                                                </span>
                                            }
                                        </td>

                                        <!-- Cột 5: Phản Hồi Trạng Thái -->
                                        <td style="max-width: 260px;">
                                            <div class="mb-1">
                                                @switch (attendanceStatus)
                                                {
                                                    case "Sẽ tham dự":
                                                        <span class="badge bg-success shadow-sm"><i class="bi bi-check-circle-fill me-1"></i>Sẽ tham dự</span>
                                                        break;
                                                    case "Phân vân":
                                                        <span class="badge bg-warning text-dark shadow-sm"><i class="bi bi-question-circle-fill me-1"></i>Phân vân</span>
                                                        break;
                                                    case "Không thể tham dự":
                                                        <span class="badge bg-danger shadow-sm"><i class="bi bi-x-circle-fill me-1"></i>Không thể tham dự</span>
                                                        break;
                                                    default:
                                                        <span class="badge bg-light text-muted border"><i class="bi bi-dash-circle me-1"></i>Chưa phản hồi</span>
                                                        break;
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(replyMessage))
                                            {
                                                <div class="p-2 bg-light rounded text-dark small border text-break mt-1 shadow-sm">
                                                    <i class="bi bi-chat-quote-fill text-primary me-1"></i>
                                                    <span>"@replyMessage"</span>
                                                </div>
                                            }
                                        </td>

                                        <!-- Cột 6: Thao Tác -->
                                        <td class="text-center text-nowrap">
                                            <div class="d-flex justify-content-center gap-1">
                                                <a href="/Card/ViewCard/@card.Id"
                                                   target="_blank"
                                                   class="btn btn-sm btn-outline-primary fw-semibold"
                                                   title="Xem chi tiết thiệp">
                                                    <i class="bi bi-box-arrow-up-right me-1"></i> Xem
                                                </a>
                                                <button type="button"
                                                        class="btn btn-sm btn-outline-secondary"
                                                        onclick="copyCardLink('@card.Id')"
                                                        title="Sao chép đường dẫn thiệp">
                                                    <i class="bi bi-link-45deg"></i>
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>

        <!-- TAB 2: LỊCH SỬ GIAO DỊCH VIP -->
        <div class="tab-pane fade @(activeTab == "payments" ? "show active" : "")" id="payments-content" role="tabpanel" aria-labelledby="payments-tab">
            @if (Model.Subscriptions == null || !Model.Subscriptions.Any())
            {
                <div class="text-center py-5 bg-light rounded-3 border shadow-sm">
                    <div class="mb-3">
                        <i class="bi bi-receipt text-muted opacity-50 display-1"></i>
                    </div>
                    <h5 class="fw-bold text-secondary">Bạn chưa có giao dịch đăng ký gói dịch vụ nào</h5>
                    <p class="text-muted small mb-3">Nâng cấp gói VIP ngay để trải nghiệm trọn bộ tính năng cao cấp không giới hạn!</p>
                    <a href="/Subscription" class="btn btn-success fw-semibold px-4">
                        <i class="bi bi-star-fill me-1"></i> Đăng Ký Gói VIP
                    </a>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0 rounded-3 overflow-hidden">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-dark text-nowrap">
                                <tr>
                                    <th class="text-center" style="width: 90px;">Mã HĐ</th>
                                    <th>Gói Đăng Ký</th>
                                    <th class="text-end">Số Tiền</th>
                                    <th class="text-center">Ngày Bắt Đầu</th>
                                    <th class="text-center">Thời Hạn Gói</th>
                                    <th class="text-center">Trạng Thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var sub in Model.Subscriptions)
                                {
                                    string packageName = sub.Service?.Name ?? "Gói VIP";
                                    decimal price = sub.Service?.Price ?? sub.Payments?.FirstOrDefault()?.Amount ?? 0;
                                    bool isExpired = sub.EndDate.HasValue && sub.EndDate.Value < DateOnly.FromDateTime(DateTime.Now);
                                    bool isActive = sub.IsActive && !isExpired;

                                    <tr>
                                        <!-- Mã Hóa Đơn -->
                                        <td class="text-center fw-bold text-primary">#@sub.Id</td>

                                        <!-- Tên Gói -->
                                        <td>
                                            <span class="badge bg-info text-dark fs-6 px-3 py-2 shadow-sm">
                                                <i class="bi bi-gem me-1"></i>@packageName
                                            </span>
                                        </td>

                                        <!-- Giá -->
                                        <td class="text-end fw-bold text-success fs-6">
                                            @price.ToString("N0") đ
                                        </td>

                                        <!-- Ngày Bắt Đầu -->
                                        <td class="text-center text-nowrap small text-secondary">
                                            <i class="bi bi-calendar-event me-1"></i>@sub.StartDate.ToString("dd/MM/yyyy")
                                        </td>

                                        <!-- Thời Hạn -->
                                        <td class="text-center text-nowrap small">
                                            @if (sub.EndDate.HasValue)
                                            {
                                                <span class="fw-medium text-dark">
                                                    @sub.StartDate.ToString("dd/MM/yyyy") - @sub.EndDate.Value.ToString("dd/MM/yyyy")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="fw-medium text-dark">Từ @sub.StartDate.ToString("dd/MM/yyyy")</span>
                                            }
                                        </td>

                                        <!-- Trạng Thái -->
                                        <td class="text-center">
                                            @if (isActive)
                                            {
                                                <span class="badge bg-success px-3 py-2 shadow-sm">
                                                    <i class="bi bi-check-circle-fill me-1"></i>Đang Hoạt Động
                                                </span>
                                            }
                                            else if (isExpired)
                                            {
                                                <span class="badge bg-secondary px-3 py-2">
                                                    <i class="bi bi-clock-history me-1"></i>Đã Hết Hạn
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning text-dark px-3 py-2">
                                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>Tạm Ngưng
                                                </span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function copyCardLink(cardId) {
            const url = `${window.location.origin}/Card/ViewCard/${cardId}`;
            navigator.clipboard.writeText(url).then(() => {
                alert("Đã sao chép đường dẫn thiệp!");
            }).catch(err => {
                console.error("Lỗi khi sao chép link: ", err);
            });
        }
    </script>
}