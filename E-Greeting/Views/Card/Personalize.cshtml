@model E_Greeting.Models.Template

@{
    ViewData["Title"] = "Trình Tạo Thiệp - Card Editor";
}

<div class="container my-4">
    <h3 class="mb-4">Tùy Chỉnh Thiệp Chúc Mừng</h3>
    <div class="row">
        <!-- BÊN TRÁI: LIVE PREVIEW & CANVAS KÉO THẢ -->
        <div class="col-md-7 mb-4">
            <div class="card shadow-sm p-3 text-center" style="background-color: #f8f9fa;">
                <h5 class="card-title text-muted">Xem Trước (Xem & Kéo thả trực tiếp)</h5>

                <!-- Khung chứa Thiệp (Canvas) -->
                <div id="card-preview-area" class="position-relative overflow-hidden rounded mx-auto shadow-sm"
                     style="width: 500px; height: 380px; background-color: #fff;">

                    <!-- Ảnh nền Thiệp -->
                    <img id="preview-image" src="@(Model?.ImagePath ?? "https://picsum.photos/800/600")"
                         class="w-100 h-100 style-cover" style="object-fit: cover;" alt="Card Image" />

                    <!-- Khung chữ mặc định (Có thể kéo thả) -->
                    <div class="draggable-element position-absolute p-2 rounded text-center cursor-move"
                         style="top: 40%; left: 15%; width: 70%; color: #000000; font-family: 'Arial'; font-size: 20px; background: rgba(255,255,255,0.6); cursor: move; user-select: none;">
                        <span class="text-content">Chúc bạn một ngày vui vẻ!</span>
                    </div>
                </div>

                <!-- Nhạc nền xem trước -->
                <div class="mt-3">
                    <audio id="audio-player" controls class="w-100 d-none"></audio>
                </div>
            </div>
        </div>

        <!-- BÊN PHẢI: BẢNG CÔNG CỤ EDIT -->
        <div class="col-md-5">
            <div class="card shadow-sm p-3">
                <h5 class="card-title mb-3">Công Cụ Chỉnh Sửa</h5>

                <!-- 1. Nút Thêm Chữ / Thêm Sticker -->
                <div class="d-flex gap-2 mb-3">
                    <button type="button" id="btn-add-text" class="btn btn-outline-primary btn-sm w-50">
                        + Thêm khung chữ
                    </button>
                    <button type="button" id="btn-clear-canvas" class="btn btn-outline-danger btn-sm w-50">
                        Xóa bớt vật thể
                    </button>
                </div>

                <!-- 2. Nhập Lời Chúc (Cho khung chữ đang chọn) -->
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Nội dung chữ:</label>
                    <textarea id="input-message" class="form-control" rows="2" placeholder="Nhập chữ...">Chúc bạn một ngày vui vẻ!</textarea>
                </div>

                <!-- 3. Format Font & Màu Chữ -->
                <div class="row mb-3">
                    <div class="col-6">
                        <label class="form-label">Font chữ:</label>
                        <select id="select-font" class="form-select">
                            <option value="Arial">Arial</option>
                            <option value="'Courier New', Courier, monospace">Courier New</option>
                            <option value="'Georgia', serif">Georgia</option>
                            <option value="'Comic Sans MS', cursive">Comic Sans</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label">Màu chữ:</label>
                        <input type="color" id="input-color" class="form-control form-control-color w-100" value="#000000" />
                    </div>
                </div>

                <!-- 4. Gắn Sticker -->
                <div class="mb-3">
                    <label class="form-label font-weight-bold">Thêm Sticker / Biểu tượng:</label>
                    <div class="d-flex gap-2 flex-wrap fs-3">
                        <span class="sticker-opt cursor-pointer" style="cursor:pointer">❤️</span>
                        <span class="sticker-opt cursor-pointer" style="cursor:pointer">🎂</span>
                        <span class="sticker-opt cursor-pointer" style="cursor:pointer">🎉</span>
                        <span class="sticker-opt cursor-pointer" style="cursor:pointer">🌸</span>
                        <span class="sticker-opt cursor-pointer" style="cursor:pointer">🎁</span>
                        <span class="sticker-opt cursor-pointer" style="cursor:pointer">✨</span>
                    </div>
                </div>

                <!-- 5. Chọn Nhạc Nền -->
                <div class="mb-3">
                    <label class="form-label">Nhạc nền:</label>
                    <select id="select-audio" class="form-select">
                        <option value="">-- Không chọn nhạc --</option>
                        <option value="/audio/Nhạc nền 1.mp3">Nhạc nền 1</option>
                        <option value="/audio/Nhạc nền 2.mp3">Nhạc nền 2</option>
                    </select>
                </div>

                <hr />

                <!-- 6. Thông Tin Gửi -->
                <div class="mb-2">
                    <label class="form-label">Email Người Nhận (*):</label>
                    <input type="email" id="input-recipient" class="form-control" placeholder="nguoinhan@example.com" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Tiêu đề Email:</label>
                    <input type="text" id="input-subject" class="form-control" value="Thiệp chúc mừng dành riêng cho bạn!" />
                </div>

                <button id="btn-save-card" class="btn btn-success btn-lg w-100 mt-2">
                    Lưu & Gửi Thiệp
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/personalize.js"></script>
}