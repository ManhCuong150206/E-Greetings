@model E_Greeting.Models.Template
@using System.Text.Json;

@{
    ViewData["Title"] = "Customize Greeting Card";
    bool isVip = ViewBag.IsVip ?? false;

    // Extract background image & elements from ConfigData
    string bgImage = "/uploads/templates/default-card.jpg";
    JsonElement elementsArray = default;
    bool hasElements = false;

    if (!string.IsNullOrWhiteSpace(Model?.ConfigData))
    {
        try
        {
            using var doc = JsonDocument.Parse(Model.ConfigData);
            var root = doc.RootElement;

            if (root.TryGetProperty("background_image", out var bgProp) && !string.IsNullOrWhiteSpace(bgProp.GetString()))
            {
                bgImage = bgProp.GetString()!;
            }
            else if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                bgImage = Model.ImagePath;
            }

            if (root.TryGetProperty("elements", out var elProp) && elProp.ValueKind == JsonValueKind.Array)
            {
                elementsArray = elProp.Clone();
                hasElements = elementsArray.GetArrayLength() > 0;
            }
        }
        catch { }
    }
    else if (!string.IsNullOrEmpty(Model?.ImagePath))
    {
        bgImage = Model.ImagePath;
    }
}

@section Styles {
    <!-- Google Fonts CDN -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Aboreto&family=Amatic+SC:wght@400;700&family=Arimo:ital,wght@0,400..700;1,400..700&family=Bentham&family=Cinzel:wght@400..900&family=Cormorant+Garamond:ital,wght@0,300..700;1,300..700&family=Dancing+Script:wght@400..700&family=Fraunces:ital,opsz,wght@0,9..144,100..900;1,9..144,100..900&family=Great+Vibes&family=Instrument+Serif:ital@0;1&family=Josefin+Sans:ital,wght@0,100..700;1,100..700&family=Josefin+Slab:ital,wght@0,100..700;1,100..700&family=Kreon:wght@300..700&family=Lato:ital,wght@0,100..900;1,100..900&family=Libre+Baskerville:ital,wght@0,400;0,700;1,400&family=Lobster&family=Lora:ital,wght@0,400..700;1,400..700&family=Luckiest+Guy&family=Meow+Script&family=Merriweather:ital,wght@0,300..900;1,300..900&family=Monsieur+La+Doulaise&family=Montserrat:ital,wght@0,100..900;1,100..900&family=Mountains+of+Christmas:wght@400;700&family=Nunito:ital,wght@0,200..1000;1,200..1000&family=Open+Sans:ital,wght@0,300..800;1,300..800&family=Oswald:wght@200..700&family=Pacifico&family=Parisienne&family=Patrick+Hand&family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Poppins:ital,wght@0,100..900;1,100..900&family=Quicksand:wght@300..700&family=Ribeye+Marrow&family=Rozha+One&family=Sail&family=Silkscreen:wght@400;700&family=Spicy+Rice&family=Tenor+Sans&display=swap" rel="stylesheet">
}

<div class="container my-4">

    <!-- ========================================================================= -->
    <!-- STEP 1: CARD EDIT SECTION                                                 -->
    <!-- ========================================================================= -->
    <div id="section-edit">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h3 class="fw-bold text-primary mb-0"><i class="bi bi-palette me-2"></i>Customize Card: @(Model?.Name ?? "Card Template")</h3>
            <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Back to Home
            </a>
        </div>

        <input type="hidden" id="template-id" value="@Model?.Id" />

        <div class="row g-4">
            <!-- LEFT COLUMN (7/12): CANVAS PREVIEW & CARD DETAILS FORM -->
            <div class="col-lg-7">
                <!-- 1. CANVAS PREVIEW AREA -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-card-image me-1"></i> Cover Design Canvas</span>
                        <span class="badge bg-light text-primary">Template #@(Model?.Id ?? 0)</span>
                    </div>
                    <div class="card-body p-3 d-flex justify-content-center bg-dark bg-opacity-10 overflow-auto">
                        <div id="card-preview-area" class="position-relative shadow border rounded bg-white overflow-hidden"
                             style="width: 100%; max-width: 600px; height: 420px; background-image: url('@bgImage'); background-size: contain; background-repeat: no-repeat; background-position: center; user-select: none;">

                            @if (hasElements)
                            {
                                bool isFirst = true;
                                foreach (var item in elementsArray.EnumerateArray())
                                {
                                    string content = item.TryGetProperty("content", out var c) ? c.GetString() ?? "" : "";
                                    string top = item.TryGetProperty("top", out var t) ? t.GetString() ?? "35%" : "35%";
                                    string left = item.TryGetProperty("left", out var l) ? l.GetString() ?? "15%" : "15%";
                                    string font = item.TryGetProperty("fontFamily", out var f) ? f.GetString() ?? "Arial" : "Arial";
                                    string size = item.TryGetProperty("fontSize", out var s) ? s.GetString() ?? "18px" : "18px";
                                    string color = item.TryGetProperty("color", out var cl) ? cl.GetString() ?? "#000000" : "#000000";
                                    string weight = item.TryGetProperty("fontWeight", out var w) ? w.GetString() ?? "normal" : "normal";
                                    string style = item.TryGetProperty("fontStyle", out var st) ? st.GetString() ?? "normal" : "normal";

                                    <div class="draggable-text-box @(isFirst ? "active" : "") position-absolute p-2 rounded text-center"
                                         style="top: @top; left: @left; color: @color; font-family: @font; font-size: @size; font-weight: @weight; font-style: @style; cursor: move; border: @(isFirst ? "2px dashed #0d6efd" : "1px dashed rgba(13,110,253,0.5)"); background: rgba(255,255,255,0.4);"
                                         data-top="@top" data-left="@left">
                                        <span class="text-content" style="white-space: pre-wrap; display: block;">@content</span>
                                    </div>
                                    isFirst = false;
                                }
                            }
                            else
                            {
                                <div class="draggable-text-box active position-absolute p-2 rounded text-center"
                                     style="top: 35%; left: 15%; width: 70%; color: #000000; font-family: Arial; font-size: 20px; cursor: move; border: 2px dashed #0d6efd; background: rgba(255,255,255,0.4);">
                                    <span class="text-content" style="white-space: pre-wrap; display: block;">Warmest Wishes From My Heart</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- 2. CARD & EVENT DETAILS FORM -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-card-heading me-2"></i>Event & Recipient Details</h5>

                    <div class="mb-3">
                        <label for="input-email-subject" class="form-label fw-bold">Email Subject (*):</label>
                        <input type="text" id="input-email-subject" name="Subject" class="form-control" placeholder="A special invitation for you..." required />
                    </div>

                    <!-- DYNAMIC RECIPIENT LIST SECTION -->
                    <div class="mb-3">
                        <label class="form-label fw-bold d-flex justify-content-between align-items-center">
                            <span>Recipients List (*)</span>
                            <span id="recipientCounter" class="badge bg-secondary">Recipients: 1/10</span>
                        </label>

                        <div id="recipientsContainer">
                            <div class="recipient-row mb-3 p-3 border rounded bg-light" data-index="0">
                                <div class="row align-items-center g-2">
                                    <div class="col-md-5">
                                        <label class="form-label small fw-bold text-secondary mb-1">Recipient Name (*):</label>
                                        <input type="text" class="form-control recipient-name" placeholder="e.g. John Doe" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-secondary mb-1">Recipient Email (*):</label>
                                        <input type="email" class="form-control recipient-email" placeholder="john@example.com" required />
                                    </div>
                                    <div class="col-md-1 text-center pt-md-3">
                                        @if (isVip)
                                        {
                                            <button type="button" class="btn btn-primary rounded-circle shadow-sm" title="Add recipient (+)" onclick="addRecipientRow()">
                                                <i class="bi bi-plus-lg"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>

                        @if (!isVip)
                        {
                            <small class="text-danger d-block mt-1">
                                * Standard accounts can only send to 1 recipient per card.
                                <a asp-controller="Subscription" asp-action="Index" class="fw-bold text-primary">Upgrade to VIP</a> to send up to 10 recipients at once.
                            </small>
                        }
                    </div>

                    <div class="mb-3">
                        <label for="input-event-address" class="form-label fw-bold">Event Location / Venue (*):</label>
                        <input type="text" id="input-event-address" name="Location" class="form-control" placeholder="e.g. Grand Ballroom, Hilton Hotel" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="input-event-time" class="form-label fw-bold">Event Time (*):</label>
                            <input type="datetime-local" id="input-event-time" name="EventTime" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold d-flex align-items-center justify-content-between">
                                <span>Schedule Email Delivery:</span>
                                @if (!isVip)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>VIP Feature</span>
                                }
                            </label>

                            @if (isVip)
                            {
                                <input type="datetime-local" id="scheduledAt" name="ScheduledAt" class="form-control" placeholder="Leave blank to send immediately" />
                                <small class="text-muted fs-7">Leave empty to send immediately upon confirmation.</small>
                            }
                            else
                            {
                                <input type="datetime-local" class="form-control bg-light" disabled title="Available for VIP accounts only" />
                                <small class="text-muted fs-7">
                                    <a asp-controller="Subscription" asp-action="Index" class="fw-bold text-primary">Upgrade to VIP</a> to enable scheduled delivery.
                                </small>
                            }
                        </div>
                    </div>
                </div>
            </div>

