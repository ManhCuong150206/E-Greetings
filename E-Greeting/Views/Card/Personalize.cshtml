@{
    ViewData["Title"] = "Cá nhân hóa Thiệp";
}

<div class="container my-4">
    <div class="d-flex align-items-center mb-4">
        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-pill me-3">
            <i class="bi bi-arrow-left"></i> Quay lại
        </a>
        <h3 class="fw-bold mb-0">Cá nhân hóa thiệp của bạn</h3>
    </div>

    <div class="row g-4">
        <!-- BÊN TRÁI: LIVE PREVIEW THIỆP -->
        <div class="col-lg-6 text-center">
            <div class="card border-0 shadow-lg rounded-4 overflow-hidden sticky-top" style="top: 90px;">
                <div class="position-relative">
                    <img src="@ViewBag.ImagePath" id="cardPreviewImg" class="w-100 object-fit-cover" style="max-height: 480px;" alt="Card Preview" />
                    <div class="position-absolute bottom-0 start-0 end-0 p-4 text-white bg-dark bg-opacity-50 text-start" style="backdrop-filter: blur(4px);">
                        <h6 id="previewSubject" class="fw-bold text-warning mb-1">Tiêu đề lời chúc...</h6>
                        <p id="previewMessage" class="small mb-0 fst-italic">Nội dung lời chúc của bạn sẽ xuất hiện ở đây...</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- BÊN PHẢI: FORM NHẬP LỜI CHÚC -->
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm rounded-4 p-4">
                <h5 class="fw-bold mb-3"><i class="bi bi-pencil-square text-primary me-2"></i>Điền thông tin thiệp</h5>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Tiêu đề thiệp (Subject)</label>
                    <input type="text" id="inputSubject" class="form-control rounded-3" placeholder="Ví dụ: Chúc mừng sinh nhật bạn yêu!" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Lời chúc mừng (Message)</label>
                    <textarea id="inputMessage" class="form-control rounded-3" rows="5" placeholder="Viết những lời chúc tốt đẹp nhất gửi đến người nhận..."></textarea>
                </div>

                <hr class="my-4">

                <div class="d-grid">
                    <button type="button" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm" data-bs-toggle="modal" data-bs-target="#sendModal">
                        <i class="bi bi-send-fill me-2"></i> TIẾP TỤC GỬI THIỆP
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- MODAL / POPUP "SEND CARD" -->
<div class="modal fade" id="sendModal" tabindex="-1" aria-labelledby="sendModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg rounded-4">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-header-title fw-bold text-primary" id="sendModalLabel">
                    <i class="bi bi-envelope-paper-heart me-2"></i>Gửi Thiệp Đến Người Nhận
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="sendCardForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Email người nhận <span class="text-danger">*</span></label>
                        <input type="email" id="inputRecipientEmail" class="form-control rounded-3" placeholder="name@example.com" required />
                    </div>
                    <div class="alert alert-light border small text-muted">
                        <i class="bi bi-info-circle me-1"></i> Thiệp sẽ được định dạng đẹp mắt và gửi tới email của người nhận ngay lập tức.
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="btnConfirmSend" class="btn btn-primary rounded-pill px-4 fw-bold">
                    <span id="btnSendSpinner" class="spinner-border spinner-border-sm d-none me-2" role="status"></span>
                    <i class="bi bi-send me-1" id="btnSendIcon"></i> Xác Nhận Gửi
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const inputSubject = document.getElementById("inputSubject");
            const inputMessage = document.getElementById("inputMessage");
            const previewSubject = document.getElementById("previewSubject");
            const previewMessage = document.getElementById("previewMessage");
            const btnConfirmSend = document.getElementById("btnConfirmSend");
            const sendModalEl = document.getElementById("sendModal");
            const sendModal = new bootstrap.Modal(sendModalEl);

            // 1. Lập tức cập nhật chữ trên thiệp khi nhập text (Realtime Live Preview)
            inputSubject.addEventListener("input", function () {
                previewSubject.textContent = this.value.trim() || "Tiêu đề lời chúc...";
            });

            inputMessage.addEventListener("input", function () {
                previewMessage.textContent = this.value.trim() || "Nội dung lời chúc của bạn sẽ xuất hiện ở đây...";
            });

            // 2. Xử lý sự kiện gửi AJAX khi bấm "Xác Nhận Gửi"
            btnConfirmSend.addEventListener("click", function () {
                const recipientEmail = document.getElementById("inputRecipientEmail").value.trim();
                const subject = inputSubject.value.trim();
                const message = inputMessage.value.trim();

                if (!recipientEmail) {
                    showToast("Vui lòng nhập Email người nhận!", "danger");
                    return;
                }

                // Bật hiệu ứng Loading
                toggleLoading(true);

                // Gửi dữ liệu bằng Fetch API tới backend /Card/SendCard
                fetch('/Card/SendCard', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        cardId: @ViewBag.CardId,
                        recipientEmail: recipientEmail,
                        subject: subject,
                        message: message
                    })
                })
                    .then(response => response.json())
                    .then(data => {
                        toggleLoading(false);
                        if (data.success) {
                            sendModal.hide();
                            showToast(data.message, "success");
                            // Reset form
                            document.getElementById("sendCardForm").reset();
                        } else {
                            showToast(data.message, "danger");
                        }
                    })
                    .catch(error => {
                        toggleLoading(false);
                        console.error("Error:", error);
                        showToast("Lỗi hệ thống! Không thể gửi thiệp vào lúc này.", "danger");
                    });
            });

            function toggleLoading(isLoading) {
                const spinner = document.getElementById("btnSendSpinner");
                const icon = document.getElementById("btnSendIcon");
                if (isLoading) {
                    spinner.classList.remove("d-none");
                    icon.classList.add("d-none");
                    btnConfirmSend.disabled = true;
                } else {
                    spinner.classList.add("d-none");
                    icon.classList.remove("d-none");
                    btnConfirmSend.disabled = false;
                }
            }
        });
    </script>
}