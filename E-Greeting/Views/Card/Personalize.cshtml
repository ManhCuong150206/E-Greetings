@model E_Greeting.Models.Template
@using System.Text.Json;

@{
    ViewData["Title"] = "Tùy Chỉnh Thiệp Chúc Mừng";
    bool isVip = ViewBag.IsVip ?? false;

    // Trích xuất Ảnh bìa thô Canvas & Elements từ ConfigData
    string bgImage = "/uploads/templates/default-card.jpg";
    JsonElement elementsArray = default;
    bool hasElements = false;

    if (!string.IsNullOrWhiteSpace(Model?.ConfigData))
    {
        try
        {
            using var doc = JsonDocument.Parse(Model.ConfigData);
            var root = doc.RootElement;

            if (root.TryGetProperty("background_image", out var bgProp) && !string.IsNullOrWhiteSpace(bgProp.GetString()))
            {
                bgImage = bgProp.GetString()!;
            }
            else if (!string.IsNullOrEmpty(Model.ImagePath))
            {
                bgImage = Model.ImagePath;
            }

            if (root.TryGetProperty("elements", out var elProp) && elProp.ValueKind == JsonValueKind.Array)
            {
                elementsArray = elProp.Clone();
                hasElements = elementsArray.GetArrayLength() > 0;
            }
        }
        catch { }
    }
    else if (!string.IsNullOrEmpty(Model?.ImagePath))
    {
        bgImage = Model.ImagePath;
    }
}

<div class="container my-4">

    <!-- ========================================================================= -->
    <!-- BƯỚC 1: KHUNG CHỈNH SỬA THIỆP (EDIT SECTION)                              -->
    <!-- ========================================================================= -->
    <div id="section-edit">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <h3 class="fw-bold text-primary mb-0"><i class="bi bi-palette me-2"></i>Tùy Chỉnh Thiệp: @(Model?.Name ?? "Mẫu Thiệp")</h3>
            <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill">
                <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ
            </a>
        </div>

        <input type="hidden" id="template-id" value="@Model?.Id" />

        <div class="row g-4">
            <!-- CỘT TRÁI (7/12): CANVAS XEM TRƯỚC VÀ FORM THÔNG TIN CỐ ĐỊNH -->
            <div class="col-lg-7">
                <!-- 1. CANVAS XEM TRƯỚC THIỆP -->
                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white fw-semibold d-flex justify-content-between align-items-center">
                        <span><i class="bi bi-card-image me-1"></i> Khung Thiết Kế Ảnh Bìa</span>
                        <span class="badge bg-light text-primary">Mẫu #@(Model?.Id ?? 0)</span>
                    </div>
                    <div class="card-body p-3 d-flex justify-content-center bg-dark bg-opacity-10 overflow-auto">
                        <div id="card-preview-area" class="position-relative shadow border rounded bg-white overflow-hidden"
                             style="width: 100%; max-width: 600px; height: 420px; background-image: url('@bgImage'); background-size: contain; background-repeat: no-repeat; background-position: center; user-select: none;">

                            @if (hasElements)
                            {
                                bool isFirst = true;
                                foreach (var item in elementsArray.EnumerateArray())
                                {
                                    string content = item.TryGetProperty("content", out var c) ? c.GetString() ?? "" : "";
                                    string top = item.TryGetProperty("top", out var t) ? t.GetString() ?? "35%" : "35%";
                                    string left = item.TryGetProperty("left", out var l) ? l.GetString() ?? "15%" : "15%";

                                    string width = "273px";
                                    if (item.TryGetProperty("width", out var wProp))
                                    {
                                        string wStr = wProp.GetString() ?? "";
                                        if (!string.IsNullOrEmpty(wStr))
                                        {
                                            width = wStr.EndsWith("px") ? wStr : wStr + "px";
                                        }
                                    }

                                    string font = item.TryGetProperty("fontFamily", out var f) ? f.GetString() ?? "Arial" : "Arial";
                                    string size = item.TryGetProperty("fontSize", out var s) ? s.GetString() ?? "18px" : "18px";
                                    string color = item.TryGetProperty("color", out var cl) ? cl.GetString() ?? "#000000" : "#000000";
                                    string weight = item.TryGetProperty("fontWeight", out var w) ? w.GetString() ?? "normal" : "normal";
                                    string style = item.TryGetProperty("fontStyle", out var st) ? st.GetString() ?? "normal" : "normal";

                                    <div class="draggable-text-box @(isFirst ? "active" : "") position-absolute p-2 rounded text-center d-flex align-items-center justify-content-center"
                                         style="top: @top; left: @left; width: @width; min-height: 110px; color: @color; font-family: @font; font-size: @size; font-weight: @weight; font-style: @style; cursor: move; border: @(isFirst ? "2px dashed #0d6efd" : "1px dashed rgba(13,110,253,0.5)"); background: rgba(255,255,255,0.4); box-sizing: border-box;"
                                         data-top="@top" data-left="@left">
                                        <span class="text-content" style="white-space: pre-wrap; display: block; width: 100%;">@content</span>
                                    </div>
                                    isFirst = false;
                                }
                            }
                            else
                            {
                                <div class="draggable-text-box active position-absolute p-2 rounded text-center d-flex align-items-center justify-content-center"
                                     style="top: 35%; left: 15%; width: 273px; min-height: 110px; color: #000000; font-family: Arial; font-size: 18px; font-weight: bold; cursor: move; border: 2px dashed #0d6efd; background: rgba(255,255,255,0.4); box-sizing: border-box;">
                                    <span class="text-content" style="white-space: pre-wrap; display: block; width: 100%;">Chúc Mừng Bằng Cả Trái Tim</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- 2. FORM CỐ ĐỊNH NHẬP THÔNG TIN SỰ KIỆN / NGƯỜI NHẬN -->
                <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                    <h5 class="fw-bold mb-3 text-primary"><i class="bi bi-card-heading me-2"></i>Thông Tin Chi Tiết Đi Kèm Thiệp</h5>

                    <div class="mb-3">
                        <label for="input-email-subject" class="form-label fw-bold">Tiêu Đề Email (*):</label>
                        <input type="text" id="input-email-subject" name="Subject" class="form-control" placeholder="Lời mời trân trọng dành riêng cho bạn..." required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="input-recipient-name" class="form-label fw-bold">Tên Người Nhận (*):</label>
                            <input type="text" id="input-recipient-name" name="RecipientName" class="form-control" placeholder="Ví dụ: Anh Nguyễn Văn A" required />
                        </div>
                        <div class="col-md-6">
                            <label for="input-recipient-email" class="form-label fw-bold">Email Người Nhận (*):</label>
                            <input type="email" id="input-recipient-email" name="RecipientEmail" class="form-control" placeholder="nguoinhan@example.com" required />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="input-event-address" class="form-label fw-bold">Địa Chỉ / Địa Điểm Tổ Chức (*):</label>
                        <input type="text" id="input-event-address" name="Location" class="form-control" placeholder="Ví dụ: Trung tâm Tiệc cưới White Palace, TPHCM" required />
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label for="input-event-time" class="form-label fw-bold">Thời Gian Diễn Ra (*):</label>
                            <input type="datetime-local" id="input-event-time" name="EventTime" class="form-control" required />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-bold d-flex align-items-center justify-content-between">
                                <span>Hẹn Giờ Gửi Email (Tự động):</span>
                                @if (!isVip)
                                {
                                    <span class="badge bg-warning text-dark"><i class="bi bi-star-fill me-1"></i>Tính năng VIP</span>
                                }
                            </label>

                            @if (isVip)
                            {
                                <input type="datetime-local" id="scheduledAt" name="ScheduledAt" class="form-control" placeholder="Bỏ trống nếu muốn gửi ngay" />
                                <small class="text-muted fs-7">Để trống nếu bạn muốn hệ thống gửi ngay lập tức.</small>
                            }
                            else
                            {
                                <input type="datetime-local" class="form-control bg-light" disabled title="Chỉ dành cho tài khoản VIP" />
                                <small class="text-muted fs-7">
                                    Nâng cấp <a asp-controller="Subscription" asp-action="Index" class="fw-bold text-primary">Gói VIP</a> để mở khóa hẹn giờ gửi.
                                </small>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- CỘT PHẢI (5/12): BẢNG CÔNG CỤ EDIT ẢNH BÌA & EDIT TEXT -->
            <div class="col-lg-5">
                <div class="card shadow-sm p-3">
                    <h6 class="fw-bold text-primary mb-3">
                        <i class="bi bi-tools me-1"></i> Công Cụ Thiết Kế Ảnh Bìa
                    </h6>

                    <div class="d-flex gap-2 mb-3">
                        <button type="button" id="btn-add-text" class="btn btn-sm btn-outline-primary w-50"><i class="bi bi-plus-circle me-1"></i>Thêm văn bản</button>
                        <button type="button" id="btn-clear-canvas" class="btn btn-sm btn-outline-danger w-50"><i class="bi bi-trash me-1"></i>Xóa đối tượng chọn</button>
                    </div>

                    <div class="mb-3 p-2 border rounded bg-light">
                        <label for="input-active-text-val" class="form-label form-label-sm fw-bold text-dark mb-1">
                            <i class="bi bi-pencil me-1"></i> Sửa nội dung văn bản đang chọn:
                        </label>
                        <textarea id="input-active-text-val" class="form-control form-control-sm" rows="2" placeholder="Nhấp chọn một khung chữ trên thiệp để sửa..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-bold">Định dạng văn bản:</label>
                        <div class="row g-2 mb-2">
                            <div class="col-7">
                                <select id="select-font" class="form-select form-select-sm">
                                    <option value="Arial">Arial</option>
                                    <option value="'Roboto', sans-serif">Roboto</option>
                                    <option value="'Dancing Script', cursive">Dancing Script</option>
                                    <option value="'Pacifico', cursive">Pacifico</option>
                                    <option value="'Montserrat', sans-serif">Montserrat</option>
                                </select>
                            </div>
                            <div class="col-5">
                                <select id="select-fontsize" class="form-select form-select-sm">
                                    <option value="8px">8px</option>
                                    <option value="9px">9px</option>
                                    <option value="10px">10px</option>
                                    <option value="11px">11px</option>
                                    <option value="12px">12px</option>
                                    <option value="14px">14px</option>
                                    <option value="16px">16px</option>
                                    <option value="18px" selected>18px</option>
                                    <option value="20px">20px</option>
                                    <option value="24px">24px</option>
                                    <option value="28px">28px</option>
                                    <option value="32px">32px</option>
                                    <option value="36px">36px</option>
                                    <option value="42px">42px</option>
                                    <option value="48px">48px</option>
                                    <option value="54px">54px</option>
                                </select>
                            </div>
                        </div>

                        <div class="d-flex align-items-center gap-2 mb-2">
                            <span class="small fw-semibold me-1">Màu chữ:</span>
                            <input type="color" id="input-color" class="form-control form-control-color form-control-sm" value="#000000" title="Chọn màu chữ">
                            <button type="button" id="btn-bold" class="btn btn-sm btn-outline-secondary px-3 fw-bold">B</button>
                            <button type="button" id="btn-italic" class="btn btn-sm btn-outline-secondary px-3 fst-italic">I</button>
                        </div>

                        <div class="mt-2">
                            <div class="d-flex justify-content-between">
                                <label for="slider-text-width" class="form-label form-label-sm mb-0">Độ rộng khung chữ:</label>
                                <span id="val-text-width" class="small text-muted">273px</span>
                            </div>
                            <input type="range" id="slider-text-width" class="form-range form-range-sm" min="100" max="580" value="273">
                        </div>
                    </div>

                    <div class="mb-3 border p-2 rounded bg-light">
                        <label class="form-label form-label-sm fw-bold text-primary mb-1">
                            <i class="bi bi-image me-1"></i> Thêm ảnh cá nhân:
                        </label>
                        <input type="file" id="input-upload-image" accept="image/*" class="form-control form-control-sm mb-2">

                        <div id="image-tools" class="d-none border-top pt-2 mt-2">
                            <span class="small fw-bold text-secondary d-block mb-2">Tùy chỉnh ảnh đang chọn:</span>
                            <div class="d-flex gap-1 mb-2">
                                <button type="button" id="btn-img-circle" class="btn btn-sm btn-outline-primary w-50">⭕ Khung tròn</button>
                                <button type="button" id="btn-send-back" class="btn btn-sm btn-outline-secondary w-25">⬇️️ Dưới</button>
                                <button type="button" id="btn-bring-front" class="btn btn-sm btn-outline-secondary w-25">⬆️ Trên</button>
                            </div>
                            <div class="mb-2">
                                <div class="d-flex justify-content-between">
                                    <label for="slider-img-width" class="form-label form-label-sm mb-0">Chiều rộng ảnh:</label>
                                    <span id="val-img-width" class="small text-muted">120px</span>
                                </div>
                                <input type="range" id="slider-img-width" class="form-range form-range-sm" min="40" max="400" value="120">
                            </div>
                            <div class="mb-1">
                                <div class="d-flex justify-content-between">
                                    <label for="slider-img-radius" class="form-label form-label-sm mb-0">Bo góc ảnh:</label>
                                    <span id="val-img-radius" class="small text-muted">0%</span>
                                </div>
                                <input type="range" id="slider-img-radius" class="form-range form-range-sm" min="0" max="50" value="0">
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label form-label-sm fw-bold">Thêm Sticker:</label>
                        <div class="d-flex gap-2 fs-4 p-1 border rounded justify-content-around bg-light">
                            <span class="sticker-opt" style="cursor:pointer;">❤️</span>
                            <span class="sticker-opt" style="cursor:pointer;">🎂</span>
                            <span class="sticker-opt" style="cursor:pointer;">🎉</span>
                            <span class="sticker-opt" style="cursor:pointer;">🌸</span>
                            <span class="sticker-opt" style="cursor:pointer;">✨</span>
                            <span class="sticker-opt" style="cursor:pointer;">🎁</span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label for="select-audio" class="form-label form-label-sm fw-bold">Nhạc nền:</label>
                        <select id="select-audio" class="form-select form-select-sm mb-2">
                            <option value="">-- Không chọn nhạc --</option>
                            <option value="/audio/music1.mp3">Nhạc sinh nhật 1</option>
                            <option value="/audio/music2.mp3">Nhạc sinh nhật 2</option>
                        </select>
                        <audio id="audio-player" controls class="w-100 d-none" style="height: 32px;"></audio>
                    </div>

                    <hr class="my-2">

                    <button type="button" id="btnToPreview" class="btn btn-primary rounded-pill w-100 fw-bold py-3 fs-5 shadow">
                        Tiếp Tục Xem Trước <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>


    <!-- ========================================================================= -->
    <!-- BƯỚC 2: KHUNG XEM TRƯỚC THIỆP (PREVIEW SECTION - MẶC ĐỊNH ẨN)            -->
    <!-- ========================================================================= -->
    <div id="section-preview" class="d-none my-3">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mx-auto" style="max-width: 800px;">
            <div class="bg-primary text-white text-center py-3 fw-bold fs-5 shadow-sm">
                <i class="bi bi-card-heading me-2"></i> Thiệp Chúc Mừng Dành Cho Bạn
            </div>

            <div class="card-body p-4 bg-light">
                <div class="text-center mb-4">
                    <div class="bg-white p-2 rounded-3 shadow-sm d-inline-block border">
                        <img id="preview-card-img" src="" class="img-fluid rounded" style="max-height: 500px; object-fit: contain;" alt="Bản xem trước thiệp">
                    </div>
                </div>

                <div id="preview-audio-container" class="bg-white p-3 rounded-3 shadow-sm mb-4 border d-none">
                    <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-semibold small">
                        <i class="bi bi-music-note-beamed fs-5"></i> Nhạc nền kèm theo thiệp:
                    </div>
                    <audio id="preview-audio-player" controls class="w-100" style="height: 36px;"></audio>
                </div>

                <div class="bg-white p-4 rounded-4 shadow-sm border mb-4">
                    <h6 class="fw-bold text-primary mb-3">
                        <i class="bi bi-info-circle-fill me-2"></i> Thông Tin Sự Kiện & Thiệp
                    </h6>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1 fw-semibold">Kính gửi người nhận:</label>
                            <div id="preview-recipient-name" class="fw-bold text-dark bg-light p-2 rounded border">-</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1 fw-semibold">Thời gian diễn ra:</label>
                            <div id="preview-event-time" class="fw-bold text-dark bg-light p-2 rounded border">-</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small mb-1 fw-semibold">Địa điểm tổ chức:</label>
                            <div id="preview-event-address" class="fw-bold text-dark bg-light p-2 rounded border">-</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1 fw-semibold">Email người nhận:</label>
                            <div id="preview-recipient-email" class="fw-bold text-dark bg-light p-2 rounded border">-</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1 fw-semibold">Tiêu đề Email:</label>
                            <div id="preview-email-subject" class="fw-bold text-dark bg-light p-2 rounded border">-</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 bg-light rounded-bottom-4 justify-content-center gap-2 pb-4">
                    <button type="button" id="btnBackToEdit" class="btn btn-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Quay lại
                    </button>

                    <button type="button" id="btnOpenConfirmModal" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Đồng Ý & Gửi
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ========================================================================= -->
<!-- BƯỚC 3: POPUP MODAL XÁC NHẬN GỬI THIỆP                                   -->
<!-- ========================================================================= -->
<div class="modal fade" id="confirmSendModal" tabindex="-1" aria-labelledby="confirmSendModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title fw-bold" id="confirmSendModalLabel">
                    <i class="bi bi-envelope-paper-heart me-2"></i>Xác Nhận Gửi Thiệp
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <i class="bi bi-send-check text-success display-3 mb-3 d-block"></i>
                <h5 class="fw-bold text-dark mb-2">Bạn đã kiểm tra kỹ thông tin thiệp chưa?</h5>
                <p class="text-muted small mb-0">Hệ thống sẽ tiến hành lưu dữ liệu thiệp và gửi email trực tiếp tới người nhận.</p>
            </div>
            <div class="modal-footer border-0 bg-light rounded-bottom-4 justify-content-center gap-2 pb-4">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold border" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" id="btnFinalSend" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                    <i class="bi bi-check-circle me-1"></i> Đồng Ý & Gửi
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="~/js/personalize.js" asp-append-version="true"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const sectionEdit = document.getElementById("section-edit");
            const sectionPreview = document.getElementById("section-preview");

            const btnToPreview = document.getElementById("btnToPreview");
            const btnBackToEdit = document.getElementById("btnBackToEdit");
            const btnOpenConfirmModal = document.getElementById("btnOpenConfirmModal");
            const btnFinalSend = document.getElementById("btnFinalSend");

            // Modal Bootstrap Instance
            const confirmModalEl = document.getElementById('confirmSendModal');
            const confirmModal = confirmModalEl ? new bootstrap.Modal(confirmModalEl) : null;

            // Nghe thử nhạc nền ở phần chỉnh sửa
            const selectAudio = document.getElementById("select-audio");
            const audioPlayer = document.getElementById("audio-player");
            if (selectAudio && audioPlayer) {
                selectAudio.addEventListener("change", function () {
                    if (this.value) {
                        audioPlayer.src = this.value;
                        audioPlayer.classList.remove("d-none");
                    } else {
                        audioPlayer.pause();
                        audioPlayer.src = "";
                        audioPlayer.classList.add("d-none");
                    }
                });
            }

            // --- 1. CHUYỂN TỪ EDIT SANG PREVIEW ---
            if (btnToPreview) {
                btnToPreview.addEventListener("click", function () {
                    const subject = document.getElementById("input-email-subject")?.value.trim();
                    const recipientName = document.getElementById("input-recipient-name")?.value.trim();
                    const recipientEmail = document.getElementById("input-recipient-email")?.value.trim();
                    const location = document.getElementById("input-event-address")?.value.trim();
                    const eventTime = document.getElementById("input-event-time")?.value;

                    // Giá trị ô Hẹn Giờ (chỉ áp dụng nếu tài khoản VIP)
                    const scheduledAtInput = document.getElementById("scheduledAt");
                    const scheduledAtVal = scheduledAtInput ? scheduledAtInput.value : "";

                    // Validation đầy đủ thông tin bắt buộc
                    if (!subject) {
                        alert("Vui lòng nhập Tiêu Đề Email!");
                        document.getElementById("input-email-subject")?.focus();
                        return;
                    }
                    if (!recipientName) {
                        alert("Vui lòng nhập Tên Người Nhận!");
                        document.getElementById("input-recipient-name")?.focus();
                        return;
                    }
                    if (!recipientEmail) {
                        alert("Vui lòng nhập Email Người Nhận!");
                        document.getElementById("input-recipient-email")?.focus();
                        return;
                    }
                    if (!location) {
                        alert("Vui lòng nhập Địa Chỉ / Địa Điểm Tổ Chức!");
                        document.getElementById("input-event-address")?.focus();
                        return;
                    }
                    if (!eventTime) {
                        alert("Vui lòng chọn Thời Gian Diễn Ra sự kiện!");
                        document.getElementById("input-event-time")?.focus();
                        return;
                    }

                    // Đổi trạng thái nút bấm (loading)
                    const originalBtnHtml = btnToPreview.innerHTML;
                    btnToPreview.disabled = true;
                    btnToPreview.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang tạo bản xem trước...';

                    // Luyện & tạm ẩn đường viền nét đứt của thẻ chữ để chụp canvas đẹp
                    const draggableElems = document.querySelectorAll(".draggable-text-box, .draggable-element");
                    draggableElems.forEach(el => {
                        el.setAttribute("data-border-backup", el.style.border || "");
                        el.style.border = "none";
                        el.classList.remove("active");
                    });

                    const cardArea = document.getElementById("card-preview-area");

                    // Chụp hình Canvas
                    html2canvas(cardArea, {
                        scale: 2,
                        useCORS: true,
                        allowTaint: false,
                        backgroundColor: "#ffffff"
                    }).then(canvas => {
                        const imgData = canvas.toDataURL("image/jpeg", 0.85);
                        document.getElementById("preview-card-img").src = imgData;

                        let formattedTime = eventTime ? new Date(eventTime).toLocaleString("vi-VN") : "(Chưa chọn)";

                        document.getElementById("preview-recipient-name").innerText = recipientName;
                        document.getElementById("preview-event-time").innerText = formattedTime;
                        document.getElementById("preview-event-address").innerText = location;
                        document.getElementById("preview-recipient-email").innerText = recipientEmail;
                        document.getElementById("preview-email-subject").innerText = subject;

                        // Nhạc nền Preview
                        const previewAudioContainer = document.getElementById("preview-audio-container");
                        const previewAudioPlayer = document.getElementById("preview-audio-player");

                        if (selectAudio && selectAudio.value) {
                            previewAudioPlayer.src = selectAudio.value;
                            previewAudioContainer.classList.remove("d-none");
                        } else {
                            previewAudioPlayer.pause();
                            previewAudioPlayer.src = "";
                            previewAudioContainer.classList.add("d-none");
                        }

                        // =========================================================================
                        // TỰ ĐỘNG CẬP NHẬT GIAO DIỆN NÚT & POPUP THEO TRẠNG THÁI HẸN GIỜ
                        // =========================================================================
                        const modalTitle = document.getElementById("confirmSendModalLabel");
                        const modalBodyText = document.querySelector("#confirmSendModal .modal-body p");

                        if (scheduledAtVal) {
                            // CÓ HẸN GIỜ GỬI EMAIL
                            const formattedScheduleTime = new Date(scheduledAtVal).toLocaleString("vi-VN");

                            if (btnOpenConfirmModal) {
                                btnOpenConfirmModal.innerHTML = '<i class="bi bi-clock-history me-1"></i> Xác Nhận Hẹn Giờ';
                                btnOpenConfirmModal.className = "btn btn-warning text-dark rounded-pill px-4 fw-bold shadow-sm";
                            }
                            if (modalTitle) {
                                modalTitle.innerHTML = '<i class="bi bi-clock-history me-2"></i>Xác Nhận Hẹn Giờ Gửi Thiệp';
                            }
                            if (modalBodyText) {
                                modalBodyText.innerHTML = `Hệ thống sẽ lên lịch và <b>tự động gửi email</b> tới người nhận vào lúc: <br><span class="text-primary fw-bold fs-6">${formattedScheduleTime}</span>`;
                            }
                            if (btnFinalSend) {
                                btnFinalSend.innerHTML = '<i class="bi bi-clock-history me-1"></i> Xác Nhận Hẹn Giờ';
                                btnFinalSend.className = "btn btn-warning text-dark rounded-pill px-4 fw-bold shadow-sm";
                            }
                        } else {
                            // GỬI EMAIL NGAY LẬP TỨC
                            if (btnOpenConfirmModal) {
                                btnOpenConfirmModal.innerHTML = '<i class="bi bi-check-circle me-1"></i> Đồng Ý & Gửi';
                                btnOpenConfirmModal.className = "btn btn-primary rounded-pill px-4 fw-bold shadow-sm";
                            }
                            if (modalTitle) {
                                modalTitle.innerHTML = '<i class="bi bi-envelope-paper-heart me-2"></i>Xác Nhận Gửi Thiệp';
                            }
                            if (modalBodyText) {
                                modalBodyText.innerText = "Hệ thống sẽ tiến hành lưu dữ liệu thiệp và gửi email trực tiếp tới người nhận ngay lập tức.";
                            }
                            if (btnFinalSend) {
                                btnFinalSend.innerHTML = '<i class="bi bi-check-circle me-1"></i> Đồng Ý & Gửi';
                                btnFinalSend.className = "btn btn-primary rounded-pill px-4 fw-bold shadow-sm";
                            }
                        }

                        // Chuyển màn hình sang Preview
                        sectionEdit.classList.add("d-none");
                        sectionPreview.classList.remove("d-none");
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }).catch(err => {
                        console.error("Lỗi html2canvas:", err);
                        alert("Không thể tạo ảnh xem trước. Vui lòng thử lại!");
                    }).finally(() => {
                        btnToPreview.disabled = false;
                        btnToPreview.innerHTML = originalBtnHtml;
                    });
                });
            }

            // --- 2. NÚT QUAY LẠI (QUAY LẠI CHỈNH SỬA) ---
            if (btnBackToEdit) {
                btnBackToEdit.addEventListener("click", function () {
                    const previewAudioPlayer = document.getElementById("preview-audio-player");
                    if (previewAudioPlayer) previewAudioPlayer.pause();

                    // Khôi phục viền nét đứt trên Canvas
                    const draggableElems = document.querySelectorAll(".draggable-text-box, .draggable-element");
                    draggableElems.forEach((el, index) => {
                        const backupBorder = el.getAttribute("data-border-backup");
                        if (backupBorder && backupBorder !== "none") {
                            el.style.border = backupBorder;
                        } else {
                            el.style.border = (index === 0) ? "2px dashed #0d6efd" : "1px dashed rgba(13,110,253,0.5)";
                        }
                    });

                    if (draggableElems.length > 0) {
                        draggableElems[0].classList.add("active");
                    }

                    // Hiện lại màn hình Edit
                    sectionPreview.classList.add("d-none");
                    sectionEdit.classList.remove("d-none");
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }

            // --- 3. MỞ MODAL XÁC NHẬN ---
            if (btnOpenConfirmModal) {
                btnOpenConfirmModal.addEventListener("click", function () {
                    if (confirmModal) confirmModal.show();
                });
            }

            // --- 4. BẤM XÁC NHẬN TRONG MODAL ---
            if (btnFinalSend) {
                btnFinalSend.addEventListener("click", function () {
                    if (confirmModal) confirmModal.hide();

                    if (typeof saveAndSendCard === 'function') {
                        saveAndSendCard();
                    } else if (typeof handleSaveAndSend === 'function') {
                        handleSaveAndSend();
                    } else {
                        alert("Hệ thống đang tiến hành lưu và gửi thiệp...");
                    }
                });
            }
        });
    </script>
}