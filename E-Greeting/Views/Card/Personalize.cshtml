@model E_Greeting.Models.Template

@{
    ViewData["Title"] = "Tùy Chỉnh Thiệp Chúc Mừng";
    var bgImage = !string.IsNullOrEmpty(Model?.ImagePath) ? Model.ImagePath : "/uploads/templates/default-card.jpg";
}

<div class="container my-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h3 class="fw-bold text-primary mb-0">Tùy Chỉnh Thiệp: @(Model?.Name ?? "Mẫu Thiệp")</h3>
        <a href="/" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-left me-1"></i> Quay lại trang chủ
        </a>
    </div>

    <!-- Hidden field chứa Template ID -->
    <input type="hidden" id="template-id" value="@Model?.Id" />

    <div class="row g-4">
        <!-- CỘT TRÁI (7/12): XEM TRƯỚC THIỆP & SOẠN THẢO -->
        <div class="col-lg-7">
            <!-- KHUNG XEM TRƯỚC THIỆP -->
            <div class="card shadow-sm mb-3">
                <div class="card-header bg-primary text-white fw-semibold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-card-image me-1"></i> Xem Trước Thiệp</span>
                    <span class="badge bg-light text-primary">Mẫu #@(Model?.Id ?? 0)</span>
                </div>
                <div class="card-body p-3 d-flex justify-content-center bg-dark bg-opacity-10 overflow-auto">
                    <!-- CANVAS THIỆP -->
                    <div id="card-preview-area" class="position-relative shadow border rounded bg-white"
                         style="width: 100%; max-width: 600px; height: 420px; background-image: url('@bgImage'); background-size: contain; background-repeat: no-repeat; background-position: center;">

                        <!-- Khung chữ mặc định (Đã gán class draggable-text-box) -->
                        <div class="draggable-text-box active" style="top: 80px; left: 50px; width: 500px; color: #000000; font-family: Arial; font-size: 18px;">
                            <span class="text-content">Kính gửi: Bạn thân mến,&#10;&#10;Chúc bạn một ngày làm việc tràn đầy năng lượng và nhiều niềm vui!&#10;&#10;Thân gửi,</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- SOẠN THẢO NỘI DUNG THIỆP -->
            <div class="card shadow-sm p-3">
                <h6 class="fw-bold text-primary mb-3">
                    <i class="bi bi-pencil-square me-1"></i> Soạn thảo nội dung thiệp:
                </h6>

                <div class="row mb-2 align-items-center">
                    <label for="tpl-salutation" class="col-sm-4 col-form-label col-form-label-sm fw-semibold">Kính gửi / Xưng hô:</label>
                    <div class="col-sm-8">
                        <input type="text" id="tpl-salutation" class="form-control form-control-sm tpl-field" value="Kính gửi:">
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label for="tpl-recipient" class="col-sm-4 col-form-label col-form-label-sm fw-semibold">Tên người nhận:</label>
                    <div class="col-sm-8">
                        <input type="text" id="tpl-recipient" class="form-control form-control-sm tpl-field" value="Bạn thân mến,">
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label for="tpl-message" class="col-sm-4 col-form-label col-form-label-sm fw-semibold">Lời chúc chính:</label>
                    <div class="col-sm-8">
                        <textarea id="tpl-message" class="form-control form-control-sm tpl-field" rows="3">Chúc bạn một ngày làm việc tràn đầy năng lượng và nhiều niềm vui!</textarea>
                    </div>
                </div>

                <div class="row mb-2 align-items-center">
                    <label for="tpl-sender" class="col-sm-4 col-form-label col-form-label-sm fw-semibold">Lời kết / Người gửi:</label>
                    <div class="col-sm-8">
                        <input type="text" id="tpl-sender" class="form-control form-control-sm tpl-field" value="Thân gửi,">
                    </div>
                </div>
            </div>
        </div>

        <!-- CỘT PHẢI (5/12): BẢNG CÔNG CỤ CHỈNH SỬA & GỬI THIỆP -->
        <div class="col-lg-5">
            <div class="card shadow-sm p-3">
                <h6 class="fw-bold text-primary mb-3">
                    <i class="bi bi-tools me-1"></i> Công Cụ Chỉnh Sửa
                </h6>

                <!-- Thao tác canvas -->
                <div class="d-flex gap-2 mb-3">
                    <button id="btn-add-text" class="btn btn-sm btn-outline-primary w-50">+ Thêm khung chữ</button>
                    <button id="btn-clear-canvas" class="btn btn-sm btn-outline-danger w-50">Xóa vật thể chọn</button>
                </div>

                <!-- ĐỊNH DẠNG VĂN BẢN -->
                <div class="mb-3">
                    <label class="form-label form-label-sm fw-bold">Định dạng văn bản:</label>
                    <div class="row g-2 mb-2">
                        <div class="col-7">
                            <select id="select-font" class="form-select form-select-sm">
                                <option value="Arial">Arial</option>
                                <option value="'Roboto', sans-serif">Roboto</option>
                                <option value="'Dancing Script', cursive">Dancing Script</option>
                                <option value="'Pacifico', cursive">Pacifico</option>
                                <option value="'Montserrat', sans-serif">Montserrat</option>
                            </select>
                        </div>
                        <div class="col-5">
                            <select id="select-fontsize" class="form-select form-select-sm">
                                <option value="14px">14px</option>
                                <option value="16px">16px</option>
                                <option value="18px" selected>18px</option>
                                <option value="20px">20px</option>
                                <option value="24px">24px</option>
                                <option value="28px">28px</option>
                                <option value="36px">36px</option>
                            </select>
                        </div>
                    </div>

                    <div class="d-flex align-items-center gap-2 mb-2">
                        <span class="small fw-semibold me-1">Màu chữ:</span>
                        <input type="color" id="input-color" class="form-control form-control-color form-control-sm" value="#000000" title="Chọn màu chữ">
                        <button type="button" id="btn-bold" class="btn btn-sm btn-outline-secondary px-3 fw-bold">B</button>
                        <button type="button" id="btn-italic" class="btn btn-sm btn-outline-secondary px-3 fst-italic">I</button>
                    </div>

                    <div class="mt-2">
                        <div class="d-flex justify-content-between">
                            <label for="slider-text-width" class="form-label form-label-sm mb-0">Độ rộng khung chữ:</label>
                            <span id="val-text-width" class="small text-muted">500px</span>
                        </div>
                        <input type="range" id="slider-text-width" class="form-range form-range-sm" min="100" max="580" value="500">
                    </div>
                </div>

                <!-- THÊM ẢNH CÁ NHÂN -->
                <div class="mb-3 border p-2 rounded bg-light">
                    <label class="form-label form-label-sm fw-bold text-primary mb-1">
                        <i class="bi bi-image me-1"></i> Thêm ảnh cá nhân:
                    </label>
                    <input type="file" id="input-upload-image" accept="image/*" class="form-control form-control-sm mb-2">

                    <div id="image-tools" class="d-none border-top pt-2 mt-2">
                        <span class="small fw-bold text-secondary d-block mb-2">Tùy chỉnh ảnh đang chọn:</span>
                        <div class="d-flex gap-1 mb-2">
                            <button type="button" id="btn-img-circle" class="btn btn-sm btn-outline-primary w-50">⭕ Khung tròn</button>
                            <button type="button" id="btn-send-back" class="btn btn-sm btn-outline-secondary w-25">⬇️ Dưới</button>
                            <button type="button" id="btn-bring-front" class="btn btn-sm btn-outline-secondary w-25">⬆️ Trên</button>
                        </div>
                        <div class="mb-2">
                            <div class="d-flex justify-content-between">
                                <label for="slider-img-width" class="form-label form-label-sm mb-0">Chiều rộng ảnh:</label>
                                <span id="val-img-width" class="small text-muted">120px</span>
                            </div>
                            <input type="range" id="slider-img-width" class="form-range form-range-sm" min="40" max="400" value="120">
                        </div>
                        <div class="mb-1">
                            <div class="d-flex justify-content-between">
                                <label for="slider-img-radius" class="form-label form-label-sm mb-0">Bo góc ảnh:</label>
                                <span id="val-img-radius" class="small text-muted">0%</span>
                            </div>
                            <input type="range" id="slider-img-radius" class="form-range form-range-sm" min="0" max="50" value="0">
                        </div>
                    </div>
                </div>

                <!-- STICKER -->
                <div class="mb-3">
                    <label class="form-label form-label-sm fw-bold">Thêm Sticker:</label>
                    <div class="d-flex gap-2 fs-4 p-1 border rounded justify-content-around bg-light">
                        <span class="sticker-opt" style="cursor:pointer;">❤️</span>
                        <span class="sticker-opt" style="cursor:pointer;">🎂</span>
                        <span class="sticker-opt" style="cursor:pointer;">🎉</span>
                        <span class="sticker-opt" style="cursor:pointer;">🌸</span>
                        <span class="sticker-opt" style="cursor:pointer;">✨</span>
                        <span class="sticker-opt" style="cursor:pointer;">🎁</span>
                    </div>
                </div>

                <!-- NHẠC NỀN -->
                <div class="mb-3">
                    <label for="select-audio" class="form-label form-label-sm fw-bold">Nhạc nền:</label>
                    <select id="select-audio" class="form-select form-select-sm mb-2">
                        <option value="">-- Không chọn nhạc --</option>
                        <option value="/audio/Nhạc nền 1.mp3">Nhạc sinh nhật</option>
                        <option value="/audio/Nhạc nền 2.mp3">Nhạc sinh nhật</option>
                    </select>
                    <audio id="audio-player" controls class="w-100 d-none" style="height: 32px;"></audio>
                </div>

                <hr class="my-2">

                <!-- THÔNG TIN GỬI THIỆP -->
                <div class="mb-2">
                    <label for="input-recipient" class="form-label form-label-sm fw-bold">Email Người Nhận (*):</label>
                    <input type="email" id="input-recipient" class="form-control form-control-sm" placeholder="nguoinhan@example.com" required>
                </div>

                <div class="mb-3">
                    <label for="input-subject" class="form-label form-label-sm fw-bold">Tiêu đề email:</label>
                    <input type="text" id="input-subject" class="form-control form-control-sm" value="Thiệp chúc mừng dành riêng cho bạn!">
                </div>

                <button id="btn-save-card" class="btn btn-success w-100 fw-bold py-2">
                    <i class="bi bi-send me-1"></i> Lưu & Gửi Thiệp
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/personalize.js" asp-append-version="true"></script>
}