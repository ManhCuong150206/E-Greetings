    <!-- ========================================================================= -->
    <div id="section-preview" class="d-none my-3">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mx-auto" style="max-width: 800px;">
            <div class="bg-primary text-white text-center py-3 fw-bold fs-5 shadow-sm">
                <i class="bi bi-card-heading me-2"></i> Greeting Card Preview
            </div>

            <div class="card-body p-4 bg-light">
                <div class="text-center mb-4">
                    <div class="bg-white p-2 rounded-3 shadow-sm d-inline-block border">
                        <img id="preview-card-img" src="" class="img-fluid rounded" style="max-height: 500px; object-fit: contain;" alt="Card preview image">
                    </div>
                </div>

                <div id="preview-audio-container" class="bg-white p-3 rounded-3 shadow-sm mb-4 border d-none">
                    <div class="d-flex align-items-center gap-2 mb-2 text-primary fw-semibold small">
                        <i class="bi bi-music-note-beamed fs-5"></i> Background Music Included:
                    </div>
                    <audio id="preview-audio-player" controls class="w-100" style="height: 36px;"></audio>
                </div>

                <div class="bg-white p-4 rounded-4 shadow-sm border mb-4">
                    <h6 class="fw-bold text-primary mb-3">
                        <i class="bi bi-info-circle-fill me-2"></i> Event & Recipient Summary
                    </h6>
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label text-muted small mb-1 fw-semibold">Email Subject:</label>
                            <div id="preview-email-subject" class="fw-bold text-dark bg-light p-2 rounded border">-</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label text-muted small mb-1 fw-semibold">Recipients:</label>
                            <div id="preview-recipients-list" class="bg-light p-2 rounded border text-dark fw-bold">-</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1 fw-semibold">Event Time:</label>
                            <div id="preview-event-time" class="fw-bold text-dark bg-light p-2 rounded border">-</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-muted small mb-1 fw-semibold">Event Location:</label>
                            <div id="preview-event-address" class="fw-bold text-dark bg-light p-2 rounded border">-</div>
                        </div>
                    </div>
                </div>

                <div class="modal-footer border-0 bg-light rounded-bottom-4 justify-content-center gap-2 pb-4">
                    <button type="button" id="btnBackToEdit" class="btn btn-secondary rounded-pill px-4">
                        <i class="bi bi-arrow-left me-1"></i> Back to Edit
                    </button>

                    <button type="button" id="btnOpenConfirmModal" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                        <i class="bi bi-check-circle me-1"></i> Confirm & Send
                    </button>
                </div>
            </div>
        </div>
    </div>

</div>

<!-- ========================================================================= -->
<!-- STEP 3: CONFIRMATION POPUP MODAL                                         -->
<!-- ========================================================================= -->
<div class="modal fade" id="confirmSendModal" tabindex="-1" aria-labelledby="confirmSendModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header bg-primary text-white border-0 py-3">
                <h5 class="modal-title fw-bold" id="confirmSendModalLabel">
                    <i class="bi bi-envelope-paper-heart me-2"></i> Confirm Card Delivery
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4 text-center">
                <i class="bi bi-send-check text-success display-3 mb-3 d-block"></i>
                <h5 class="fw-bold text-dark mb-2">Have you reviewed all details carefully?</h5>
                <p class="text-muted small mb-0">The system will save your customized card and send email notifications to all recipients.</p>
            </div>
            <div class="modal-footer border-0 bg-light rounded-bottom-4 justify-content-center gap-2 pb-4">
                <button type="button" class="btn btn-light rounded-pill px-4 fw-semibold border" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="btnFinalSend" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                    <i class="bi bi-check-circle me-1"></i> Confirm & Send
                </button>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="~/js/personalize.js" asp-append-version="true"></script>

    <script>
        const MAX_RECIPIENTS = 10;
        const isVipUser = @((isVip).ToString().ToLower());

        // Dynamic Add / Remove Recipient Row Logic
        function addRecipientRow() {
            if (!isVipUser) {
                alert("Sending to multiple recipients is exclusively for VIP members!");
                return;
            }

            const container = document.getElementById('recipientsContainer');
            const currentCount = container.querySelectorAll('.recipient-row').length;

            if (currentCount >= MAX_RECIPIENTS) {
                alert(`You can only add up to ${MAX_RECIPIENTS} recipients per card!`);
                return;
            }

            const newRow = document.createElement('div');
            newRow.className = 'recipient-row mb-3 p-3 border rounded bg-light position-relative';
            newRow.innerHTML = `
                                <div class="row align-items-center g-2">
                                    <div class="col-md-5">
                                        <label class="form-label small fw-bold text-secondary mb-1">Recipient Name (*):</label>
                                        <input type="text" class="form-control recipient-name" placeholder="e.g. Jane Smith" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold text-secondary mb-1">Recipient Email (*):</label>
                                        <input type="email" class="form-control recipient-email" placeholder="jane@example.com" required />
                                    </div>
                                    <div class="col-md-1 text-center pt-md-3">
                                        <button type="button" class="btn btn-outline-danger btn-sm rounded-circle" title="Remove recipient" onclick="removeRecipientRow(this)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </div>
                                </div>
                            `;

            container.appendChild(newRow);
            updateCounter();
        }

        function removeRecipientRow(btn) {
            btn.closest('.recipient-row').remove();
            updateCounter();
        }

        function updateCounter() {
            const count = document.querySelectorAll('.recipient-row').length;
            document.getElementById('recipientCounter').innerText = `Recipients: ${count}/${MAX_RECIPIENTS}`;
        }

        document.addEventListener("DOMContentLoaded", function() {
            // Auto-add second recipient if navigated with ?isBulk=true
            const urlParams = new URLSearchParams(window.location.search);
            if (urlParams.get('isBulk') === 'true' && isVipUser) {
                addRecipientRow();
            }

            const sectionEdit = document.getElementById("section-edit");
            const sectionPreview = document.getElementById("section-preview");

            const btnToPreview = document.getElementById("btnToPreview");
            const btnBackToEdit = document.getElementById("btnBackToEdit");
            const btnOpenConfirmModal = document.getElementById("btnOpenConfirmModal");
            const btnFinalSend = document.getElementById("btnFinalSend");

            // Modal Bootstrap Instance
            const confirmModalEl = document.getElementById('confirmSendModal');
            const confirmModal = confirmModalEl ? new bootstrap.Modal(confirmModalEl) : null;

            // Audio player preview in edit mode
            const selectAudio = document.getElementById("select-audio");
            const audioPlayer = document.getElementById("audio-player");
            if (selectAudio && audioPlayer) {
                selectAudio.addEventListener("change", function() {
                    if (this.value) {
                        audioPlayer.src = this.value;
                        audioPlayer.classList.remove("d-none");
                    } else {
                        audioPlayer.pause();
                        audioPlayer.src = "";
                        audioPlayer.classList.add("d-none");
                    }
                });
            }

            // --- 1. SWITCH FROM EDIT TO PREVIEW ---
            if (btnToPreview) {
                btnToPreview.addEventListener("click", function() {
                    const subject = document.getElementById("input-email-subject")?.value.trim();
                    const location = document.getElementById("input-event-address")?.value.trim();
                    const eventTime = document.getElementById("input-event-time")?.value;

                    // Collect recipients
                    const recipientRows = document.querySelectorAll('.recipient-row');
                    const recipientsData = [];
                    let hasEmptyRecipient = false;

                    recipientRows.forEach(row => {
                        const name = row.querySelector('.recipient-name')?.value.trim();
                        const email = row.querySelector('.recipient-email')?.value.trim();
                        if (!name || !email) {
                            hasEmptyRecipient = true;
                        } else {
                            recipientsData.push({ name: name, email: email });
                        }
                    });

                    const scheduledAtInput = document.getElementById("scheduledAt");
                    const scheduledAtVal = scheduledAtInput ? scheduledAtInput.value : "";

                    // Validation
                    if (!subject) {
                        alert("Please enter the Email Subject!");
                        document.getElementById("input-email-subject")?.focus();
                        return;
                    }
                    if (hasEmptyRecipient || recipientsData.length === 0) {
                        alert("Please fill in both Name and Email for all recipients!");
                        return;
                    }
                    if (!location) {
                        alert("Please enter the Event Location / Venue!");
                        document.getElementById("input-event-address")?.focus();
                        return;
                    }
                    if (!eventTime) {
                        alert("Please select the Event Time!");
                        document.getElementById("input-event-time")?.focus();
                        return;
                    }

                    // Button loading state
                    const originalBtnHtml = btnToPreview.innerHTML;
                    btnToPreview.disabled = true;
                    btnToPreview.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Generating preview...';

                    // Hide borders temporarily for html2canvas
                    const draggableElems = document.querySelectorAll(".draggable-text-box, .draggable-element");
                    draggableElems.forEach(el => {
                        el.setAttribute("data-border-backup", el.style.border || "");
                        el.style.border = "none";
                        el.classList.remove("active");
                    });

                    const cardArea = document.getElementById("card-preview-area");

                    // Capture canvas image
                    html2canvas(cardArea, {
                        scale: 2,
                        useCORS: true,
                        allowTaint: false,
                        backgroundColor: "#ffffff"
                    }).then(canvas => {
                        const imgData = canvas.toDataURL("image/jpeg", 0.85);
                        document.getElementById("preview-card-img").src = imgData;

                        let formattedTime = eventTime ? new Date(eventTime).toLocaleString("en-US") : "(Not set)";

                        // Render recipient summary list
                        const previewRecipientsList = document.getElementById("preview-recipients-list");
                        previewRecipientsList.innerHTML = recipientsData.map(r => `<div>• <strong>${r.name}</strong> (${r.email})</div>`).join('');

                        document.getElementById("preview-event-time").innerText = formattedTime;
                        document.getElementById("preview-event-address").innerText = location;
                        document.getElementById("preview-email-subject").innerText = subject;

                        // Audio Preview setup
                        const previewAudioContainer = document.getElementById("preview-audio-container");
                        const previewAudioPlayer = document.getElementById("preview-audio-player");

                        if (selectAudio && selectAudio.value) {
                            previewAudioPlayer.src = selectAudio.value;
                            previewAudioContainer.classList.remove("d-none");
                        } else {
                            previewAudioPlayer.pause();
                            previewAudioPlayer.src = "";
                            previewAudioContainer.classList.add("d-none");
                        }

                        // Adjust UI according to scheduled date
                        const modalTitle = document.getElementById("confirmSendModalLabel");
                        const modalBodyText = document.querySelector("#confirmSendModal .modal-body p");

                        if (scheduledAtVal) {
                            const formattedScheduleTime = new Date(scheduledAtVal).toLocaleString("en-US");

                            if (btnOpenConfirmModal) {
                                btnOpenConfirmModal.innerHTML = '<i class="bi bi-clock-history me-1"></i> Confirm Scheduled Delivery';
                                btnOpenConfirmModal.className = "btn btn-warning text-dark rounded-pill px-4 fw-bold shadow-sm";
                            }
                            if (modalTitle) {
                                modalTitle.innerHTML = '<i class="bi bi-clock-history me-2"></i> Confirm Scheduled Delivery';
                            }
                            if (modalBodyText) {
                                modalBodyText.innerHTML = `The system will schedule and <b>automatically send emails</b> to recipient(s) at: <br><span class="text-primary fw-bold fs-6">${formattedScheduleTime}</span>`;
                            }
                            if (btnFinalSend) {
                                btnFinalSend.innerHTML = '<i class="bi bi-clock-history me-1"></i> Confirm Schedule';
                                btnFinalSend.className = "btn btn-warning text-dark rounded-pill px-4 fw-bold shadow-sm";
                            }
                        } else {
                            if (btnOpenConfirmModal) {
                                btnOpenConfirmModal.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirm & Send';
                                btnOpenConfirmModal.className = "btn btn-primary rounded-pill px-4 fw-bold shadow-sm";
                            }
                            if (modalTitle) {
                                modalTitle.innerHTML = '<i class="bi bi-envelope-paper-heart me-2"></i> Confirm Card Delivery';
                            }
                            if (modalBodyText) {
                                modalBodyText.innerText = "The system will save your card and deliver emails directly to all recipients immediately.";
                            }
                            if (btnFinalSend) {
                                btnFinalSend.innerHTML = '<i class="bi bi-check-circle me-1"></i> Confirm & Send';
                                btnFinalSend.className = "btn btn-primary rounded-pill px-4 fw-bold shadow-sm";
                            }
                        }

                        // Switch view to preview
                        sectionEdit.classList.add("d-none");
                        sectionPreview.classList.remove("d-none");
                        window.scrollTo({ top: 0, behavior: 'smooth' });
                    }).catch(err => {
                        console.error("html2canvas error:", err);
                        alert("Could not generate card preview image. Please try again!");
                    }).finally(() => {
                        btnToPreview.disabled = false;
                        btnToPreview.innerHTML = originalBtnHtml;
                    });
                });
            }

            // --- 2. BACK TO EDIT BUTTON ---
            if (btnBackToEdit) {
                btnBackToEdit.addEventListener("click", function() {
                    const previewAudioPlayer = document.getElementById("preview-audio-player");
                    if (previewAudioPlayer) previewAudioPlayer.pause();

                    // Restore text box dashed borders
                    const draggableElems = document.querySelectorAll(".draggable-text-box, .draggable-element");
                    draggableElems.forEach((el, index) => {
                        const backupBorder = el.getAttribute("data-border-backup");
                        if (backupBorder && backupBorder !== "none") {
                            el.style.border = backupBorder;
                        } else {
                            el.style.border = (index === 0) ? "2px dashed #0d6efd" : "1px dashed rgba(13,110,253,0.5)";
                        }
                    });

                    if (draggableElems.length > 0) {
                        draggableElems[0].classList.add("active");
                    }

                    sectionPreview.classList.add("d-none");
                    sectionEdit.classList.remove("d-none");
                    window.scrollTo({ top: 0, behavior: 'smooth' });
                });
            }

            // --- 3. OPEN CONFIRMATION MODAL ---
            if (btnOpenConfirmModal) {
                btnOpenConfirmModal.addEventListener("click", function() {
                    if (confirmModal) confirmModal.show();
                });
            }

            // --- 4. CONFIRM SUBMIT IN MODAL ---
            if (btnFinalSend) {
                btnFinalSend.addEventListener("click", function() {
                    if (confirmModal) confirmModal.hide();

                    if (typeof saveAndSendCard === 'function') {
                        saveAndSendCard();
                    } else if (typeof handleSaveAndSend === 'function') {
                        handleSaveAndSend();
                    } else {
                        alert("System is saving and delivering your cards...");
                    }
                });
            }
        });
    </script>
}